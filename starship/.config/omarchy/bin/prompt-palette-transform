#!/usr/bin/env python3
"""Write a recolored copy of a Starship config by transforming its palettes in OKLCh.

Usage:
  prompt-palette-transform --hue DEG   SRC DST   # rotate every palette hue by DEG
  prompt-palette-transform --sky BAND  SRC DST   # tint toward a time-of-day band

Bands: night, dawn, morning, noon, golden, dusk.

Only '#rrggbb' values inside [palettes.*] tables change; inline colors elsewhere stay as
they are. Lightness is kept, so text contrast on the fills holds, and chroma is reduced
until the color fits in sRGB. Keys that carry a meaning of their own (error, paper, ink,
fg/bg text) are left untouched so an error never turns green.

Used by the opt-in zsh modules in ~/.zsh/prompt-art/ (sky-clock, repo-hue), which call it
only when their cached variant is missing or older than SRC.
"""
import math
import os
import re
import sys

# band: (target hue in degrees, pull toward it 0..1, chroma scale)
SKY_BANDS = {
    "night":   (265, 0.35, 0.75),  # moonlit blue, muted
    "dawn":    (355, 0.30, 0.95),  # rose first light
    "morning": (205, 0.12, 1.00),  # fresh, nearly untouched
    "noon":    (0,   0.00, 1.15),  # full sun: the preset at its most vivid
    "golden":  (70,  0.30, 1.05),  # amber golden hour
    "dusk":    (310, 0.30, 0.90),  # violet afterglow
}

KEEP_KEYS = re.compile(r"error|paper|ink|text", re.I)
ENTRY = re.compile(r"^(\s*([\w-]+)\s*=\s*['\"])#([0-9a-fA-F]{6})(['\"].*)$")


def _to_linear(c):
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def _to_srgb(c):
    return 12.92 * c if c <= 0.0031308 else 1.055 * c ** (1 / 2.4) - 0.055


def hex_to_oklch(h):
    r, g, b = (_to_linear(int(h[i:i + 2], 16) / 255) for i in (0, 2, 4))
    l = (0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b) ** (1 / 3)
    m = (0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b) ** (1 / 3)
    s = (0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b) ** (1 / 3)
    L = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s
    a = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s
    bb = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s
    return L, math.hypot(a, bb), math.degrees(math.atan2(bb, a)) % 360


def _oklch_to_linear(L, C, H):
    a, b = C * math.cos(math.radians(H)), C * math.sin(math.radians(H))
    l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3
    m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3
    s = (L - 0.0894841775 * a - 1.2914855480 * b) ** 3
    return (4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
            -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
            -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s)


def oklch_to_hex(L, C, H):
    # Bisect chroma down until the color fits in sRGB, keeping lightness and hue.
    rgb = _oklch_to_linear(L, C, H)
    if not all(-1e-4 <= c <= 1 + 1e-4 for c in rgb):
        lo, hi = 0.0, C
        for _ in range(24):
            mid = (lo + hi) / 2
            if all(-1e-4 <= c <= 1 + 1e-4 for c in _oklch_to_linear(L, mid, H)):
                lo = mid
            else:
                hi = mid
        rgb = _oklch_to_linear(L, lo, H)
    return "".join(f"{round(_to_srgb(min(1.0, max(0.0, c))) * 255):02x}" for c in rgb)


def _pull_hue(h, target, f):
    d = (target - h + 180) % 360 - 180  # shortest arc
    return (h + d * f) % 360


def transform(hexval, mode, arg):
    L, C, H = hex_to_oklch(hexval)
    if C < 0.02:  # greys have no hue to move
        return hexval.lower()
    if mode == "hue":
        H = (H + arg) % 360
    else:
        target, pull, scale = SKY_BANDS[arg]
        H = _pull_hue(H, target, pull)
        C *= scale
    return oklch_to_hex(L, C, H)


def main():
    if len(sys.argv) != 5 or sys.argv[1] not in ("--hue", "--sky"):
        print(__doc__)
        sys.exit(2)
    mode, raw, src, dst = sys.argv[1][2:], sys.argv[2], sys.argv[3], sys.argv[4]
    if mode == "hue":
        arg = float(raw)
    elif raw in SKY_BANDS:
        arg = raw
    else:
        sys.exit(f"prompt-palette-transform: unknown band '{raw}' ({', '.join(SKY_BANDS)})")

    out, in_palette = [], False
    with open(src, encoding="utf-8") as fh:
        for line in fh:
            stripped = line.strip()
            if stripped.startswith("["):
                in_palette = stripped.startswith("[palettes.")
            m = ENTRY.match(line.rstrip("\n")) if in_palette else None
            if m and not KEEP_KEYS.search(m.group(2)):
                line = f"{m.group(1)}#{transform(m.group(3), mode, arg)}{m.group(4)}\n"
            out.append(line)

    os.makedirs(os.path.dirname(os.path.abspath(dst)), exist_ok=True)
    tmp = f"{dst}.tmp{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.writelines(out)
    os.replace(tmp, dst)  # atomic: a prompt never reads a half-written file


if __name__ == "__main__":
    main()
