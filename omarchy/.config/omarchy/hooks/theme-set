#!/bin/bash

# Called by omarchy-hook theme-set with the new theme name as $1.

THEME_NAME="$1"

# Reload tmux configuration so new theme colors apply immediately
if tmux info &>/dev/null; then
  tmux source-file ~/.config/tmux/tmux.conf 2>/dev/null || true
  tmux refresh-client 2>/dev/null || true
fi

# Restart waymux so its state palette follows the new theme's light/dark mode.
# ~/.config/waymux/config.toml is the source of truth and is never rewritten here.
if systemctl --user is-active --quiet waymux.service 2>/dev/null; then
  systemctl --user restart waymux.service 2>/dev/null || true
else
  pkill -HUP -x waymux 2>/dev/null || true
fi

# Clear stale uwsm app-daemon error flag if any
rm -f "/run/user/$UID/uwsm/app_daemon_error"
