#!/usr/bin/env bash
# TUI Hyprland Border Gradient & Style Switcher using Matchmaker (mm)
set -e

BORDERS_DIR="$HOME/.config/hypr/borders"
TPL_DEST="$HOME/.config/omarchy/themed/hyprland.lua.tpl"
REPO_TPL_DEST="$HOME/.dotfiles/main/omarchy/.config/omarchy/themed/hyprland.lua.tpl"
ANIM_FILE="$HOME/.config/hypr/animations.lua"
REPO_ANIM_FILE="$HOME/.dotfiles/main/hypr/.config/hypr/animations.lua"
PRESET_FILE="$HOME/.config/matchmaker/presets/borders.toml"
STATE_FILE="/dev/shm/hypr-border-state"

# Ensure waymaker binary is accessible
MM_BIN=$(command -v wm || command -v mm || echo "$HOME/.local/bin/wm")

if [ ! -x "$MM_BIN" ]; then
    echo "Error: waymaker (wm) binary not found!" >&2
    exit 1
fi

if [ ! -d "$BORDERS_DIR" ]; then
    echo "Error: Borders directory not found at $BORDERS_DIR" >&2
    exit 1
fi

# Initialize state with default or existing settings
SPEED=100
ANGLE=45
if [ -f "$ANIM_FILE" ]; then
    if grep -q 'leaf = "borderangle".*enabled = false' "$ANIM_FILE"; then
        SPEED=0
    elif grep -q 'leaf = "borderangle".*speed = ' "$ANIM_FILE"; then
        detected_speed=$(sed -n -E 's/.*leaf = "borderangle".*speed = ([0-9]+).*/\1/p' "$ANIM_FILE" | head -n1)
        [ -n "$detected_speed" ] && SPEED="$detected_speed"
    fi
fi
if [ -f "$TPL_DEST" ]; then
    detected_angle=$(sed -n -E 's/.*angle = ([0-9]+).*/\1/p' "$TPL_DEST" | head -n1)
    [ -n "$detected_angle" ] && ANGLE="$detected_angle"
fi

cat << STATE_INIT > "$STATE_FILE"
SPEED=$SPEED
ANGLE=$ANGLE
STATE_INIT

# Run matchmaker TUI with the borders preset
SELECTED_LINE=$("$MM_BIN" --no-read --config "$PRESET_FILE")

# Read final state after user interactions
if [ -f "$STATE_FILE" ]; then
    source "$STATE_FILE" 2>/dev/null || true
fi

# Exit if canceled or empty
if [ -z "$SELECTED_LINE" ]; then
    # Restore original animation config and re-apply current saved theme
    [ -f "$ANIM_FILE" ] && hyprctl reload >/dev/null 2>&1 || true
    current_theme=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || echo "everforest")
    omarchy theme set "$current_theme" >/dev/null 2>&1 || true
    exit 0
fi

# Extract preset path (column 2)
PRESET_PATH="${SELECTED_LINE#*$'\t'}"
[ -z "$PRESET_PATH" ] && PRESET_PATH="$SELECTED_LINE"

if [ -f "$PRESET_PATH" ]; then
    # 1. Update active user template and dotfiles repository template with chosen ANGLE
    mkdir -p "$(dirname "$TPL_DEST")"
    sed "s/angle = [0-9]*/angle = $ANGLE/g" "$PRESET_PATH" > "$TPL_DEST"
    [ -d "$(dirname "$REPO_TPL_DEST")" ] && sed "s/angle = [0-9]*/angle = $ANGLE/g" "$PRESET_PATH" > "$REPO_TPL_DEST"

    # 2. Persist chosen SPEED in animations.lua
    if [ -f "$ANIM_FILE" ]; then
        if [ "$SPEED" -eq 0 ]; then
            sed -i -E 's/hl\.animation\(\{ leaf = "borderangle"[^)]*\)/hl.animation({ leaf = "borderangle", enabled = false })/g' "$ANIM_FILE"
        else
            sed -i -E 's/hl\.animation\(\{ leaf = "borderangle"[^)]*\)/hl.animation({ leaf = "borderangle", enabled = true, speed = '"$SPEED"', bezier = "liner", style = "loop" })/g' "$ANIM_FILE"
        fi
    fi
    if [ -f "$REPO_ANIM_FILE" ]; then
        if [ "$SPEED" -eq 0 ]; then
            sed -i -E 's/hl\.animation\(\{ leaf = "borderangle"[^)]*\)/hl.animation({ leaf = "borderangle", enabled = false })/g' "$REPO_ANIM_FILE"
        else
            sed -i -E 's/hl\.animation\(\{ leaf = "borderangle"[^)]*\)/hl.animation({ leaf = "borderangle", enabled = true, speed = '"$SPEED"', bezier = "liner", style = "loop" })/g' "$REPO_ANIM_FILE"
        fi
    fi

    # 3. Re-render theme with the newly chosen border template
    current_theme=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || echo "everforest")
    omarchy theme set "$current_theme" >/dev/null 2>&1 || true

    # 4. Read title for feedback
    read -r TITLE < "$PRESET_PATH" || true
    TITLE="${TITLE#--}"
    TITLE="${TITLE#\#}"
    TITLE="${TITLE# }"
    [ -z "$TITLE" ] && TITLE="${PRESET_PATH##*/}"

    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "Hyprland" -i "preferences-desktop-theme" "Estilo de Borda Aplicado" "$TITLE\nVelocidade: $SPEED | Ângulo: $ANGLE°"
    fi
    echo "🌈 Estilo de borda '$TITLE' salvo! (Velocidade: $SPEED | Ângulo: $ANGLE°)"
else
    echo "Error: Preset file not found: $PRESET_PATH" >&2
    exit 1
fi
