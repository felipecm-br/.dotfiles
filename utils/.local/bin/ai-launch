#!/usr/bin/env bash
# ai-launch — Start an AI agent CLI for a tmux session (Waymaker startup_command)
#
# Thin entry point for `waymux launch` (run `waymux launch --help`): the menu of CLI × model rows
# with live quota, --auto, --peek, --pick, --next <choice> [args] and the @ai_launch pane tag.
# This wrapper adds what is specific to this machine:
#   ai-quota's providers and state (Antigravity rows come from ai-quota-agy)
#   ai-launch-rows   jail rows: Claude rows start in ai-jail with prompts on (󰌾), plus
#                    "Claude YOLO" (jail-claude, prompts off) and "Claude Host" (plain claude)
#   ai-launch-exec   starts jail-claude / jail-claude-ask through ai-jail and ai-memory
#   $AI_LAUNCH_AGENT (agent | auto | menu | shell) as the default choice; AI_LAUNCH_JAIL=0
#   leaves the Claude rows unjailed; the armed choice file is $XDG_RUNTIME_DIR/ai-launch.next
#   (written by the session picker)

here=$(dirname "$(readlink -f "$0")")
export WAYMUX_QUOTA_STATE_DIR="${WAYMUX_QUOTA_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/ai-quota}"
export WAYMUX_QUOTA_PROVIDERS="${WAYMUX_QUOTA_PROVIDERS-$(printf '%q' "$here/ai-quota-agy")}"
export WAYMUX_QUOTA_PREFERENCE="${WAYMUX_QUOTA_PREFERENCE:-${AI_AGENT_PREFERENCE:-claude agy agyy}}"
[ -n "${AI_QUOTA_SESSION_RATE:-}" ] && export WAYMUX_QUOTA_SESSION_RATE="$AI_QUOTA_SESSION_RATE"

export WAYMUX_LAUNCH_NEXT="${XDG_RUNTIME_DIR:-/tmp}/ai-launch.next"
export WAYMUX_LAUNCH_EXEC="$(printf '%q' "$here/ai-launch-exec")"
export WAYMUX_LAUNCH_FILTER="$(printf '%q' "$here/ai-launch-rows")"
presets="$HOME/.config/waymaker/presets"
[ -f "$presets/ai-launch.toml" ] && export WAYMUX_LAUNCH_PRESET="$presets/ai-launch.toml"
[ -f "$presets/ai-launch-pick.toml" ] && export WAYMUX_LAUNCH_PICK_PRESET="$presets/ai-launch-pick.toml"
if [ -n "${AI_LAUNCH_AGENT:-}" ]; then export WAYMUX_LAUNCH_DEFAULT="$AI_LAUNCH_AGENT"; else unset WAYMUX_LAUNCH_DEFAULT; fi

if ! command -v waymux >/dev/null 2>&1; then
  echo "ai-launch: waymux not found (install it, then run: waymux doctor)" >&2
  exit 127
fi
exec waymux launch "$@"
