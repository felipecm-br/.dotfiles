#!/usr/bin/env bash
# killothers - Kill processes owned by other users, preserving the current user
# Usage: killothers [--dry-run] [--force] [--signal SIGNAL] [--help]

set -uo pipefail

# ── Colors ─────────────────────────────────────────────────────────────────────
RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'
CYAN='\033[0;36m'; BOLD='\033[1m'; DIM='\033[2m'; RESET='\033[0m'

# ── Defaults ───────────────────────────────────────────────────────────────────
DRY_RUN=false
FORCE=false
SIGNAL="TERM"
CURRENT_USER="$(id -un)"
CURRENT_UID="$(id -u)"

# Critical system processes — never killed
CRITICAL_PROCESSES=(
  systemd kernel kthreadd init journald sshd
  udevd dbus-daemon polkitd cron crond
  login agetty getty NetworkManager wpa_supplicant
  auditd rsyslogd syslogd irqbalance thermald
)

# ── Args ───────────────────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case $1 in
    --dry-run|-n)   DRY_RUN=true ;;
    --force|-f)     FORCE=true ;;
    --signal|-s)    SIGNAL="${2:-TERM}"; shift ;;
    --help|-h)
      printf "Usage: killothers [OPTIONS]\n\n"
      printf "Kill every process owned by users other than the current user (%s).\n\n" "$CURRENT_USER"
      printf "Options:\n"
      printf "  -n, --dry-run        Only list the processes, do not kill them\n"
      printf "  -f, --force          Use SIGKILL immediately (skip SIGTERM first)\n"
      printf "  -s, --signal SIG     Initial signal (default: TERM). E.g. KILL, HUP, INT\n"
      printf "  -h, --help           Show this help\n\n"
      printf "Examples:\n"
      printf "  killothers              # Kill other users' processes (TERM → KILL)\n"
      printf "  killothers --dry-run    # List only, kill nothing\n"
      printf "  killothers --force      # Kill immediately with SIGKILL\n"
      exit 0 ;;
    *) printf "${RED}Unknown option: %s. Use --help${RESET}\n" "$1"; exit 1 ;;
  esac
  shift
done

# ── Permission check ──────────────────────────────────────────────────────────
if [[ "$CURRENT_UID" -ne 0 ]]; then
  printf "${YELLOW}${BOLD}Warning:${RESET}${YELLOW} Running without root. Only processes in the same permission group\n"
  printf "         can be killed. Use 'sudo killothers' to kill all of them.${RESET}\n\n"
fi

# ── Check whether a name is critical ─────────────────────────────────────────
is_critical() {
  local name="$1"
  local pid="$2"

  # System PIDs (kernel threads) — always protected
  (( pid <= 2 )) && return 0

  for crit in "${CRITICAL_PROCESSES[@]}"; do
    [[ "$name" == "$crit" ]] && return 0
  done
  return 1
}

# ── Collect other users' processes ─────────────────────────────────────────
declare -a OTHER_PIDS OTHER_USERS OTHER_NAMES OTHER_MEMS

while IFS= read -r line; do
  read -r u pid mem cmd <<< "$line"
  [[ "$u" == "$CURRENT_USER" ]] && continue
  [[ "$u" == "root" && "$CURRENT_UID" -ne 0 ]] && continue  # without root, skip root processes

  local_name="${cmd##*/}"
  local_name="${local_name%%[[:space:]]*}"

  OTHER_PIDS+=("$pid")
  OTHER_USERS+=("$u")
  OTHER_NAMES+=("$local_name")
  OTHER_MEMS+=("$mem")
done < <(ps aux --sort=-%cpu | awk 'NR>1 {print $1, $2, $4, $11}')

# ── No processes found ────────────────────────────────────────────────────────
if [[ ${#OTHER_PIDS[@]} -eq 0 ]]; then
  printf "${GREEN}No processes from other users found.${RESET}\n"
  exit 0
fi

# ── Header ───────────────────────────────────────────────────────────────────
printf "\n${BOLD}${CYAN}══ KILLOTHERS ════════════════════════════════════════════════════${RESET}\n"
printf "  Current user  : ${BOLD}%s${RESET}\n" "$CURRENT_USER"
  if $DRY_RUN; then
    printf "  Mode          : ${YELLOW}DRY-RUN (nothing will be killed)${RESET}\n"
  else
    printf "  Mode          : ${RED}ACTIVE${RESET}\n"
  fi
printf "  Signal        : %s\n\n" "$SIGNAL"

printf "${BOLD}%-8s %-14s %-8s %6s   %-35s${RESET}\n" "STATUS" "USER" "PID" "CPU%" "PROCESS"
printf "${DIM}%s${RESET}\n" "────────────────────────────────────────────────────────────────────────────"

killed=0
skipped=0
failed=0

for (( i=0; i<${#OTHER_PIDS[@]}; i++ )); do
  pid="${OTHER_PIDS[$i]}"
  user="${OTHER_USERS[$i]}"
  name="${OTHER_NAMES[$i]}"
  mem="${OTHER_MEMS[$i]}"

  # Check that the process still exists
  kill -0 "$pid" 2>/dev/null || continue

  if is_critical "$name" "$pid"; then
    printf "  ${DIM}%-6s${RESET}  ${DIM}%-14s %-8s %5s%%   %-35s [critical, skipped]${RESET}\n" \
      "SKIP" "${user:0:14}" "$pid" "$mem" "${name:0:35}"
    (( skipped++ ))
    continue
  fi

  if $DRY_RUN; then
    printf "  ${YELLOW}%-6s${RESET}  %-14s %-8s %5s%%   %-35s\n" \
      "DRY" "${user:0:14}" "$pid" "$mem" "${name:0:35}"
    (( killed++ ))
    continue
  fi

  # Try to kill
  if $FORCE; then
    # Straight SIGKILL
    if kill -KILL "$pid" 2>/dev/null; then
      printf "  ${RED}%-6s${RESET}  %-14s %-8s %5s%%   %-35s\n" \
        "KILL" "${user:0:14}" "$pid" "$mem" "${name:0:35}"
      (( killed++ ))
    else
      printf "  ${YELLOW}%-6s${RESET}  %-14s %-8s %5s%%   %-35s [permission denied]\n" \
        "DENY" "${user:0:14}" "$pid" "$mem" "${name:0:35}"
      (( failed++ ))
    fi
  else
    # SIGTERM → wait → SIGKILL if it persists
    if kill -"$SIGNAL" "$pid" 2>/dev/null; then
      sleep 1
      if kill -0 "$pid" 2>/dev/null; then
        # Process survived — force SIGKILL
        if kill -KILL "$pid" 2>/dev/null; then
          printf "  ${RED}%-6s${RESET}  %-14s %-8s %5s%%   %-35s [forced KILL]\n" \
            "KILL" "${user:0:14}" "$pid" "$mem" "${name:0:35}"
        else
          printf "  ${YELLOW}%-6s${RESET}  %-14s %-8s %5s%%   %-35s [survived KILL]\n" \
            "STUCK" "${user:0:14}" "$pid" "$mem" "${name:0:35}"
          (( failed++ ))
          continue
        fi
      else
        printf "  ${GREEN}%-6s${RESET}  %-14s %-8s %5s%%   %-35s\n" \
          "TERM" "${user:0:14}" "$pid" "$mem" "${name:0:35}"
      fi
      (( killed++ ))
    else
      printf "  ${YELLOW}%-6s${RESET}  %-14s %-8s %5s%%   %-35s [permission denied]\n" \
        "DENY" "${user:0:14}" "$pid" "$mem" "${name:0:35}"
      (( failed++ ))
    fi
  fi
done

# ── Summary ────────────────────────────────────────────────────────────────────
printf "${DIM}%s${RESET}\n" "────────────────────────────────────────────────────────────────────────────"
if $DRY_RUN; then
  printf "\n${YELLOW}${BOLD}Dry-run:${RESET} %d process(es) would be killed. Re-run without --dry-run to confirm.\n\n" "$killed"
else
  printf "\n${BOLD}Summary:${RESET}  ${GREEN}%d killed${RESET}  |  ${YELLOW}%d skipped${RESET}  |  ${RED}%d failed${RESET}\n\n" \
    "$killed" "$skipped" "$failed"
  (( failed > 0 )) && printf "${DIM}Tip: use 'sudo killothers' to kill processes you lack permission for.${RESET}\n\n"
fi
