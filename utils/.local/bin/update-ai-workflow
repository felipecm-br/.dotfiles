#!/usr/bin/env bash
# ==============================================================================
# update-ai-workflow — AI Workflow Dependency Manager & Telemetry Updater
# ==============================================================================
# Audits, checks, and updates the core dependencies of the AI workflow stack:
#   - Terminal Multiplexer & Plugins: tmux (custom 3.8+ build), TPM plugins
#   - Typography & Icons: Nerd Fonts (Cascadia Mono, JetBrains Mono, Symbols)
#   - AI Coding Agents & Models: Codex, Antigravity (agy), Claude Code, Devin, OpenCode
#   - Daemons & Control Plane: Waymux (control-plane daemon), systemd service
#   - AI Tooling & Sandboxes: ai-memory, ai-jail, ai-usagebar
#   - Worktree & Runtime Ecosystem: worktrunk (awt), mise runtime manager
#
# Usage:
#   update-ai-workflow [options]
#   ai-update [options]
# ==============================================================================

set -uo pipefail

# ── Home & Environment Resolution ─────────────────────────────────────────────
TARGET_USER="${SUDO_USER:-$USER}"
TARGET_HOME=$(getent passwd "$TARGET_USER" 2>/dev/null | cut -d: -f6)
if [[ -z "$TARGET_HOME" || ! -d "$TARGET_HOME" ]]; then
  TARGET_HOME="${REAL_HOME:-$HOME}"
  TARGET_HOME="${TARGET_HOME%%/.local/share/agy-profiles*}"
fi

export HOME="$TARGET_HOME"
export PATH="$TARGET_HOME/.cargo/bin:$TARGET_HOME/.local/bin:$TARGET_HOME/.local/share/mise/shims:/usr/local/sbin:/usr/local/bin:/usr/bin:/bin:$PATH"

DOTFILES_DIR="${DOTFILES_DIR:-$TARGET_HOME/.dotfiles/main}"

# ── Styling & Colors ──────────────────────────────────────────────────────────
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  C_RESET=$'\033[0m'
  C_BOLD=$'\033[1m'
  C_DIM=$'\033[2m'
  C_GREEN=$'\033[38;2;166;218;149m'   # #a6da95 Catppuccin Green
  C_CYAN=$'\033[38;2;139;213;202m'    # #8bd5ca Catppuccin Cyan
  C_BLUE=$'\033[38;2;138;173;244m'    # #8aadf4 Catppuccin Blue
  C_YELLOW=$'\033[38;2;238;212;159m'  # #eed49f Catppuccin Yellow
  C_RED=$'\033[38;2;237;135;150m'     # #ed8796 Catppuccin Red
  C_MAGENTA=$'\033[38;2;198;160;246m' # #c6a0f6 Catppuccin Mauve
  C_GRAY=$'\033[38;2;110;115;141m'    # #6e738d Catppuccin Overlay0
else
  C_RESET=''
  C_BOLD=''
  C_DIM=''
  C_GREEN=''
  C_CYAN=''
  C_BLUE=''
  C_YELLOW=''
  C_RED=''
  C_MAGENTA=''
  C_GRAY=''
fi

# ── Icons ─────────────────────────────────────────────────────────────────────
# Program glyphs come from the waymux icon registry ([icons] in ~/.config/waymux/config.toml).
# ICON_* names follow the registry keys: ai-memory -> ICON_AI_MEMORY.
eval "$(waymux icons --format sh 2>/dev/null)"
for _icon in ICON_AI ICON_TMUX ICON_FONTS ICON_CODEX ICON_AGY ICON_ANTIGRAVITY_IDE ICON_CLAUDE \
  ICON_DEVIN ICON_OPENCODE ICON_WAYMUX ICON_AI_MEMORY ICON_AI_JAIL ICON_AI_USAGEBAR \
  ICON_WORKTRUNK ICON_MISE; do
  # Keep the matrix columns aligned when waymux is missing (first install)
  printf -v "$_icon" '%s' "${!_icon:-·}"
done
unset _icon

ICON_OK="${C_GREEN}✓${C_RESET}"
ICON_WARN="${C_YELLOW}▲${C_RESET}"
ICON_FAIL="${C_RED}✗${C_RESET}"
ICON_INFO="${C_BLUE}➜${C_RESET}"
ICON_WAIT="${C_CYAN}⟳${C_RESET}"
ICON_SKIP="${C_GRAY}—${C_RESET}"

# ── CLI Arguments ─────────────────────────────────────────────────────────────
MODE="update"
AUTO_CONFIRM=false
FORCE_ALL=false
TARGET_ONLY=""
OUTPUT_JSON=false

usage() {
  echo -e "${C_BOLD}${C_MAGENTA}${ICON_AI} AI Workflow Dependency Manager${C_RESET}"
  echo -e "Audits, checks, and updates the core dependencies of the AI workflow stack.\n"
  echo -e "${C_BOLD}USAGE:${C_RESET}"
  echo -e "  update-ai-workflow [OPTIONS]"
  echo -e "  ai-update [OPTIONS]\n"
  echo -e "${C_BOLD}OPTIONS:${C_RESET}"
  echo -e "  -c, --check           Dry-run status audit; display version matrix without updating"
  echo -e "  -u, --update          Check and apply updates to outdated dependencies (default)"
  echo -e "  -y, --yes             Skip confirmation prompt and auto-apply updates"
  echo -e "  -a, --all             Force reinstall/rebuild of all dependencies even if up-to-date"
  echo -e "  -o, --only <comp>     Target a specific component or category"
  echo -e "  --json                Output status report in structured JSON format"
  echo -e "  -h, --help            Show this help manual\n"
  echo -e "${C_BOLD}SUPPORTED COMPONENTS (--only):${C_RESET}"
  echo -e "  tmux                  Tmux multiplexer & TPM plugins"
  echo -e "  fonts, nerd-fonts     Nerd Font packages (Cascadia, JetBrains, Symbols)"
  echo -e "  codex                 OpenAI Codex CLI (via mise)"
  echo -e "  agy, antigravity-cli  Google Antigravity CLI (agy-bin self-update)"
  echo -e "  antigravity-ide, ide  Google Antigravity IDE (via AUR/yay)"
  echo -e "  antigravity           Both Antigravity CLI and IDE"
  echo -e "  claude                Anthropic Claude Code CLI (via mise)"
  echo -e "  devin                 Cognition Devin CLI (devin self-update)"
  echo -e "  opencode              OpenCode CLI (via mise)"
  echo -e "  waymux                Waymux control-plane daemon & systemd service"
  echo -e "  ai-memory             AI long-term memory CLI (ai-memory)"
  echo -e "  ai-jail               AI agent filesystem & network sandbox (ai-jail)"
  echo -e "  ai-usagebar           AI provider plan usage bar (ai-usagebar)"
  echo -e "  ai-suite, ai-tools    All AI utilities (memory, jail, usagebar)"
  echo -e "  worktrunk, awt        Git worktree orchestrator for AI sessions"
  echo -e "  mise                  Runtime & toolchain manager\n"
  echo -e "${C_BOLD}EXAMPLES:${C_RESET}"
  echo -e "  # Inspect version matrix (dry-run audit)"
  echo -e "  update-ai-workflow --check\n"
  echo -e "  # Update outdated AI tools interactively"
  echo -e "  update-ai-workflow\n"
  echo -e "  # Update without confirmation prompts (for cron, automation, hooks)"
  echo -e "  update-ai-workflow -y\n"
  echo -e "  # Update only tmux and its plugins"
  echo -e "  update-ai-workflow --only tmux\n"
  echo -e "  # Update only Antigravity and Codex"
  echo -e "  update-ai-workflow --only agy"
  echo -e "  update-ai-workflow --only antigravity-ide"
  echo -e "  update-ai-workflow --only codex"
  exit 0
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -c|--check)
      MODE="check"
      shift
      ;;
    -u|--update)
      MODE="update"
      shift
      ;;
    -y|--yes)
      AUTO_CONFIRM=true
      shift
      ;;
    -a|--all)
      FORCE_ALL=true
      shift
      ;;
    -o|--only)
      TARGET_ONLY="${2:-}"
      if [[ -z "$TARGET_ONLY" ]]; then
        echo -e "${C_RED}error:${C_RESET} --only requires a component name" >&2
        exit 1
      fi
      shift 2
      ;;
    --json)
      OUTPUT_JSON=true
      shift
      ;;
    -h|--help)
      usage
      ;;
    *)
      echo -e "${C_RED}error:${C_RESET} unknown option: $1" >&2
      echo "Run 'update-ai-workflow --help' for usage." >&2
      exit 1
      ;;
  esac
done

# Normalize TARGET_ONLY
normalize_target() {
  case "$1" in
    fonts|font|nerd-fonts|nerdfonts) echo "fonts" ;;
    tmux|tmux-plugins|plugins) echo "tmux" ;;
    agy|antigravity-cli) echo "agy" ;;
    antigravity-ide|ide) echo "antigravity-ide" ;;
    antigravity) echo "antigravity" ;;
    codex) echo "codex" ;;
    claude|claudecode) echo "claude" ;;
    devin) echo "devin" ;;
    opencode) echo "opencode" ;;
    waymux) echo "waymux" ;;
    ai-memory) echo "ai-memory" ;;
    ai-jail) echo "ai-jail" ;;
    ai-usagebar) echo "ai-usagebar" ;;
    ai-suite|ai-tools) echo "ai-suite" ;;
    worktrunk|awt) echo "worktrunk" ;;
    mise) echo "mise" ;;
    *) echo "$1" ;;
  esac
}

if [[ -n "$TARGET_ONLY" ]]; then
  TARGET_ONLY=$(normalize_target "$TARGET_ONLY")
fi

should_run() {
  local comp="$1"
  if [[ -z "$TARGET_ONLY" ]]; then
    return 0
  fi
  if [[ "$TARGET_ONLY" == "tmux" ]]; then
    [[ "$comp" == "tmux" || "$comp" == "plugins" ]] && return 0
  fi
  if [[ "$TARGET_ONLY" == "antigravity" ]]; then
    [[ "$comp" == "agy" || "$comp" == "antigravity-ide" ]] && return 0
  fi
  if [[ "$TARGET_ONLY" == "ai-suite" ]]; then
    [[ "$comp" == "ai-memory" || "$comp" == "ai-jail" || "$comp" == "ai-usagebar" ]] && return 0
  fi
  [[ "$TARGET_ONLY" == "$comp" ]]
}

# ── Status Inspection Functions ───────────────────────────────────────────────

TMP_DIR=$(mktemp -d -t ai-update-XXXXXX)
trap 'rm -rf "$TMP_DIR"' EXIT

record_status() {
  local key="$1"
  local name="$2"
  local icon="$3"
  local cur="$4"
  local lat="$5"
  local status="$6" # OK, UPDATE, MISSING, OPTIONAL, ERROR
  local note="${7:-}"

  cat <<EOF > "$TMP_DIR/$key"
KEY="$key"
NAME="$name"
ICON="$icon"
CURRENT="$cur"
LATEST="$lat"
STATUS="$status"
NOTE="$note"
EOF
}

# 1. Tmux
inspect_tmux() {
  local cur="missing"
  if command -v tmux &>/dev/null; then
    cur=$(tmux -V 2>/dev/null | awk '{print $2}')
  elif [[ -x "$TARGET_HOME/.local/bin/tmux" ]]; then
    cur=$("$TARGET_HOME/.local/bin/tmux" -V 2>/dev/null | awk '{print $2}')
  fi

  local lat="$cur"
  local release_json
  release_json=$(curl -fsSL --max-time 4 https://api.github.com/repos/tmux/tmux/releases/latest 2>/dev/null || true)
  if [[ -n "$release_json" ]]; then
    local fetched_tag
    fetched_tag=$(echo "$release_json" | grep -m1 '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/' || true)
    [[ -n "$fetched_tag" ]] && lat="$fetched_tag"
  fi

  local status="OK"
  if [[ "$cur" == "missing" ]]; then
    status="MISSING"
  elif [[ "$cur" != "$lat" && "$lat" != "missing" ]]; then
    status="UPDATE"
  fi

  record_status "tmux" "tmux (sixel/systemd)" "$ICON_TMUX" "$cur" "$lat" "$status"
}

# 2. Tmux Plugins
inspect_tmux_plugins() {
  local cur="0 plugins"
  local plugin_dir="$TARGET_HOME/.tmux/plugins"
  if [[ -d "$plugin_dir" ]]; then
    local cnt
    cnt=$(find "$plugin_dir" -mindepth 1 -maxdepth 1 -type d | wc -l)
    cur="${cnt} plugins"
  fi

  local lat="latest"
  local status="OK"

  record_status "plugins" "tmux plugins (tpm)" "$ICON_TMUX" "$cur" "$lat" "$status"
}

# 3. Nerd Fonts
inspect_fonts() {
  local cur="missing"
  if pacman -Q ttf-cascadia-mono-nerd &>/dev/null; then
    cur=$(pacman -Q ttf-cascadia-mono-nerd 2>/dev/null | awk '{print $2}')
  fi

  local lat="3.5.1"
  local font_json
  font_json=$(curl -fsSL --max-time 4 https://api.github.com/repos/ryanoasis/nerd-fonts/releases/latest 2>/dev/null || true)
  if [[ -n "$font_json" ]]; then
    local fetched_tag
    fetched_tag=$(echo "$font_json" | grep -m1 '"tag_name":' | sed -E 's/.*"v?([^"]+)".*/\1/' || true)
    [[ -n "$fetched_tag" ]] && lat="$fetched_tag"
  fi

  local status="OK"
  if [[ "$cur" == "missing" ]]; then
    status="MISSING"
  else
    local cur_clean="${cur%%-*}"
    if [[ "$cur_clean" != "$lat" ]]; then
      status="UPDATE"
    fi
  fi

  record_status "fonts" "nerd fonts (mono+propo)" "$ICON_FONTS" "$cur" "$lat" "$status"
}

# 4. Mise Outdated Batch
inspect_mise_tools() {
  local outdated_json="{}"
  if command -v mise &>/dev/null; then
    outdated_json=$(HOME="$TARGET_HOME" timeout 4 mise outdated --json 2>/dev/null || echo "{}")
  fi

  check_one_mise() {
    local key="$1"
    local label="$2"
    local icon="$3"
    local tool_name="$4"
    local is_optional="${5:-false}"

    local cur="missing"
    if command -v mise &>/dev/null; then
      cur=$(HOME="$TARGET_HOME" mise current "$tool_name" 2>/dev/null || true)
      [[ -z "$cur" ]] && cur=$(HOME="$TARGET_HOME" mise ls "$tool_name" 2>/dev/null | tail -n1 | awk '{print $2}' || true)
      [[ -z "$cur" ]] && cur="missing"
    fi

    local lat="$cur"
    local is_outdated=false
    if command -v jq &>/dev/null && [[ "$outdated_json" != "{}" ]]; then
      local jq_lat
      jq_lat=$(echo "$outdated_json" | jq -r ".[\"$tool_name\"].latest // empty" 2>/dev/null || true)
      if [[ -n "$jq_lat" && "$jq_lat" != "null" ]]; then
        lat="$jq_lat"
        is_outdated=true
      fi
    fi

    local status="OK"
    if [[ "$cur" == "missing" ]]; then
      if [[ "$is_optional" == true ]]; then
        status="OPTIONAL"
        lat="optional"
      else
        status="MISSING"
      fi
    elif [[ "$is_outdated" == true || ("$cur" != "$lat" && "$lat" != "missing") ]]; then
      status="UPDATE"
    fi

    record_status "$key" "$label" "$icon" "$cur" "$lat" "$status"
  }

  check_one_mise "codex" "codex" "$ICON_CODEX" "codex" false
  check_one_mise "claude" "claude (claude code)" "$ICON_CLAUDE" "claude" false
  check_one_mise "opencode" "opencode" "$ICON_OPENCODE" "opencode" false
}

# 5. Antigravity CLI (agy)
inspect_agy() {
  local cur="missing"
  if [[ -x "$TARGET_HOME/.local/bin/agy-bin" ]]; then
    cur=$("$TARGET_HOME/.local/bin/agy-bin" --version 2>/dev/null || echo "missing")
  elif command -v agy &>/dev/null; then
    cur=$(agy --version 2>/dev/null || echo "missing")
  fi

  local lat="$cur"
  local status="OK"
  if [[ "$cur" == "missing" ]]; then
    status="MISSING"
  fi

  # Check agy self-update availability
  if [[ -x "$TARGET_HOME/.local/bin/agy-bin" ]]; then
    local update_check
    update_check=$(HOME="$TARGET_HOME" timeout 4 "$TARGET_HOME/.local/bin/agy-bin" update 2>&1 || true)
    if [[ "$update_check" == *"already on the latest version"* ]]; then
      status="OK"
      lat="$cur"
    elif [[ "$update_check" == *"Downloading"* || "$update_check" == *"Updated"* ]]; then
      status="UPDATE"
      lat="update available"
    fi
  fi

  record_status "agy" "antigravity (agy)" "$ICON_AGY" "$cur" "$lat" "$status"
}

# 6. Antigravity IDE (GUI)
inspect_antigravity_ide() {
  local cur="missing"
  if pacman -Q antigravity-ide &>/dev/null; then
    cur=$(pacman -Q antigravity-ide 2>/dev/null | awk '{print $2}')
  elif command -v antigravity-ide &>/dev/null; then
    cur="installed"
  fi

  local lat="$cur"
  local status="OK"
  if [[ "$cur" == "missing" ]]; then
    status="MISSING"
  else
    local aur_json
    aur_json=$(curl -fsSL --max-time 4 "https://aur.archlinux.org/rpc/v5/info?arg[]=antigravity-ide" 2>/dev/null || true)
    if [[ -n "$aur_json" ]] && command -v jq &>/dev/null; then
      local aur_ver
      aur_ver=$(echo "$aur_json" | jq -r '.results[0].Version // empty' 2>/dev/null || true)
      if [[ -n "$aur_ver" ]]; then
        lat="$aur_ver"
        if [[ "$cur" != "$lat" ]]; then
          status="UPDATE"
        fi
      fi
    elif command -v yay &>/dev/null; then
      if yay -Qu antigravity-ide 2>/dev/null | grep -q 'antigravity-ide'; then
        status="UPDATE"
        lat="AUR update"
      fi
    fi
  fi

  record_status "antigravity-ide" "antigravity-ide (gui)" "$ICON_ANTIGRAVITY_IDE" "$cur" "$lat" "$status"
}

# 6b. Devin CLI (devin)
inspect_devin() {
  local cur="missing"
  if [[ -x "$TARGET_HOME/.local/bin/devin" ]]; then
    cur=$("$TARGET_HOME/.local/bin/devin" --version 2>/dev/null | awk '{print $2}' || echo "missing")
  elif command -v devin &>/dev/null; then
    cur=$(devin --version 2>/dev/null | awk '{print $2}' || echo "missing")
  fi

  local lat="$cur"
  local remote_ver
  remote_ver=$(curl -fsSL --max-time 4 "https://static.devin.ai/cli/current/manifest.json" 2>/dev/null | grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/' || true)
  if [[ -n "$remote_ver" ]]; then
    lat="$remote_ver"
  fi

  local status="OK"
  if [[ "$cur" == "missing" ]]; then
    status="MISSING"
  elif [[ "$cur" != "$lat" && "$lat" != "missing" ]]; then
    status="UPDATE"
  fi

  record_status "devin" "devin (cognition cli)" "$ICON_DEVIN" "$cur" "$lat" "$status"
}

# 7. Waymux Daemon
inspect_waymux() {
  local cur="missing"
  if [[ -x "$TARGET_HOME/.local/bin/waymux" ]]; then
    cur=$("$TARGET_HOME/.local/bin/waymux" --version 2>/dev/null | awk '{print $2}' || true)
  elif command -v waymux &>/dev/null; then
    cur=$(waymux --version 2>/dev/null | awk '{print $2}' || true)
  fi

  local lat="$cur"
  local status="OK"
  if [[ "$cur" == "missing" ]]; then
    status="MISSING"
  fi

  # Check remote git commit
  local remote_head
  remote_head=$(git ls-remote --exit-code https://github.com/felipecm-br/waymux.git HEAD 2>/dev/null | cut -c1-7 || true)
  if [[ -n "$remote_head" ]]; then
    lat="git:${remote_head}"
  fi

  record_status "waymux" "waymux (cockpit & rpc daemon)" "$ICON_WAYMUX" "$cur" "$lat" "$status"
}

# 7. AI Memory
inspect_ai_memory() {
  local cur="missing"
  if command -v ai-memory &>/dev/null; then
    cur=$(ai-memory --version 2>/dev/null | awk '{print $2}' || true)
    cur="${cur##v}"
  fi
  local lat="1.17.3"
  local status="OK"
  [[ "$cur" == "missing" ]] && status="MISSING"
  record_status "ai-memory" "ai-memory (knowledge store)" "$ICON_AI_MEMORY" "$cur" "$lat" "$status"
}

# 8. AI Jail
inspect_ai_jail() {
  local cur="missing"
  if command -v ai-jail &>/dev/null; then
    cur=$(ai-jail --version 2>/dev/null | awk '{print $2}' || true)
    cur="${cur##v}"
  fi
  local lat="1.16.0"
  local status="OK"
  [[ "$cur" == "missing" ]] && status="MISSING"
  record_status "ai-jail" "ai-jail (agent sandbox)" "$ICON_AI_JAIL" "$cur" "$lat" "$status"
}

# 9. AI Usagebar
inspect_ai_usagebar() {
  local cur="missing"
  if pacman -Q ai-usagebar-bin &>/dev/null; then
    cur=$(pacman -Q ai-usagebar-bin 2>/dev/null | awk '{print $2}')
  elif command -v ai-usagebar &>/dev/null; then
    cur=$(ai-usagebar --version 2>/dev/null | awk '{print $2}' || true)
    cur="${cur##v}"
  fi
  local lat="$cur"
  local status="OK"
  [[ "$cur" == "missing" ]] && status="MISSING"
  record_status "ai-usagebar" "ai-usagebar (plan usage)" "$ICON_AI_USAGEBAR" "$cur" "$lat" "$status"
}

# 10. Worktree Orchestrator (worktrunk / awt)
inspect_worktrunk() {
  local cur="missing"
  if pacman -Q worktrunk &>/dev/null; then
    cur=$(pacman -Q worktrunk 2>/dev/null | awk '{print $2}')
  elif command -v worktrunk &>/dev/null; then
    cur=$(worktrunk --version 2>/dev/null | awk '{print $2}')
  fi

  local lat="$cur"
  local status="OK"
  if [[ "$cur" == "missing" ]]; then
    status="MISSING"
  elif command -v yay &>/dev/null; then
    if yay -Qu worktrunk 2>/dev/null | grep -q 'worktrunk'; then
      status="UPDATE"
      lat="AUR update"
    fi
  fi

  record_status "worktrunk" "worktrunk (awt engine)" "$ICON_WORKTRUNK" "$cur" "$lat" "$status"
}

# 11. Mise
inspect_mise() {
  local cur="missing"
  if command -v mise &>/dev/null; then
    cur=$(mise --version 2>/dev/null | awk '{print $1}')
  fi

  local lat="$cur"
  local status="OK"
  if [[ "$cur" == "missing" ]]; then
    status="MISSING"
  fi

  record_status "mise" "mise (runtime manager)" "$ICON_MISE" "$cur" "$lat" "$status"
}

# ── Parallel Audit Dispatcher ─────────────────────────────────────────────────
run_parallel_audit() {
  local pids=()

  if should_run "tmux"; then
    inspect_tmux & pids+=($!)
    inspect_tmux_plugins & pids+=($!)
  fi

  if should_run "fonts"; then
    inspect_fonts & pids+=($!)
  fi

  if should_run "codex" || should_run "claude" || should_run "opencode"; then
    inspect_mise_tools & pids+=($!)
  fi

  if should_run "agy"; then
    inspect_agy & pids+=($!)
  fi

  if should_run "antigravity-ide"; then
    inspect_antigravity_ide & pids+=($!)
  fi

  if should_run "devin"; then
    inspect_devin & pids+=($!)
  fi

  if should_run "waymux"; then
    inspect_waymux & pids+=($!)
  fi

  if should_run "ai-memory"; then
    inspect_ai_memory & pids+=($!)
  fi

  if should_run "ai-jail"; then
    inspect_ai_jail & pids+=($!)
  fi

  if should_run "ai-usagebar"; then
    inspect_ai_usagebar & pids+=($!)
  fi

  if should_run "worktrunk"; then
    inspect_worktrunk & pids+=($!)
  fi

  if should_run "mise"; then
    inspect_mise & pids+=($!)
  fi

  for pid in "${pids[@]}"; do
    wait "$pid" 2>/dev/null || true
  done
}

# ── Display Table ─────────────────────────────────────────────────────────────
display_report() {
  local total=0
  local ok_count=0
  local update_count=0
  local missing_count=0
  local optional_count=0

  echo ""
  echo -e "${C_BOLD}╭────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  echo -e "${C_BOLD}│  ${C_MAGENTA}${ICON_AI}${C_RESET}${C_BOLD}  AI WORKFLOW DEPENDENCY AUDIT MATRIX                                    │${C_RESET}"
  echo -e "${C_BOLD}╰────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

  printf "${C_BOLD}%-3s %-28s %-15s %-15s %-18s${C_RESET}\n" " " "Component" "Current" "Latest" "Status"
  echo -e "${C_GRAY}────────────────────────────────────────────────────────────────────────────${C_RESET}"

  local order=("tmux" "plugins" "fonts" "codex" "agy" "antigravity-ide" "claude" "devin" "opencode" "waymux" "ai-memory" "ai-jail" "ai-usagebar" "worktrunk" "mise")

  for key in "${order[@]}"; do
    should_run "$key" || continue
    local file="$TMP_DIR/$key"
    [[ ! -f "$file" ]] && continue

    local KEY NAME ICON CURRENT LATEST STATUS NOTE
    # shellcheck disable=SC1090
    source "$file"

    total=$((total + 1))

    local status_display=""
    case "$STATUS" in
      OK)
        ok_count=$((ok_count + 1))
        status_display="${ICON_OK} ${C_GREEN}Up-to-date${C_RESET}"
        ;;
      UPDATE)
        update_count=$((update_count + 1))
        status_display="${ICON_WARN} ${C_YELLOW}Update available${C_RESET}"
        ;;
      MISSING)
        missing_count=$((missing_count + 1))
        status_display="${ICON_FAIL} ${C_RED}Missing${C_RESET}"
        ;;
      OPTIONAL)
        optional_count=$((optional_count + 1))
        status_display="${ICON_SKIP} ${C_DIM}Not installed${C_RESET}"
        ;;
      *)
        status_display="${ICON_FAIL} ${C_RED}Check failed${C_RESET}"
        ;;
    esac

    printf "%-3b %-28b %-15b %-15b %-18b\n" "$ICON" "$NAME" "${CURRENT:0:14}" "${LATEST:0:14}" "$status_display"
  done

  echo -e "${C_GRAY}────────────────────────────────────────────────────────────────────────────${C_RESET}"
  echo -e "Total: ${C_BOLD}${total}${C_RESET} | Up-to-date: ${C_GREEN}${ok_count}${C_RESET} | Updates available: ${C_YELLOW}${update_count}${C_RESET} | Missing: ${C_RED}${missing_count}${C_RESET}"
  echo ""

  return "$update_count"
}

# ── Update Implementation Routines ───────────────────────────────────────────

update_tmux() {
  local file="$TMP_DIR/tmux"
  # shellcheck disable=SC1090
  [[ -f "$file" ]] && source "$file"
  local target_ver="${LATEST:-3.8}"
  [[ "$target_ver" == "missing" ]] && target_ver="3.8"

  echo -e "${C_BLUE}${ICON_INFO}${C_RESET} Updating ${C_BOLD}tmux${C_RESET} to ${C_CYAN}v${target_ver}${C_RESET} (with sixel/systemd)..."

  local build_dir
  build_dir=$(mktemp -d -t tmux-build-XXXXXX)
  local tarball="tmux-${target_ver}.tar.gz"
  local url="https://github.com/tmux/tmux/releases/download/${target_ver}/${tarball}"

  if ! curl -fsSL --max-time 30 "$url" -o "${build_dir}/${tarball}"; then
    echo -e "  ${C_RED}${ICON_FAIL}${C_RESET} Failed to download tmux release tarball from $url"
    rm -rf "$build_dir"
    return 1
  fi

  if ! tar -xzf "${build_dir}/${tarball}" -C "$build_dir"; then
    echo -e "  ${C_RED}${ICON_FAIL}${C_RESET} Failed to extract tmux tarball"
    rm -rf "$build_dir"
    return 1
  fi

  local src_dir="${build_dir}/tmux-${target_ver}"
  (
    cd "$src_dir" || exit 1
    ./configure --prefix="${TARGET_HOME}/.local" --enable-sixel --enable-systemd --enable-utempter >/dev/null 2>&1
    make -j"$(nproc 2>/dev/null || echo 2)" >/dev/null 2>&1
    make install >/dev/null 2>&1
  )
  local status=$?
  rm -rf "$build_dir"

  if (( status == 0 )); then
    echo -e "  ${C_GREEN}${ICON_OK}${C_RESET} tmux ${C_GREEN}v${target_ver}${C_RESET} successfully installed to ${C_BOLD}~/.local/bin/tmux${C_RESET}"
  else
    echo -e "  ${C_RED}${ICON_FAIL}${C_RESET} Failed to compile tmux"
    return 1
  fi

  update_tmux_plugins
}

update_tmux_plugins() {
  echo -e "${C_BLUE}${ICON_INFO}${C_RESET} Synchronizing and updating ${C_BOLD}tmux plugins${C_RESET} via TPM..."
  local tpm_update="$TARGET_HOME/.tmux/plugins/tpm/bin/update_plugins"
  if [[ -x "$tpm_update" ]]; then
    HOME="$TARGET_HOME" "$tpm_update" all >/dev/null 2>&1 || true
    echo -e "  ${C_GREEN}${ICON_OK}${C_RESET} TPM plugins updated successfully"
  else
    echo -e "  ${C_YELLOW}${ICON_WARN}${C_RESET} TPM updater not found at $tpm_update"
  fi
}

update_fonts() {
  echo -e "${C_BLUE}${ICON_INFO}${C_RESET} Updating ${C_BOLD}Nerd Fonts${C_RESET} via package manager..."
  if command -v yay &>/dev/null; then
    yay -S --needed --noconfirm ttf-cascadia-mono-nerd ttf-jetbrains-mono-nerd ttf-nerd-fonts-symbols ttf-nerd-fonts-symbols-common || true
  elif command -v pacman &>/dev/null; then
    sudo pacman -S --needed --noconfirm ttf-cascadia-mono-nerd ttf-jetbrains-mono-nerd ttf-nerd-fonts-symbols ttf-nerd-fonts-symbols-common || true
  fi

  echo -e "${C_BLUE}${ICON_INFO}${C_RESET} Refreshing fontconfig cache..."
  fc-cache -f "$TARGET_HOME/.local/share/fonts" 2>/dev/null || true
  fc-cache -f 2>/dev/null || true
  echo -e "  ${C_GREEN}${ICON_OK}${C_RESET} Nerd Fonts cache refreshed"
}

update_codex() {
  echo -e "${C_BLUE}${ICON_INFO}${C_RESET} Upgrading ${C_BOLD}OpenAI Codex${C_RESET} via mise..."
  HOME="$TARGET_HOME" mise upgrade codex || HOME="$TARGET_HOME" mise install codex@latest || true
  HOME="$TARGET_HOME" mise reshim || true
  local new_ver
  new_ver=$(HOME="$TARGET_HOME" mise current codex 2>/dev/null || true)
  echo -e "  ${C_GREEN}${ICON_OK}${C_RESET} Codex active version: ${C_GREEN}v${new_ver}${C_RESET}"
}

update_agy() {
  echo -e "${C_BLUE}${ICON_INFO}${C_RESET} Checking and upgrading ${C_BOLD}Google Antigravity CLI (agy)${C_RESET}..."
  if [[ -x "$TARGET_HOME/.local/bin/agy-bin" ]]; then
    HOME="$TARGET_HOME" "$TARGET_HOME/.local/bin/agy-bin" update || true
  fi
  echo -e "  ${C_GREEN}${ICON_OK}${C_RESET} Antigravity CLI updated"
}

update_antigravity_ide() {
  echo -e "${C_BLUE}${ICON_INFO}${C_RESET} Updating ${C_BOLD}Google Antigravity IDE (antigravity-ide)${C_RESET} via yay..."
  if command -v yay &>/dev/null; then
    yay -S --noconfirm antigravity-ide || true
    local new_ver
    new_ver=$(pacman -Q antigravity-ide 2>/dev/null | awk '{print $2}' || true)
    echo -e "  ${C_GREEN}${ICON_OK}${C_RESET} Antigravity IDE version: ${C_GREEN}v${new_ver}${C_RESET}"
  else
    echo -e "  ${C_RED}${ICON_FAIL}${C_RESET} yay is required to update AUR package antigravity-ide"
    return 1
  fi
}

update_claude() {
  echo -e "${C_BLUE}${ICON_INFO}${C_RESET} Upgrading ${C_BOLD}Claude Code (claude)${C_RESET} via mise..."
  HOME="$TARGET_HOME" mise upgrade claude || HOME="$TARGET_HOME" mise install claude@latest || true
  HOME="$TARGET_HOME" mise reshim || true
  local new_ver
  new_ver=$(HOME="$TARGET_HOME" mise current claude 2>/dev/null || true)
  echo -e "  ${C_GREEN}${ICON_OK}${C_RESET} Claude Code active version: ${C_GREEN}v${new_ver}${C_RESET}"
}

update_devin() {
  echo -e "${C_BLUE}${ICON_INFO}${C_RESET} Checking and upgrading ${C_BOLD}Devin CLI (devin)${C_RESET}..."
  if [[ -x "$TARGET_HOME/.local/bin/devin" ]]; then
    HOME="$TARGET_HOME" "$TARGET_HOME/.local/bin/devin" update || true
  else
    curl -fsSL https://cli.devin.ai/install.sh | sed '/"\$VERSION_DIR\/bin\/\$COMPILED_BIN_NAME" setup/d' | HOME="$TARGET_HOME" bash || true
  fi
  local new_ver
  new_ver=$("$TARGET_HOME/.local/bin/devin" --version 2>/dev/null | awk '{print $2}' || true)
  echo -e "  ${C_GREEN}${ICON_OK}${C_RESET} Devin CLI active version: ${C_GREEN}v${new_ver}${C_RESET}"
}

update_opencode() {
  echo -e "${C_BLUE}${ICON_INFO}${C_RESET} Upgrading ${C_BOLD}OpenCode${C_RESET} via mise..."
  HOME="$TARGET_HOME" mise upgrade opencode || HOME="$TARGET_HOME" mise install opencode@latest || true
  HOME="$TARGET_HOME" mise reshim || true
  local new_ver
  new_ver=$(HOME="$TARGET_HOME" mise current opencode 2>/dev/null || true)
  echo -e "  ${C_GREEN}${ICON_OK}${C_RESET} OpenCode active version: ${C_GREEN}v${new_ver}${C_RESET}"
}

update_waymux() {
  echo -e "${C_BLUE}${ICON_INFO}${C_RESET} Building and upgrading ${C_BOLD}Waymux (Unified Orchestrator & Daemon)${C_RESET} via cargo..."
  if command -v cargo &>/dev/null; then
    if HOME="$TARGET_HOME" cargo install --force --git https://github.com/felipecm-br/waymux waymux; then
      mkdir -p "$TARGET_HOME/.local/bin"
      ln -sf "$TARGET_HOME/.cargo/bin/waymux" "$TARGET_HOME/.local/bin/waymux"
      echo -e "  ${C_GREEN}${ICON_OK}${C_RESET} Waymux binary updated at ${C_BOLD}~/.local/bin/waymux${C_RESET}"

      echo -e "${C_BLUE}${ICON_INFO}${C_RESET} Restarting ${C_BOLD}waymux.service${C_RESET} systemd daemon..."
      systemctl --user restart waymux.service 2>/dev/null || true
      echo -e "  ${C_GREEN}${ICON_OK}${C_RESET} waymux service restarted successfully"
    else
      echo -e "  ${C_RED}${ICON_FAIL}${C_RESET} Failed to compile waymux via cargo"
      return 1
    fi
  else
    echo -e "  ${C_RED}${ICON_FAIL}${C_RESET} Cargo not found in PATH"
    return 1
  fi
}

update_ai_memory() {
  echo -e "${C_BLUE}${ICON_INFO}${C_RESET} Updating ${C_BOLD}ai-memory${C_RESET} via cargo..."
  if command -v cargo &>/dev/null; then
    HOME="$TARGET_HOME" cargo install --git https://github.com/akitaonrails/ai-memory ai-memory-cli || true
    echo -e "  ${C_GREEN}${ICON_OK}${C_RESET} ai-memory updated successfully"
  fi
}

update_ai_jail() {
  echo -e "${C_BLUE}${ICON_INFO}${C_RESET} Updating ${C_BOLD}ai-jail${C_RESET} via cargo..."
  if command -v cargo &>/dev/null; then
    HOME="$TARGET_HOME" cargo install --git https://github.com/akitaonrails/ai-jail || true
    echo -e "  ${C_GREEN}${ICON_OK}${C_RESET} ai-jail updated successfully"
  fi
}

update_ai_usagebar() {
  echo -e "${C_BLUE}${ICON_INFO}${C_RESET} Updating ${C_BOLD}ai-usagebar${C_RESET}..."
  if command -v yay &>/dev/null; then
    yay -S --needed --noconfirm ai-usagebar-bin 2>/dev/null || true
  elif command -v cargo &>/dev/null; then
    HOME="$TARGET_HOME" cargo install --git https://github.com/akitaonrails/ai-usagebar || true
  fi
  echo -e "  ${C_GREEN}${ICON_OK}${C_RESET} ai-usagebar updated successfully"
}

update_worktrunk() {
  echo -e "${C_BLUE}${ICON_INFO}${C_RESET} Updating ${C_BOLD}worktrunk (awt)${C_RESET}..."
  if command -v yay &>/dev/null; then
    yay -S --needed --noconfirm worktrunk || true
    echo -e "  ${C_GREEN}${ICON_OK}${C_RESET} worktrunk updated"
  fi
}

update_mise() {
  echo -e "${C_BLUE}${ICON_INFO}${C_RESET} Self-updating ${C_BOLD}mise runtime manager${C_RESET}..."
  if command -v mise &>/dev/null; then
    HOME="$TARGET_HOME" mise self-update -y 2>/dev/null || true
    echo -e "  ${C_GREEN}${ICON_OK}${C_RESET} mise self-update completed"
  fi
}

# ── Main Controller ───────────────────────────────────────────────────────────

main() {
  if [[ "$OUTPUT_JSON" != true ]]; then
    echo -e "${C_CYAN}${ICON_WAIT}${C_RESET} Inspecting AI workflow dependencies in parallel..."
  fi
  run_parallel_audit

  if [[ "$OUTPUT_JSON" == true ]]; then
    local items=()
    for f in "$TMP_DIR"/*; do
      [[ -f "$f" ]] || continue
      local KEY NAME ICON CURRENT LATEST STATUS NOTE
      # shellcheck disable=SC1090
      source "$f"
      items+=("{\"key\":\"$KEY\",\"name\":\"$NAME\",\"current\":\"$CURRENT\",\"latest\":\"$LATEST\",\"status\":\"$STATUS\"}")
    done
    local json_body
    json_body=$(IFS=,; echo "${items[*]}")
    echo "{\"components\":[$json_body]}"
    exit 0
  fi

  local update_count=0
  display_report || update_count=$?

  if [[ "$MODE" == "check" ]]; then
    if (( update_count > 0 )); then
      exit 1
    else
      exit 0
    fi
  fi

  if (( update_count == 0 )) && [[ "$FORCE_ALL" == false ]]; then
    echo -e "${C_GREEN}${ICON_OK} All AI workflow dependencies are fully up-to-date!${C_RESET}"
    echo -e "Use ${C_BOLD}--all${C_RESET} to force reinstallation or rebuild."
    exit 0
  fi

  # Confirmation prompt
  if [[ "$AUTO_CONFIRM" == false ]]; then
    echo -ne "${C_BOLD}Proceed with updating components? [Y/n] ${C_RESET}"
    read -r response
    case "$response" in
      [nN]|[nN][oO])
        echo -e "${C_YELLOW}Update cancelled by user.${C_RESET}"
        exit 0
        ;;
      *)
        ;;
    esac
  fi

  echo ""
  echo -e "${C_BOLD}╭────────────────────────────────────────────────────────────────────────────╮${C_RESET}"
  echo -e "${C_BOLD}│  ${C_CYAN}${ICON_WAIT}${C_RESET}${C_BOLD}  EXECUTING AI WORKFLOW UPGRADES                                         │${C_RESET}"
  echo -e "${C_BOLD}╰────────────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

  needs_update() {
    local key="$1"
    if [[ "$FORCE_ALL" == true ]]; then
      return 0
    fi
    local file="$TMP_DIR/$key"
    if [[ -f "$file" ]]; then
      local STATUS
      # shellcheck disable=SC1090
      source "$file"
      [[ "$STATUS" == "UPDATE" || "$STATUS" == "MISSING" ]]
    else
      return 1
    fi
  }

  if should_run "mise" && needs_update "mise"; then
    update_mise
  fi

  if should_run "tmux" && needs_update "tmux"; then
    update_tmux
  elif should_run "tmux" && needs_update "plugins"; then
    update_tmux_plugins
  fi

  if should_run "fonts" && needs_update "fonts"; then
    update_fonts
  fi

  if should_run "codex" && needs_update "codex"; then
    update_codex
  fi

  if should_run "agy" && needs_update "agy"; then
    update_agy
  fi

  if should_run "antigravity-ide" && needs_update "antigravity-ide"; then
    update_antigravity_ide
  fi

  if should_run "claude" && needs_update "claude"; then
    update_claude
  fi

  if should_run "devin" && needs_update "devin"; then
    update_devin
  fi

  if should_run "opencode" && needs_update "opencode"; then
    update_opencode
  fi

  if should_run "waymux" && needs_update "waymux"; then
    update_waymux
  fi

  if should_run "ai-memory" && needs_update "ai-memory"; then
    update_ai_memory
  fi

  if should_run "ai-jail" && needs_update "ai-jail"; then
    update_ai_jail
  fi

  if should_run "ai-usagebar" && needs_update "ai-usagebar"; then
    update_ai_usagebar
  fi

  if should_run "worktrunk" && needs_update "worktrunk"; then
    update_worktrunk
  fi

  echo ""
  echo -e "${C_GREEN}${ICON_OK}${C_RESET} ${C_BOLD}All requested AI workflow updates completed successfully!${C_RESET}\n"
}

main "$@"
