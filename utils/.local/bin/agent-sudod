#!/usr/bin/env python3
"""agent-sudod: loopback bridge so a jailed agent can ask the human for a privileged command.

Listens on 127.0.0.1:$AGENT_SUDO_PORT (default 49375; forward it into ai-jail with
`forward_ports` in ~/.ai-jail). The ONLY endpoint is POST /run with JSON
{"argv": [str, ...], "cwd": str, "reason": str}. It never exposes tmux: each accepted request
just invokes `agent-sudo`, which opens the approval popup and runs nothing until you press `y`.
Responds {"rc": int, "output": str}. One request at a time (HTTP 429 when busy).
See docs/tmux/agent-sudo-popup.md.
"""
import json
import os
import subprocess
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = int(os.environ.get("AGENT_SUDO_PORT", "49375"))
CLIENT = os.environ.get("AGENT_SUDO_BIN") or os.path.join(os.path.dirname(os.path.realpath(__file__)), "agent-sudo")
MAX_BODY = 64 * 1024
MAX_ARGS = 256
BUSY = threading.Lock()


def validate(req):
    argv, cwd, reason = req.get("argv"), req.get("cwd", ""), req.get("reason", "")
    if not (isinstance(argv, list) and argv and len(argv) <= MAX_ARGS
            and all(isinstance(a, str) and a and "\0" not in a and len(a) <= 4096 for a in argv)):
        return "argv must be a non-empty list of strings"
    if not isinstance(reason, str) or len(reason) > 200 or "\n" in reason:
        return "reason must be a single line of at most 200 chars"
    if not (isinstance(cwd, str) and os.path.isabs(cwd) and os.path.isdir(cwd)):
        return "cwd must be an existing absolute directory"
    return None


class Handler(BaseHTTPRequestHandler):
    server_version = "agent-sudod"

    def log_message(self, fmt, *args):
        sys.stderr.write("agent-sudod: " + fmt % args + "\n")

    def reply(self, code, obj):
        data = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_POST(self):
        if self.path != "/run":
            return self.reply(404, {"error": "not found"})
        try:
            n = int(self.headers.get("Content-Length", "0"))
            if not 0 < n <= MAX_BODY:
                return self.reply(413, {"error": "bad body size"})
            req = json.loads(self.rfile.read(n))
            if not isinstance(req, dict):
                raise ValueError
        except ValueError:
            return self.reply(400, {"error": "invalid JSON"})
        err = validate(req)
        if err:
            return self.reply(400, {"error": err})
        if not BUSY.acquire(blocking=False):
            return self.reply(429, {"error": "another approval is pending"})
        try:
            cmd = [CLIENT, "-r", req.get("reason", ""), "--", *req["argv"]]
            env = {**os.environ, "AGENT_SUDO_VIA_BRIDGE": "1"}
            p = subprocess.run(cmd, cwd=req["cwd"], capture_output=True, text=True, env=env,
                               stdin=subprocess.DEVNULL, errors="replace")
            self.reply(200, {"rc": p.returncode, "output": p.stdout + p.stderr})
        finally:
            BUSY.release()


def main():
    srv = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    sys.stderr.write(f"agent-sudod: listening on 127.0.0.1:{PORT}\n")
    srv.serve_forever()


if __name__ == "__main__":
    main()
