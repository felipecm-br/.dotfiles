#!/usr/bin/env bash
# ai-switch — Change the model or effort of the AI agent running in a tmux pane, in place
#
#   ai-switch [-t pane]             Menu of the pane agent's models (+ effort levels for Claude Code and
#                                   Antigravity); typed into the agent as /model <id> or /effort <level>
#                                   (Antigravity has no /effort: /model <family>-<level>)
#   ai-switch [-t pane] <choice>    Switch directly, no menu (sonnet, high, gemini-3.8-flash-medium…)
#   ai-switch [-t pane] --peek [choice]
#                                   Print the menu rows, or the slash command for <choice>, typing nothing
#   ai-switch [-t pane] --agent     Print "<agent>\t<current model>" and exit 1 when no agent runs there
#
# The window, scrollback and conversation stay: only the agent's own slash command runs. Commands:
# Claude Code /model + /effort, Antigravity and Devin /model <name>, Codex /model (its own picker, which
# also sets reasoning effort). A half-typed prompt is never submitted: ai-prompt sets it aside and brings
# it back after the switch, or the switch stops and says so (agents started before $VISUAL=ai-prompt).
# AI_SWITCH_AGENT=<agent> skips pane detection (tests).

AGENT_RE='^(claude|agy|agy-bin|antigravity|devin|codex)$'
AGY_MODELS="${XDG_STATE_HOME:-$HOME/.local/state}/ai-quota/agy-models.tsv"

pane=${TMUX_PANE:-}
mode=switch
while [ $# -gt 0 ]; do
  case $1 in
    -t) pane=${2:-}; shift 2 ;;
    --peek) mode=peek; shift ;;
    --agent) mode=agent; shift ;;
    -h | --help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) break ;;
  esac
done
choice=${1:-}

say() { # Message in the tmux status line when there is one, always on stderr
  [ -n "${TMUX:-}" ] && tmux display-message "$1" 2>/dev/null
  echo "ai-switch: $1" >&2
}

# Agent CLI in the pane: the foreground command, else the first agent process of its session
# (claude under ai-jail / ai-memory run, agy-bin under the agy wrapper)
pane_agent() {
  local cmd pid
  read -r cmd pid < <(tmux display-message -p -t "$1" '#{pane_current_command} #{pane_pid}' 2>/dev/null) || return 1
  [[ $cmd =~ $AGENT_RE ]] || cmd=$(ps -s "$pid" -o comm= 2>/dev/null | grep -m1 -E "$AGENT_RE")
  case $cmd in
    agy | agy-bin | antigravity) echo agy ;;
    claude | devin | codex) echo "$cmd" ;;
    *) return 1 ;;
  esac
}

if [ -n "${AI_SWITCH_AGENT:-}" ]; then
  agent=$AI_SWITCH_AGENT
elif [ -z "$pane" ] || ! agent=$(pane_agent "$pane"); then
  [ "$mode" = agent ] && exit 1
  say "No AI agent in this pane · Prefix + a launches one"
  exit 1
fi

# Bottom of the pane, once: the current model (Claude status line) and the draft guard read it
screen=""
[ -n "$pane" ] && [ -z "${AI_SWITCH_AGENT:-}" ] && screen=$(tmux capture-pane -p -e -t "$pane" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -8)
plain_screen=$(sed 's/\x1b\[[0-9;]*m//g' <<<"$screen")

current="" effort=""
if [ "$agent" = claude ]; then
  current=$(grep -oE '^[[:space:]]*(Fable|Opus|Sonnet|Haiku) [0-9.]+' <<<"$plain_screen" | tail -1 | awk '{print tolower($1)}')
  # Effort badge above the prompt ("◐ medium · /effort", shown briefly after a change), else the
  # level Claude Code saves per model in settings.json on every /effort
  effort=$(grep -oE '(low|medium|high|xhigh|max|auto) · /eff' <<<"$plain_screen" | tail -1 | cut -d' ' -f1)
  [ -z "$effort" ] && [ -n "$current" ] &&
    effort=$(jq -r --arg f "claude-$current-" 'first(.modelSettings // {} | to_entries[]
      | select(.key | startswith($f)) | .value.effortLevel // empty) // empty' "$HOME/.claude/settings.json" 2>/dev/null)
elif [ "$agent" = agy ]; then
  # Antigravity footer, right side: "<model name> · <effort>" (the effort is part of the model id)
  IFS=$'\t' read -r current effort < <(sed -nE 's/.*  ([^ ].*[^ ]) · (low|medium|high)[[:space:]]*$/\1\t\2/p' <<<"$plain_screen" | tail -1)
fi

if [ "$mode" = agent ]; then
  printf '%s\t%s\n' "$agent" "$current"
  exit 0
fi

pad() { # <text> <width>: pad by visible characters, not bytes
  local s=$1 n=$(($2 - ${#1}))
  [ "$n" -lt 1 ] && n=1
  printf '%s%*s' "$s" "$n" ""
}

# Rows: id \t slash command \t label (and parallel ANSI-styled menu rows)
rows=()
colored_rows=()
row() { rows+=("$1"$'\t'"$2"$'\t'"$3"); colored_rows+=("${4:-$3}"); }
model_row() { # <icon> <id> <name> <tier> [slash command]
  local gut=" " head col_name col_tier
  [ "$2" = "$current" ] && gut="⠛"
  head="$1 $(pad Model 8)"
  col_name=$(pad "$3" 22)
  col_tier=$(pad "$4" 5)
  row "$2" "${5:-/model $2}" "${gut}${head}${col_name}${col_tier}" \
    "$(printf '\033[97m%s\033[34m%s\033[0m%s\033[90m%s\033[0m' "$gut" "$head" "$col_name" "$col_tier")"
}

effort_row() { # <level> <slash command>
  local gut=" " head col_name
  [ "$1" = "$effort" ] && gut="⠛"
  head="󱐋 $(pad Effort 8)"
  col_name=$(pad "$1" 27)
  row "$1" "$2" "${gut}${head}${col_name}" \
    "$(printf '\033[97m%s\033[34m%s\033[0m%s' "$gut" "$head" "$col_name")"
}

icon() { waymux icon "$1" 2>/dev/null || echo "${1:0:1}"; }

case $agent in
  claude)
    ic=$(icon claude)
    model_row "$ic" fable Fable '$$$$'
    model_row "$ic" opus Opus '$$$'
    model_row "$ic" sonnet Sonnet '$$'
    model_row "$ic" haiku Haiku '$'
    for e in low medium high xhigh max auto; do effort_row "$e" "/effort $e"; done
    ;;
  agy)
    ic=$(icon agy)
    # Same model families as the ai-launch menu: the daily `agy models` cache, else the known list
    models=$(cat "$AGY_MODELS" 2>/dev/null)
    [ -n "$models" ] || models=$'gemini-4-argon-medium\tGemini 4 Argon (Medium)\ngemini-4-argon-high\tGemini 4 Argon (High)\ngemini-4-argon-low\tGemini 4 Argon (Low)\ngemini-3.8-flash-high\tGemini 3.8 Flash (High)\ngemini-3.8-flash-medium\tGemini 3.8 Flash (Medium)\ngemini-3.8-flash-low\tGemini 3.8 Flash (Low)\nclaude-opus-5-5-low\tClaude Opus 5.5 (Low)\nclaude-opus-5-5-medium\tClaude Opus 5.5 (Medium)\nclaude-opus-5-5-high\tClaude Opus 5.5 (High)\nclaude-sonnet-5-5-low\tClaude Sonnet 5.5 (Low)\nclaude-sonnet-5-5-medium\tClaude Sonnet 5.5 (Medium)\nclaude-sonnet-5-5-high\tClaude Sonnet 5.5 (High)\ngpt-oss-120b-medium\tGPT-OSS 120B (Medium)'
    has() { grep -q "^$1"$'\t' <<<"$models"; }
    # One row per family (its -medium id); a switch keeps the current effort where the family has it
    cur_name=$current cur_fam=""
    while IFS=$'\t' read -r id name; do
      [ -n "$id" ] || continue
      case $id in *-low | *-high) continue ;; esac
      name=${name% (Medium)}
      fam=${id%-medium}
      [ "$name" = "$cur_name" ] && { current=$id; cur_fam=$fam; }
      case $id in *argon*) tier='$$$$' ;; *opus*) tier='$$$' ;; *sonnet*) tier='$$' ;; *) tier='$' ;; esac
      cmd="/model $id"
      [ -n "$effort" ] && has "$fam-$effort" && cmd="/model $fam-$effort"
      model_row "$ic" "$id" "${name:-$id}" "$tier" "$cmd"
    done <<<"$models"
    # Effort = the current family at another level, for the levels `agy models` lists for it
    if [ -n "$cur_fam" ]; then
      for e in low medium high; do has "$cur_fam-$e" && effort_row "$e" "/model $cur_fam-$e"; done
    fi
    ;;
  devin)
    ic=$(icon devin)
    model_row "$ic" opus "Claude Opus" '$$$'
    model_row "$ic" sonnet "Claude Sonnet" '$$'
    model_row "$ic" codex Codex '$$'
    model_row "$ic" fusion Fusion '$$'
    ;;
  codex)
    # Codex takes no /model argument: open its own picker (model, then reasoning effort)
    head="$(icon codex) $(pad Model 8)"
    col_name=$(pad "Codex model & effort picker" 32)
    row picker "/model" " ${head}${col_name}" "$(printf ' \033[34m%s\033[0m%s' "$head" "$col_name")"
    ;;
esac

if [ "$mode" = peek ] && [ -z "$choice" ]; then
  printf '%s\n' "${rows[@]}"
  exit 0
fi

pick=""
if [ -n "$choice" ]; then
  for r in "${rows[@]}"; do [ "${r%%$'\t'*}" = "$choice" ] && { pick=$r; break; }; done
  [ -n "$pick" ] || { say "'$choice' is not a model or effort of $agent"; exit 2; }
else
  # Menu: cursor on the current model so j/k reach its neighbours; typing jumps to the best match
  pos=0
  labels=()
  for i in "${!rows[@]}"; do
    IFS=$'\t' read -r id _ label <<<"${rows[$i]}"
    [ -n "$current" ] && [ "$id" = "$current" ] && pos=$i
    labels+=("$label")
  done
  WM_BIN="$HOME/.local/bin/wm"
  [ -x "$WM_BIN" ] || WM_BIN=$(command -v wm)
  sel=$(printf '%s\n' "${colored_rows[@]}" | "$WM_BIN" -o "$HOME/.config/waymaker/presets/ai-switch.toml" --pos "$pos") || exit 0
  sel=$(sed 's/\x1b\[[0-9;]*m//g' <<<"$sel")
  for i in "${!labels[@]}"; do [ "${labels[$i]}" = "$sel" ] && { pick=${rows[$i]}; break; }; done
  [ -n "$pick" ] || exit 0
fi

IFS=$'\t' read -r _ command _ <<<"$pick"
if [ "$mode" = peek ]; then
  printf '%s\t%s\n' "$agent" "$command"
  exit 0
fi

# Draft guard: text after the prompt marker (Claude ❯, Codex ›, others >) that is not a dim
# placeholder would be submitted together with the slash command. ai-prompt sets it aside through the
# agent's own editor hook and brings it back after the switch; without it the switch stops.
draft=""
prompt=$(grep -E $'^[[:space:]]*(\e\\[[0-9;]*m)*(❯|›|>)' <<<"$screen" | tail -1)
if [ -n "$prompt" ]; then
  # Marker, then spaces or the no-break space Claude Code puts before its placeholder
  after=$(sed -E $'s/^[[:space:]]*(\e\\[[0-9;]*m)*(❯|›|>)([[:space:]]|\xc2\xa0)*//' <<<"$prompt")
  text=$(sed 's/\x1b\[[0-9;]*m//g' <<<"$after" | tr -d '[:space:]')
  if [ -n "$text" ] && ! [[ $after =~ ^$'\e'\[(2|90|38\;5\;24[0-9])m ]]; then
    if ai-prompt -t "$pane" --ready 2>/dev/null && ai-prompt -t "$pane" take 2>/dev/null; then
      draft=kept
    else
      say "Draft in the $agent prompt: send or clear it, then switch again"
      exit 3
    fi
  fi
fi

tmux send-keys -t "$pane" -l -- "$command"
# Let the agent's input settle (slash-command autocomplete) before submitting
sleep 0.1
tmux send-keys -t "$pane" Enter
if [ "$draft" = kept ] && [ "$agent" = codex ]; then
  # Codex's /model opens a picker: the draft waits until it closes
  say "$agent → $command · draft kept, Prefix + V brings it back"
elif [ "$draft" = kept ]; then
  sleep 0.3
  ai-prompt -t "$pane" put 2>/dev/null
  say "$agent → $command · draft kept"
else
  say "$agent → $command"
fi
