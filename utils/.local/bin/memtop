#!/usr/bin/env bash
# memtop - Interactive memory analyzer and manager
# Usage: memtop [--kill] [--report] [--watch] [--top N]

set -uo pipefail

# ── Colors ─────────────────────────────────────────────────────────────────────
RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'
CYAN='\033[0;36m'; BOLD='\033[1m'; DIM='\033[2m'; RESET='\033[0m'

# ── Defaults ───────────────────────────────────────────────────────────────────
TOP_N=15
KILL_MODE=false
WATCH_MODE=false
REPORT_MODE=false
REPORT_FILE="$HOME/memory-report-$(date +%Y%m%d-%H%M%S).md"

# ── Args ───────────────────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case $1 in
    --kill|-k)     KILL_MODE=true ;;
    --report|-r)   REPORT_MODE=true ;;
    --watch|-w)    WATCH_MODE=true ;;
    --top|-t)      TOP_N="${2:-15}"; shift ;;
    --help|-h)
      echo "Usage: memtop [--kill] [--report] [--watch] [--top N]"
      echo "  --kill    Interactive mode to kill processes"
      echo "  --report  Write a markdown report to ~/memory-report-*.md"
      echo "  --watch   Refresh every 3s (press Ctrl+C to quit)"
      echo "  --top N   Show the N heaviest processes (default: 15)"
      exit 0 ;;
    *) echo "Unknown option: $1. Use --help"; exit 1 ;;
  esac
  shift
done

# ── Helper functions ───────────────────────────────────────────────────────────
bytes_to_human() {
  local kb=$1
  if   (( kb >= 1048576 )); then
    local int=$(( kb / 1048576 ))
    local dec=$(( (kb % 1048576) * 10 / 1048576 ))
    printf "%d.%d GB" "$int" "$dec"
  elif (( kb >= 1024 )); then
    local int=$(( kb / 1024 ))
    local dec=$(( (kb % 1024) * 10 / 1024 ))
    printf "%d.%d MB" "$int" "$dec"
  else
    printf "%d KB" "$kb"
  fi
}

bar() {
  local pct=$1 width=${2:-20}
  local filled=$(( pct * width / 100 ))
  local empty=$(( width - filled ))
  local color
  (( pct >= 85 )) && color=$RED || { (( pct >= 60 )) && color=$YELLOW || color=$GREEN; }
  printf "${color}%s${DIM}%s${RESET}" "$(printf '█%.0s' $(seq 1 $filled 2>/dev/null || true))" \
                                        "$(printf '░%.0s' $(seq 1 $empty  2>/dev/null || true))"
}

# Fallback for bar() without seq pipe problems
draw_bar() {
  local pct=$1 width=${2:-20}
  local filled=$(( pct * width / 100 ))
  local empty=$(( width - filled ))
  local color bar_str=""
  (( pct >= 85 )) && color=$RED || { (( pct >= 60 )) && color=$YELLOW || color=$GREEN; }
  local i
  for (( i=0; i<filled; i++ )); do bar_str+="█"; done
  for (( i=0; i<empty;  i++ )); do bar_str+="░"; done
  printf "${color}%s${RESET}" "$bar_str"
}

# ── Memory reading ─────────────────────────────────────────────────────────────
read_mem() {
  declare -gA MEM
  while IFS=: read -r key val; do
    key="${key// /}"
    val="${val//[[:space:]]kB/}"
    val="${val// /}"
    MEM[$key]=$val
  done < /proc/meminfo
}

# ── Summary header ─────────────────────────────────────────────────────────────
print_summary() {
  read_mem
  local total=${MEM[MemTotal]}
  local free=${MEM[MemFree]}
  local avail=${MEM[MemAvailable]}
  local buffers=${MEM[Buffers]}
  local cached=${MEM[Cached]}
  local swap_total=${MEM[SwapTotal]}
  local swap_free=${MEM[SwapFree]}
  local shmem=${MEM[Shmem]}

  local used=$(( total - free - buffers - cached - shmem ))
  local used_pct=$(( used * 100 / total ))
  local swap_used=$(( swap_total - swap_free ))
  local swap_pct=0
  (( swap_total > 0 )) && swap_pct=$(( swap_used * 100 / swap_total ))

  printf "\n${BOLD}${CYAN}══ MEMORY SUMMARY ══════════════════════════════════════════════${RESET}\n"
  printf "  ${BOLD}RAM Total :${RESET} %-10s  ${BOLD}Used  :${RESET} %-10s  ${BOLD}Available  :${RESET} %s\n" \
    "$(bytes_to_human $total)" "$(bytes_to_human $used)" "$(bytes_to_human $avail)"
  printf "  ${BOLD}Buffers   :${RESET} %-10s  ${BOLD}Cache :${RESET} %-10s  ${BOLD}Shared     :${RESET} %s\n" \
    "$(bytes_to_human $buffers)" "$(bytes_to_human $cached)" "$(bytes_to_human $shmem)"
  printf "\n  RAM  [%s] %d%%\n" "$(draw_bar $used_pct)" $used_pct
  printf "  SWAP [%s] %d%%  (%s / %s)\n\n" \
    "$(draw_bar $swap_pct)" $swap_pct "$(bytes_to_human $swap_used)" "$(bytes_to_human $swap_total)"

  # Alerts
  if (( swap_pct >= 95 )); then
    printf "  ${RED}${BOLD}⚠  CRITICAL SWAP (%d%%) — system may freeze when swap runs out!${RESET}\n\n" $swap_pct
  elif (( swap_pct >= 70 )); then
    printf "  ${YELLOW}${BOLD}⚠  High SWAP usage (%d%%) — expect slowdowns!${RESET}\n\n" $swap_pct
  fi
  if (( used_pct >= 90 )); then
    printf "  ${RED}${BOLD}⚠  CRITICAL RAM (%d%%) — OOM killer risk!${RESET}\n\n" $used_pct
  fi
}

# ── Process table ─────────────────────────────────────────────────────────────
print_processes() {
  local n=${1:-$TOP_N}
  printf "${BOLD}${CYAN}══ TOP %d PROCESSES BY MEMORY ═════════════════════════════════════${RESET}\n" $n
  printf "${BOLD}%-5s %-12s %-8s %8s %8s %8s   %-30s${RESET}\n" \
    "RANK" "USER" "PID" "RSS" "SWAP" "MEM%" "COMMAND"
  printf "${DIM}%s${RESET}\n" "────────────────────────────────────────────────────────────────────────────"

  local rank=0
  ps aux --sort=-%mem | awk 'NR>1' | head -"$n" | while read -r user pid cpu mem vsz rss tty stat start time cmd rest; do
    rank=$(( rank + 1 ))

    # RSS in kB
    local rss_kb=$(( rss ))
    local rss_h; rss_h=$(bytes_to_human $rss_kb)

    # Per-process swap via /proc
    local swap_kb=0
    if [[ -r /proc/$pid/status ]]; then
      swap_kb=$(awk '/VmSwap/{print $2}' /proc/$pid/status 2>/dev/null || echo 0)
      swap_kb=${swap_kb:-0}
    fi
    local swap_h; swap_h=$(bytes_to_human $swap_kb)

    # Short name
    local name="${cmd##*/}"
    name="${name:0:30}"

    # Color by usage
    local color=$RESET
    (( rss_kb > 200000 )) && color=$RED || { (( rss_kb > 80000 )) && color=$YELLOW || color=; }

    printf "${color}%-5s %-12s %-8s %8s %8s %5s%%   %-30s${RESET}\n" \
      "$rank" "${user:0:12}" "$pid" "$rss_h" "$swap_h" "$mem" "$name"
  done
}

# ── Grouping by app ───────────────────────────────────────────────────────────
print_grouped() {
  printf "\n${BOLD}${CYAN}══ MEMORY BY APPLICATION (grouped) ════════════════════════════════${RESET}\n"
  printf "${BOLD}%-22s %10s %8s %6s${RESET}\n" "APPLICATION" "RSS TOTAL" "CPU%" "PROCS"
  printf "${DIM}%s${RESET}\n" "──────────────────────────────────────────────────────"

  ps aux --sort=-%mem | awk 'NR>1 {
    cmd=$11; gsub(/.*\//,"",cmd);
    if (cmd ~ /chrome|chromium/) cmd="chrome";
    if (cmd ~ /firefox/) cmd="firefox";
    mem[cmd]+=$6; cpu[cmd]+=$3; count[cmd]++
  } END {
    for(c in mem) printf "%s\t%.0f\t%.1f\t%d\n", c, mem[c], cpu[c], count[c]
  }' | sort -t$'\t' -k2 -rn | head -12 | while IFS=$'\t' read -r name rss_kb cpu procs; do
    local rss_h; rss_h=$(bytes_to_human "$rss_kb")
    local color=$RESET
    (( rss_kb > 500000 )) && color=$RED || { (( rss_kb > 150000 )) && color=$YELLOW || color=; }
    printf "${color}%-22s %10s %7.1f%% %5d${RESET}\n" "$name" "$rss_h" "$cpu" "$procs"
  done
}

# ── Interactive kill mode ──────────────────────────────────────────────────────
interactive_kill() {
  echo ""
  printf "${YELLOW}${BOLD}══ INTERACTIVE KILL MODE ═════════════════════════════════════════${RESET}\n"
  printf "${DIM}Lists the processes. You choose which ones to kill.${RESET}\n\n"

  # Build the process arrays
  local -a pids names mems users
  while IFS= read -r line; do
    local user pid mem cmd
    read -r user pid _ mem _ _ _ _ _ _ cmd _ <<< "$line"
    pids+=("$pid")
    names+=("${cmd##*/}")
    mems+=("$mem")
    users+=("$user")
  done < <(ps aux --sort=-%mem | awk 'NR>1' | head -20)

  local i
  for (( i=0; i<${#pids[@]}; i++ )); do
    printf "  ${BOLD}[%2d]${RESET} %-8s PID:%-8s MEM:%5s%%  %s\n" \
      $(( i+1 )) "${users[$i]:0:8}" "${pids[$i]}" "${mems[$i]}" "${names[$i]:0:35}"
  done

  echo ""
  printf "${BOLD}Enter the number(s) to kill (e.g. 1 3 5), or 'q' to quit:${RESET} "
  read -r choices

  [[ "$choices" == "q" || -z "$choices" ]] && { echo "Cancelled."; return; }

  for choice in $choices; do
    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#pids[@]} )); then
      local idx=$(( choice - 1 ))
      local pid="${pids[$idx]}"
      local name="${names[$idx]}"
      local user="${users[$idx]}"

      # Safety: never kill critical system processes
      if [[ "$name" =~ ^(systemd|kernel|kthreadd|init|journald|sshd)$ ]]; then
        printf "  ${RED}✗ Refused: '%s' is a critical system process.${RESET}\n" "$name"
        continue
      fi

      printf "  Killing PID %s (%s) owned by %s... " "$pid" "$name" "$user"
      if kill -TERM "$pid" 2>/dev/null; then
        sleep 1
        if kill -0 "$pid" 2>/dev/null; then
          kill -KILL "$pid" 2>/dev/null && printf "${RED}[forced KILL]${RESET}\n" || printf "${YELLOW}[survived]${RESET}\n"
        else
          printf "${GREEN}[killed]${RESET}\n"
        fi
      else
        printf "${RED}[permission denied — try sudo]${RESET}\n"
      fi
    else
      printf "  ${YELLOW}Invalid number: %s${RESET}\n" "$choice"
    fi
  done
}

# ── Markdown report generation ───────────────────────────────────────────────
generate_report() {
  local file="${1:-$REPORT_FILE}"
  read_mem

  local total=${MEM[MemTotal]}
  local free=${MEM[MemFree]}
  local avail=${MEM[MemAvailable]}
  local cached=${MEM[Cached]}
  local buffers=${MEM[Buffers]}
  local shmem=${MEM[Shmem]}
  local swap_total=${MEM[SwapTotal]}
  local swap_free=${MEM[SwapFree]}
  local used=$(( total - free - buffers - cached - shmem ))
  local swap_used=$(( swap_total - swap_free ))
  local swap_pct=0
  (( swap_total > 0 )) && swap_pct=$(( swap_used * 100 / swap_total ))
  local used_pct=$(( used * 100 / total ))
  local date_now; date_now=$(date '+%Y-%m-%d %H:%M:%S')
  local uptime_str; uptime_str=$(uptime -p)
  local load; load=$(uptime | grep -oP 'load average: \K.*')
  local cpu_model; cpu_model=$(grep -m1 "model name" /proc/cpuinfo | cut -d: -f2 | xargs)
  local cpu_count; cpu_count=$(nproc)
  local hostname_str; hostname_str=$(hostname)

  # Pre-calculate human-readable strings (bytes_to_human not available in heredoc subshells)
  local h_total;     h_total=$(bytes_to_human "$total")
  local h_swap_tot;  h_swap_tot=$(bytes_to_human "$swap_total")
  local h_used;      h_used=$(bytes_to_human "$used")
  local h_avail;     h_avail=$(bytes_to_human "$avail")
  local h_cached;    h_cached=$(bytes_to_human "$cached")
  local h_buffers;   h_buffers=$(bytes_to_human "$buffers")
  local h_shmem;     h_shmem=$(bytes_to_human "$shmem")
  local h_swap_used; h_swap_used=$(bytes_to_human "$swap_used")
  local h_swap_free; h_swap_free=$(bytes_to_human "$swap_free")
  local avail_pct=$(( avail * 100 / total ))
  local cached_pct=$(( cached * 100 / total ))

  cat > "$file" <<MARKDOWN
# Memory Analysis Report

**Generated at:** $date_now  
**Host:** $hostname_str  
**Uptime:** $uptime_str  
**Load Average:** $load

---

## Hardware

| Item | Value |
|------|-------|
| CPU | $cpu_model |
| Cores | $cpu_count |
| RAM Total | $h_total |
| SWAP Total | $h_swap_tot |

---

## Current Memory State

| Metric | Value | % of Total |
|---------|-------|-----------|
| RAM Used (real) | $h_used | ${used_pct}% |
| RAM Available | $h_avail | ${avail_pct}% |
| Disk cache | $h_cached | ${cached_pct}% |
| Buffers | $h_buffers | — |
| Shared (tmpfs) | $h_shmem | — |
| SWAP Used | $h_swap_used | ${swap_pct}% of swap |
| SWAP Free | $h_swap_free | — |

MARKDOWN

  # Alert level
  if (( swap_pct >= 95 )); then
    cat >> "$file" <<MARKDOWN
> [!CAUTION]
> **CRITICAL SWAP (${swap_pct}%):** Swap is nearly exhausted. The system is
> using disk as RAM, causing severe slowdowns and a risk of freezing (OOM kill).

MARKDOWN
  elif (( swap_pct >= 70 )); then
    cat >> "$file" <<MARKDOWN
> [!WARNING]
> **High swap (${swap_pct}%):** Part of memory has been moved to disk.
> This indicates RAM pressure and may cause noticeable slowdowns.

MARKDOWN
  fi

  cat >> "$file" <<MARKDOWN

---

## Top $TOP_N Processes by RAM Usage

| # | PID | User | RSS | SWAP | MEM% | Process |
|---|-----|------|-----|------|------|---------|
MARKDOWN

  local rank=0
  ps aux --sort=-%mem | awk 'NR>1' | head -"$TOP_N" | while read -r user pid cpu mem vsz rss tty stat start time cmd rest; do
    rank=$(( rank + 1 ))
    local swap_kb=0
    [[ -r /proc/$pid/status ]] && swap_kb=$(awk '/VmSwap/{print $2}' /proc/$pid/status 2>/dev/null || echo 0)
    swap_kb=${swap_kb:-0}
    local name="${cmd##*/}"
    printf "| %d | %s | %s | %s | %s | %s%% | \`%s\` |\n" \
      "$rank" "$pid" "${user:0:12}" "$(bytes_to_human $rss)" "$(bytes_to_human $swap_kb)" "$mem" "${name:0:40}"
  done >> "$file"

  cat >> "$file" <<MARKDOWN

---

## Memory by Application (Grouped)

| Application | RSS Total | CPU% | Processes |
|-------------|-----------|------|-----------|
MARKDOWN

  ps aux --sort=-%mem | awk 'NR>1 {
    cmd=$11; gsub(/.*\//,"",cmd);
    if (cmd ~ /chrome|chromium/) cmd="chrome";
    if (cmd ~ /firefox/) cmd="firefox";
    mem[cmd]+=$6; cpu[cmd]+=$3; count[cmd]++
  } END {
    for(c in mem) printf "%s\t%.0f\t%.1f\t%d\n", c, mem[c], cpu[c], count[c]
  }' | sort -t$'\t' -k2 -rn | head -15 | while IFS=$'\t' read -r name rss_kb cpu procs; do
    printf "| \`%s\` | %s | %.1f%% | %d |\n" "$name" "$(bytes_to_human $rss_kb)" "$cpu" "$procs"
  done >> "$file"

  cat >> "$file" <<MARKDOWN

---

## Diagnosis and Identified Causes

MARKDOWN

  # Chrome
  local chrome_count; chrome_count=$(ps aux | grep -c "[c]hrome")
  local chrome_rss; chrome_rss=$(ps aux | awk '/chrome/{sum+=$6} END{printf "%.0f", sum}')
  if (( chrome_rss > 300000 )); then
    local chrome_rss_h; chrome_rss_h=$(bytes_to_human "$chrome_rss")
    {
      printf '### Google Chrome — High multi-process usage\n\n'
      printf 'Chrome uses a **process-per-tab/extension architecture**. Found\n'
      printf '**%s Chrome processes** using **%s** in total.\n\n' "$chrome_count" "$chrome_rss_h"
      cat <<'EOF'
**Why it happens:**
- Every tab, extension and service (network, GPU, storage) runs in its own process
- Tabs left open for days accumulate memory through gradual leaks
- Renderers keep JS/DOM caches even in inactive tabs

**Mitigation:**
- Enable "Memory Saver" in `chrome://settings/performance`
- Close unused tabs or use an extension like "The Great Suspender"
- Limit active extensions

EOF
    } >> "$file"
  fi

  # Saturated swap
  if (( swap_pct >= 70 )); then
    local swap_used_h; swap_used_h=$(bytes_to_human "$swap_used")
    local swap_total_h; swap_total_h=$(bytes_to_human "$swap_total")
    local total_h; total_h=$(bytes_to_human "$total")
    {
      printf '### Saturated Swap — System Under Memory Pressure\n\n'
      printf 'Swap (zram on this system) is at **%d%%** usage (**%s** of **%s**).\n\n' \
        "$swap_pct" "$swap_used_h" "$swap_total_h"
      printf '**Why it happens:**\n'
      printf '%s\n' "- Physical RAM ($total_h) is insufficient for the current load"
      cat <<'EOF'
- Processes left in the background for days were paged out to swap
- zram compresses data in RAM, but its compression ratio is limited (~2-3x)
- Once swap is exhausted, the kernel triggers the **OOM Killer**, killing processes

**Mitigation:**
- Rebooting frees swap completely
- `sudo swapoff -a && sudo swapon -a` recycles swap (frees idle pages)
- Adding physical RAM is the definitive fix for this setup

EOF
    } >> "$file"
  fi

  # Long uptime
  local days; days=$(uptime | grep -oP '\d+(?= day)')
  if [[ -n "$days" ]] && (( days >= 2 )); then
    {
      printf '### High Uptime — %s days without a reboot\n\n' "$days"
      cat <<'EOF'
Systems with long uptime accumulate:
- Heap fragmentation in long-lived processes
- Gradual memory leaks (especially in browsers and Electron apps)
- Gradually growing swap usage from rarely accessed pages

**Mitigation:** Rebooting periodically (every 3-7 days) is a valid practice on
machines with limited RAM.

EOF
    } >> "$file"
  fi

  cat >> "$file" <<'EOF'
### `makima.service` in a Crash Loop

The `makima` service keeps failing (exit code 101),
restarting dozens of times per hour. Although each instance uses little
memory (~7 MB), the crash loop causes:
- Noise in the system journal
- A CPU spike on every restart
- A sign of misconfiguration or a missing dependency

**Check:** `systemctl status makima.service` and `journalctl -u makima -n 50`

EOF

  {
    printf '%s\n' '' '---' '' '## Priority Recommendations' ''
    printf '1. **Close or suspend Chrome tabs** — frees hundreds of MB immediately\n'
    printf '2. **Recycle swap:** `sudo swapoff -a && sudo swapon -a`\n'
    printf '3. **Reboot the system** — the only way to clear swap + accumulated leaks (%s days)\n' "$days"
    cat <<'EOF'
4. **Fix makima.service** — `journalctl -u makima -n 50` to see the actual error
5. **Consider a RAM upgrade** — 3.6 GB is the lower bound for Chrome + a heavy DE

---

## Useful Commands

```bash
# Watch processes in real time
memtop --watch

# Kill processes interactively
memtop --kill

# Recycle swap
sudo swapoff -a && sudo swapon -a

# Show the makima log
journalctl -u makima -n 50 --no-pager

# Chrome with less memory
google-chrome-stable --js-flags="--max-old-space-size=512"
```

EOF
    printf '\n%s\n%s\n' '---' "*Report generated by \`memtop\` — $(date '+%Y-%m-%d %H:%M:%S')*"
  } >> "$file"

  printf "\n${GREEN}${BOLD}Report saved to: %s${RESET}\n" "$file"
}

# ── Main ───────────────────────────────────────────────────────────────────────
run_once() {
  clear 2>/dev/null || true
  print_summary
  print_processes "$TOP_N"
  print_grouped
  echo ""
}

if $WATCH_MODE; then
  while true; do
    run_once
    printf "${DIM}Refreshing in 3s… Ctrl+C to quit${RESET}\n"
    sleep 3
  done
elif $KILL_MODE; then
  run_once
  interactive_kill
elif $REPORT_MODE; then
  generate_report "$REPORT_FILE"
  run_once
else
  run_once
  printf "${DIM}Tip: use --kill to kill processes, --watch to monitor, --report to write a report${RESET}\n\n"
fi
