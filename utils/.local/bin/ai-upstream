#!/usr/bin/env python3
"""ai-upstream: what changed upstream of the AI workflow, and what is new on GitHub.

  ai-upstream [watch] [--since 14d|YYYY-MM-DD] [--only a,b] [--kind K] [--for waymux|waymaker|lazygitrs]
                      [--json] [--ack] [--no-fetch]
  ai-upstream scout   [--days N] [--min-stars N] [--limit N] [--all] [--no-trending] [--json] [--ack]
  ai-upstream scout   --dismiss owner/repo [--reason TEXT] | --track owner/repo [--area TEXT]
  ai-scout ...        same as `ai-upstream scout`

watch  reads utils/.config/ai-upstream/sources.toml and reports, per source:
       dependency  releases newer than the installed version, with the note lines
                   that match the manifest keywords
       fork        upstream commits not in the fork branch, each with a cherry-pick
                   dry run (git merge-tree, nothing touched) and overlap with the
                   files the fork changed
       reference   releases and feat/fix/perf commits since the last --ack
       Each source gets an adoption mode from its live license.
scout  searches GitHub for new repositories (manifest queries + trending pages),
       drops the ones in the manifest, dismissed or already seen, and ranks the
       rest by relevance to this workflow and stars per day.

Gathering only: no tokens, no edits outside $XDG_STATE_HOME/ai-upstream (and the
manifest for --track). The triage is the agent's job: see the ai-upstream-watch
and ai-scout skills, and docs/architecture/upstream-watch-and-scout.md.
Needs: gh (authenticated), git, Python >= 3.11.
"""
from __future__ import annotations

import argparse
import datetime as dt
import html
import json
import math
import os
import re
import subprocess
import sys
import time
import tomllib
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

HOME = Path.home()
SOURCES = Path(os.environ.get("AI_UPSTREAM_SOURCES", HOME / ".config/ai-upstream/sources.toml"))
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "ai-upstream/state.json"
NOW = dt.datetime.now(dt.timezone.utc)

PERMISSIVE = {"MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "ISC", "0BSD", "Unlicense", "Zlib", "MPL-2.0"}
COPYLEFT = {"GPL-2.0", "GPL-3.0", "AGPL-3.0", "LGPL-2.1", "LGPL-3.0", "GPL-2.0-only", "GPL-3.0-only", "AGPL-3.0-only"}
SKIP_COMMIT = re.compile(r"^(chore|test|tests|docs|build|ci|style|refactor|release|bump|merge)\b[(!:]?", re.I)
KIND_COMMIT = re.compile(r"^(feat|fix|perf|security|sec)\b", re.I)


# ── helpers ─────────────────────────────────────────────────────────────────────

def gh(path: str):
    """GET a GitHub API path through gh; None on any failure."""
    try:
        out = subprocess.run(["gh", "api", "-X", "GET", path], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if out.returncode != 0:
        return None
    try:
        return json.loads(out.stdout)
    except json.JSONDecodeError:
        return None


def sh(args: list[str], cwd: str | None = None, timeout: int = 60) -> subprocess.CompletedProcess:
    return subprocess.run(args, cwd=cwd, capture_output=True, text=True, timeout=timeout)


def vtuple(s: str | None) -> tuple:
    return tuple(int(x) for x in re.findall(r"\d+", s or "")[:4])


def parse_since(value: str | None, default_days: int) -> dt.datetime:
    if not value:
        return NOW - dt.timedelta(days=default_days)
    m = re.fullmatch(r"(\d+)d", value)
    if m:
        return NOW - dt.timedelta(days=int(m.group(1)))
    return dt.datetime.fromisoformat(value).replace(tzinfo=dt.timezone.utc)


def iso(d: dt.datetime) -> str:
    return d.strftime("%Y-%m-%dT%H:%M:%SZ")


def when(s: str) -> dt.datetime:
    return dt.datetime.fromisoformat(s.replace("Z", "+00:00"))


def load_state() -> dict:
    try:
        return json.loads(STATE.read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def save_state(state: dict) -> None:
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, indent=2, sort_keys=True))
    tmp.replace(STATE)


def load_manifest() -> dict:
    try:
        return tomllib.loads(SOURCES.read_text())
    except OSError:
        sys.exit(f"ai-upstream: no manifest at {SOURCES}")


def adoption(kind: str, license_id: str | None) -> str:
    if kind == "dependency":
        return "upgrade (ai-update), then adopt new options in config"
    if kind == "fork":
        return "cherry-pick into the fork branch (in an awt worktree)"
    if license_id in PERMISSIVE:
        return f"port allowed ({license_id}): keep the notice when copying code"
    if license_id in COPYLEFT:
        return f"reimplement from behavior ({license_id}): do not copy code"
    return "idea only (no license): reimplement from the docs, copy nothing"


def hit(text: str, keywords: list[str]) -> bool:
    """True when a keyword starts a word in text ("api" matches "API", not "rapid")."""
    low = text.lower()
    return any(re.search(r"(?<![a-z0-9])" + re.escape(k), low) for k in keywords)


def keyword_lines(body: str, keywords: list[str], cap: int = 8) -> tuple[list[str], int]:
    # Rejoin hard-wrapped notes: a new item starts at a bullet, a heading or after a blank line.
    items: list[str] = []
    fresh = True
    for raw in (body or "").splitlines():
        line = raw.strip()
        if not line:
            fresh = True
            continue
        starts = re.match(r"([-*•]|\d+[.)])\s", line) or line.startswith(("#", "<", "|", "```"))
        if starts or fresh or not items:
            items.append(line)
        else:
            items[-1] += " " + line
        fresh = False
    lines = []
    total = 0
    for item in items:
        if item.startswith(("#", "<", "|", "```")):
            continue
        text = re.sub(r"^([-*•]|\d+[.)])\s+", "", item).replace("**", "").strip()
        if text.lower().startswith(("full diff", "full changelog", "**full changelog")):
            continue
        total += 1
        if hit(text, keywords):
            lines.append(text[:220])
    return lines[:cap], total


# ── watch ───────────────────────────────────────────────────────────────────────

def feeds(src: dict) -> list[str]:
    f = src.get("feeds", "workflow")
    return [f] if isinstance(f, str) else list(f)


def notes_page(src: dict, tag: str, kw: list[str]) -> list[str]:
    """Headings of a release-notes page (`notes_url` with {major} {minor} {patch} {tag})."""
    url = src.get("notes_url")
    if not url:
        return []
    v = list(vtuple(tag)) + [0, 0, 0]
    url = url.format(major=v[0], minor=v[1], patch=v[2], tag=tag)
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "ai-upstream"})
        page = urllib.request.urlopen(req, timeout=15).read().decode("utf-8", "replace")
    except OSError:
        return []
    heads = [html.unescape(re.sub(r"<[^>]+>", "", t)).strip()
             for t in re.findall(r"<h3[^>]*>(.*?)</h3>", page, re.S)]
    return [h for h in heads if h and hit(h, kw)][:12]


def installed_version(cmd: str | None) -> str | None:
    if not cmd:
        return None
    try:
        out = subprocess.run(["zsh", "-c", cmd], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    m = re.search(r"\d+(?:\.\d+)+", out.stdout + out.stderr)
    return m.group(0) if m else None


def releases(repo: str, prefix: str | None) -> list[dict]:
    data = gh(f"repos/{repo}/releases?per_page=60") or []
    keep = []
    for r in data:
        if r.get("draft") or r.get("prerelease"):
            continue
        tag = r.get("tag_name", "")
        if prefix and not tag.startswith(prefix):
            continue
        if not vtuple(tag):
            continue  # "nightly" and other moving tags
        keep.append(r)
    return keep


def locked_version(src: dict) -> str | None:
    """Version of `crate` pinned in `cargo_lock` (libraries our binaries build with)."""
    lock, crate = src.get("cargo_lock"), src.get("crate")
    if not lock or not crate:
        return None
    try:
        data = tomllib.loads(Path(os.path.expanduser(lock)).read_text())
    except (OSError, tomllib.TOMLDecodeError):
        return None
    versions = [p["version"] for p in data.get("package", []) if p.get("name") == crate]
    return max(versions, key=vtuple) if versions else None


def watch_dependency(src: dict, since: dt.datetime, kw: list[str]) -> dict:
    inst = installed_version(src.get("version_cmd")) or locked_version(src)
    rel = releases(src["repo"], src.get("tag_prefix"))
    newer = []
    for r in rel:
        tag = r["tag_name"].removeprefix(src.get("tag_prefix") or "")
        is_new = vtuple(tag) > vtuple(inst) if inst else when(r["published_at"]) > since
        if is_new:
            hits, total = keyword_lines(r.get("body", ""), kw)
            hits = hits or notes_page(src, r["tag_name"], kw)
            newer.append({"tag": r["tag_name"], "date": r["published_at"][:10], "url": r["html_url"],
                          "lines": total, "highlights": hits})
    latest = rel[0]["tag_name"] if rel else None
    return {"installed": inst, "latest": latest, "releases": newer}


def watch_reference(src: dict, since: dt.datetime, kw: list[str]) -> dict:
    out = {"releases": [], "commits": []}
    for r in releases(src["repo"], src.get("tag_prefix")):
        if when(r["published_at"]) <= since:
            continue
        hits, total = keyword_lines(r.get("body", ""), kw)
        hits = hits or notes_page(src, r["tag_name"], kw)
        out["releases"].append({"tag": r["tag_name"], "date": r["published_at"][:10], "url": r["html_url"],
                                "lines": total, "highlights": hits})
    data = gh(f"repos/{src['repo']}/commits?since={iso(since)}&per_page=100") or [] if src.get("commits", True) else []
    for c in data:
        subj = c["commit"]["message"].split("\n", 1)[0].strip()
        if SKIP_COMMIT.match(subj):
            continue
        out["commits"].append({
            "sha": c["sha"][:9], "date": c["commit"]["author"]["date"][:10], "subject": subj[:160],
            "kind": (KIND_COMMIT.match(subj).group(1).lower() if KIND_COMMIT.match(subj) else "other"),
            "keyword": hit(subj, kw),
        })
    out["commits"].sort(key=lambda c: (not c["keyword"], c["kind"] == "other"))
    return out


def watch_fork(src: dict, fetch: bool, kw: list[str]) -> dict:
    path = os.path.expanduser(src["path"])
    branch, upb = src["branch"], src.get("upstream_branch", "main")
    if not os.path.isdir(path):
        return {"error": f"no checkout at {path}"}
    has_remote = "upstream" in sh(["git", "remote"], cwd=path).stdout.split()
    if has_remote:
        ub = f"upstream/{upb}"
        if fetch:
            sh(["git", "fetch", "--quiet", "upstream"], cwd=path, timeout=120)
    elif src.get("upstream_url"):
        # Fetch into a private ref instead of adding a remote to the repository.
        ub = f"refs/ai-upstream/{upb}"
        if fetch or sh(["git", "rev-parse", "--verify", "--quiet", ub], cwd=path).returncode != 0:
            sh(["git", "fetch", "--quiet", "--no-tags", src["upstream_url"], f"+{upb}:{ub}"], cwd=path, timeout=180)
    else:
        return {"error": "no `upstream` remote and no upstream_url"}
    log = sh(["git", "log", "--cherry-pick", "--right-only", "--no-merges", "--reverse",
              "--format=%H%x09%as%x09%s", f"{branch}...{ub}"], cwd=path)
    if log.returncode != 0:
        return {"error": log.stderr.strip()[:200]}
    base = sh(["git", "merge-base", branch, ub], cwd=path).stdout.strip()
    fork_files = set(sh(["git", "diff", "--name-only", f"{base}..{branch}"], cwd=path).stdout.split())
    behind = int(sh(["git", "rev-list", "--count", f"{branch}..{ub}"], cwd=path).stdout.strip() or 0)
    # A rebased or conflict-resolved copy has another patch id but usually the same subject.
    def norm(subject: str) -> str:
        return re.sub(r"\s*\(#\d+\)$", "", subject).strip().lower()  # upstream squash adds " (#NN)"
    fork_subjects = {norm(x) for x in sh(["git", "log", "--format=%s", f"{base}..{branch}"], cwd=path).stdout.splitlines()}
    picks = []
    for line in log.stdout.splitlines()[:60]:
        sha, date, subj = line.split("\t", 2)
        files = sh(["git", "show", "--name-only", "--format=", sha], cwd=path).stdout.split()
        dry = sh(["git", "merge-tree", "--write-tree", f"--merge-base={sha}^", branch, sha], cwd=path)
        if norm(subj) in fork_subjects:
            picks.append({"sha": sha[:9], "date": date, "subject": subj[:160], "equivalent": True,
                          "clean": None, "overlap": [], "keyword": False})
            continue
        picks.append({"sha": sha[:9], "date": date, "subject": subj[:160], "equivalent": False,
                      "clean": dry.returncode == 0, "overlap": sorted(set(files) & fork_files)[:6],
                      "keyword": hit(subj, kw)})
    return {"branch": branch, "upstream": ub, "behind": behind, "fork_files": len(fork_files), "picks": picks}


def cmd_watch(args, manifest: dict, state: dict) -> int:
    kw = [k.lower() for k in manifest.get("keywords", [])]
    sources = [s for s in manifest.get("source", []) if s.get("kind") != "own"]
    if args.only:
        names = set(args.only.split(","))
        sources = [s for s in sources if s["name"] in names]
    if args.kind:
        sources = [s for s in sources if s["kind"] == args.kind]
    if args.for_:
        sources = [s for s in sources if args.for_ in feeds(s)]
    wstate = state.setdefault("watch", {})

    def run(src):
        kw_src = kw + [k.lower() for k in src.get("keywords", [])]
        acked = wstate.get(src["name"], {}).get("acked")
        since = parse_since(args.since, 14) if (args.since or not acked) else when(acked)
        info = gh(f"repos/{src['repo']}") or {}
        lic = (info.get("license") or {}).get("spdx_id")
        if lic in (None, "NOASSERTION"):
            lic = src.get("license")
        lic = None if lic == "NOASSERTION" else lic
        res = {"name": src["name"], "repo": src["repo"], "kind": src["kind"], "area": src.get("area", ""),
               "license": lic, "adoption": adoption(src["kind"], lic), "since": iso(since)[:10]}
        res["feeds"] = feeds(src)
        if src["kind"] == "dependency":
            res.update(watch_dependency(src, since, kw_src))
        elif src["kind"] == "fork":
            res.update(watch_fork(src, not args.no_fetch, kw_src))
        else:
            res.update(watch_reference(src, since, kw_src))
        return res

    with ThreadPoolExecutor(max_workers=8) as pool:
        results = list(pool.map(run, sources))

    if args.json:
        print(json.dumps({"generated": iso(NOW), "sources": results}, indent=2))
    else:
        print_watch(results)
    if args.ack:
        for r in results:
            wstate.setdefault(r["name"], {})["acked"] = iso(NOW)
        save_state(state)
        print(f"\nacknowledged {len(results)} sources at {iso(NOW)}", file=sys.stderr)
    return 0


def print_watch(results: list[dict]) -> None:
    print(f"# Upstream watch · {NOW:%Y-%m-%d}\n")
    titles = {"dependency": "dependencies", "fork": "fork upstream (cherry-pick)", "reference": "references"}
    order = ["waymux", "waymaker", "lazygitrs", "workflow"]
    projects = order + sorted({r["feeds"][0] for r in results} - set(order))
    for proj in projects:
        for kind in ("fork", "dependency", "reference"):
            group = [r for r in results if r["kind"] == kind and r["feeds"][0] == proj]
            if group:
                print(f"## {proj} · {titles[kind]}\n")
                print_group(kind, group)


def print_group(kind: str, group: list[dict]) -> None:
    for r in group:
        head = f"### {r['name']} · `{r['repo']}` · {r['license'] or 'no license'}"
        if kind == "dependency":
            n = len(r.get("releases", []))
            state = f"installed {r.get('installed') or '?'} · latest {r.get('latest') or '?'}"
            print(f"{head}\n{state} · **{'current' if not n else f'{n} newer release(s)'}** · {r['area']}\n")
            for rel in r.get("releases", [])[:8]:
                print(f"- **{rel['tag']}** ({rel['date']}, {rel['lines']} lines) {rel['url']}")
                for h in rel["highlights"]:
                    print(f"  - {h}")
            if n > 8:
                print(f"- … {n - 8} older newer releases")
        elif kind == "fork":
            if "error" in r:
                print(f"{head}\nerror: {r['error']}\n")
                continue
            equiv = [p for p in r["picks"] if p.get("equivalent")]
            picks = [p for p in r["picks"] if not p.get("equivalent")]
            clean = sum(bool(p["clean"]) for p in picks)
            print(f"{head}\n`{r['branch']}` is {r['behind']} commit(s) behind `{r['upstream']}`; "
                  f"{len(equiv)} already in the fork under the same subject, {len(picks)} to decide, "
                  f"{clean} pick cleanly · {r['adoption']}\n")
            for p in picks:
                mark = "clean" if p["clean"] else "CONFLICT"
                ov = f" · touches fork files: {', '.join(p['overlap'])}" if p["overlap"] else ""
                star = "★ " if p["keyword"] else ""
                print(f"- `{p['sha']}` {p['date']} [{mark}] {star}{p['subject']}{ov}")
        else:
            rels, commits = r.get("releases", []), r.get("commits", [])
            print(f"{head}\nsince {r['since']} · {len(rels)} release(s), {len(commits)} feat/fix/other "
                  f"commit(s) · {r['adoption']} · {r['area']}\n")
            for rel in rels[:6]:
                print(f"- **{rel['tag']}** ({rel['date']}) {rel['url']}")
                for h in rel["highlights"]:
                    print(f"  - {h}")
            for c in commits[:15]:
                star = "★ " if c["keyword"] else ""
                print(f"- `{c['sha']}` {c['date']} {star}{c['subject']}")
            if len(commits) > 15:
                print(f"- … {len(commits) - 15} more")
        print()


# ── scout ───────────────────────────────────────────────────────────────────────

def trending(lang: str) -> list[tuple[str, str]]:
    url = f"https://github.com/trending/{lang}?since=weekly" if lang else "https://github.com/trending?since=weekly"
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "ai-upstream"})
        page = urllib.request.urlopen(req, timeout=15).read().decode("utf-8", "replace")
    except OSError:
        return []
    out = []
    for block in page.split('<article class="Box-row">')[1:]:
        m = re.search(r'<h2[^>]*>\s*<a[^>]*href="/([^"/]+/[^"/]+)"', block)
        d = re.search(r'<p class="col-9[^"]*">(.*?)</p>', block, re.S)
        if m:
            out.append((m.group(1), html.unescape(re.sub(r"\s+", " ", d.group(1)).strip()) if d else ""))
    return out


def relevance(text: str, words: list[str], penalty: list[str]) -> tuple[list[str], list[str]]:
    low = text.lower()
    return sorted({w for w in words if w in low}), sorted({w for w in penalty if w in low})


def cmd_scout(args, manifest: dict, state: dict) -> int:
    cfg = manifest.get("scout", {})
    sstate = state.setdefault("scout", {})
    seen, dismissed = sstate.setdefault("seen", {}), sstate.setdefault("dismissed", {})

    if args.dismiss:
        dismissed[args.dismiss] = {"at": iso(NOW), "reason": args.reason or ""}
        save_state(state)
        print(f"dismissed {args.dismiss}")
        return 0
    if args.track:
        info = gh(f"repos/{args.track}") or {}
        if not info:
            sys.exit(f"ai-upstream: {args.track} not found")
        name = info["name"].lower()
        block = (f'\n[[source]]\nname = "{name}"\nrepo = "{info["full_name"]}"\nkind = "reference"\n'
                 f'area = "{(args.area or info.get("description") or "")[:80].replace(chr(34), "")}"\n')
        text = SOURCES.read_text()
        marker = "# ── Own repositories"
        SOURCES.write_text(text.replace(marker, block.lstrip("\n") + "\n" + marker, 1) if marker in text else text + block)
        print(f"tracking {info['full_name']} as a reference in {SOURCES}")
        return 0

    days = args.days or cfg.get("days", 45)
    min_stars = args.min_stars if args.min_stars is not None else cfg.get("min_stars", 40)
    limit = args.limit or cfg.get("limit", 25)
    words = [w.lower() for w in cfg.get("relevance", [])]
    penalty = [w.lower() for w in cfg.get("penalty", [])]
    created = (NOW - dt.timedelta(days=days)).strftime("%Y-%m-%d")
    known = {s["repo"].lower() for s in manifest.get("source", [])}

    found: dict[str, dict] = {}

    def search(q):
        if "created:" not in q:
            q += f" created:>{created}"
        if "stars:" not in q:
            q += f" stars:>={min_stars}"
        data = gh("search/repositories?" + urllib.parse.urlencode({"q": q, "sort": "stars", "per_page": 30}))
        return q, None if data is None else data.get("items", [])

    queries = cfg.get("queries", [])
    limits = gh("rate_limit") or {}
    left = ((limits.get("resources") or {}).get("search") or {}).get("remaining", len(queries))
    if left < len(queries):
        reset = ((limits.get("resources") or {}).get("search") or {}).get("reset", 0)
        wait = max(0, int(reset - NOW.timestamp())) + 1
        print(f"ai-upstream: GitHub search allows 30 queries a minute; waiting {wait}s for the quota",
              file=sys.stderr)
        time.sleep(min(wait, 65))
    failed = 0
    with ThreadPoolExecutor(max_workers=4) as pool:
        for q, items in pool.map(search, queries):
            if items is None:
                failed += 1
                continue
            for it in items:
                found.setdefault(it["full_name"], {**it, "via": set()})["via"].add("search")

    if not args.no_trending:
        trend: list[tuple[str, str, str]] = []
        for lang in cfg.get("trending", [""]):
            trend += [(r, d, lang or "all") for r, d in trending(lang)]
        cand = [(r, l) for r, d, l in trend
                if r not in found and relevance(r + " " + d, words, penalty)[0]]
        with ThreadPoolExecutor(max_workers=6) as pool:
            for (r, l), info in zip(cand, pool.map(lambda c: gh(f"repos/{c[0]}"), cand)):
                if info:
                    found.setdefault(info["full_name"], {**info, "via": set()})["via"].add(f"trending:{l}")

    if failed:
        print(f"ai-upstream: {failed} of {len(queries)} searches failed (rate limit or network); "
              "results are incomplete, run again in a minute", file=sys.stderr)

    rows = []
    for full, it in found.items():
        key = full.lower()
        if key in known or full in dismissed or (full in seen and not args.all):
            continue
        if it.get("archived") or it.get("fork"):
            continue
        text = " ".join([it["name"], it.get("description") or "", " ".join(it.get("topics") or [])])
        hits, pens = relevance(text, words, penalty)
        is_new = "search" in it["via"]
        if not hits or (not is_new and len(hits) < 2):
            continue
        age = max(1.0, (NOW - when(it["created_at"])).total_seconds() / 86400)
        stars = it.get("stargazers_count", 0)
        vel = stars / age
        score = (len(hits) - 2 * len(pens)) * math.log1p(vel) + 0.5 * math.log1p(stars)
        rows.append({
            "repo": full, "url": it["html_url"], "stars": stars, "per_day": round(vel, 1), "age_days": int(age),
            "pushed": it.get("pushed_at", "")[:10], "language": it.get("language"),
            "license": (it.get("license") or {}).get("spdx_id"), "description": (it.get("description") or "")[:140],
            "matched": hits, "penalties": pens, "via": sorted(it["via"]), "score": round(score, 2),
            "new": full not in seen, "section": "new" if is_new else "trending",
        })
    rows.sort(key=lambda r: r["score"], reverse=True)
    fresh = [r for r in rows if r["section"] == "new"][:limit]
    trend = sorted((r for r in rows if r["section"] == "trending"),
                   key=lambda r: (len(r["matched"]) - 2 * len(r["penalties"]), r["per_day"]), reverse=True)[:max(5, limit // 2)]
    rows = fresh + trend

    if args.json:
        print(json.dumps({"generated": iso(NOW), "created_after": created, "min_stars": min_stars, "repos": rows}, indent=2))
    else:
        print(f"# Scout · {NOW:%Y-%m-%d} · {len(found)} found\n")
        for title, group in ((f"New repositories (created after {created}, ≥{min_stars}★)", fresh),
                             ("Trending this week (relevant, any age)", trend)):
            print(f"## {title}\n")
            if not group:
                print("Nothing new.\n")
                continue
            print("| # | Repository | ★ | ★/day | Age | Lang | License | Matched | Via | Description |")
            print("| ---: | :--- | ---: | ---: | ---: | :--- | :--- | :--- | :--- | :--- |")
            for i, r in enumerate(group, 1):
                pen = f" (−{', '.join(r['penalties'])})" if r["penalties"] else ""
                desc = r["description"].replace("|", "/")
                print(f"| {i} | [{r['repo']}]({r['url']}){'' if r['new'] else ' ·seen'} | {r['stars']} | {r['per_day']} | "
                      f"{r['age_days']}d | {r['language'] or '—'} | {r['license'] or '—'} | {', '.join(r['matched'])}{pen} | "
                      f"{', '.join(r['via'])} | {desc} |")
            print()
    if args.ack:
        for r in rows:
            seen[r["repo"]] = iso(NOW)
        save_state(state)
        print(f"\nmarked {len(rows)} repositories as seen", file=sys.stderr)
    return 0


# ── main ────────────────────────────────────────────────────────────────────────

def main() -> int:
    argv = sys.argv[1:]
    mode = "scout" if Path(sys.argv[0]).name == "ai-scout" else "watch"
    if argv and argv[0] in ("watch", "scout"):
        mode, argv = argv[0], argv[1:]
    p = argparse.ArgumentParser(prog=f"ai-upstream {mode}", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--json", action="store_true", help="machine-readable output")
    p.add_argument("--ack", action="store_true", help="remember this run (watch: per-source date; scout: seen repos)")
    if mode == "watch":
        p.add_argument("--since", help="14d or YYYY-MM-DD (default: last --ack, else 14 days)")
        p.add_argument("--only", help="comma-separated source names")
        p.add_argument("--kind", choices=["dependency", "fork", "reference"])
        p.add_argument("--no-fetch", action="store_true", help="forks: do not git fetch upstream")
        p.add_argument("--for", dest="for_", metavar="PROJECT",
                       help="only sources that feed this project (waymux, waymaker, lazygitrs, workflow)")
    else:
        p.add_argument("--days", type=int, help="created in the last N days (manifest: scout.days)")
        p.add_argument("--min-stars", type=int)
        p.add_argument("--limit", type=int)
        p.add_argument("--all", action="store_true", help="include repositories already seen")
        p.add_argument("--no-trending", action="store_true", help="skip the github.com/trending pages")
        p.add_argument("--dismiss", metavar="OWNER/REPO", help="never show this repository again")
        p.add_argument("--reason", help="with --dismiss")
        p.add_argument("--track", metavar="OWNER/REPO", help="add it to the manifest as a reference")
        p.add_argument("--area", help="with --track: what it can improve")
    args = p.parse_args(argv)
    manifest, state = load_manifest(), load_state()
    return cmd_watch(args, manifest, state) if mode == "watch" else cmd_scout(args, manifest, state)


if __name__ == "__main__":
    sys.exit(main())
