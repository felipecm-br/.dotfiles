#!/usr/bin/env bash
# TUI Hyprland Animation Switcher using Matchmaker (mm)

ANIM_DIR="$HOME/.config/hypr/animations"
CONFIG_DEST="$HOME/.config/hypr/animations.lua"
PRESET_FILE="$HOME/.config/matchmaker/presets/animations.toml"

# Ensure waymaker binary is accessible
MM_BIN=$(command -v wm || command -v mm || echo "$HOME/.local/bin/wm")

if [ ! -x "$MM_BIN" ]; then
    echo "Error: waymaker (wm) binary not found!" >&2
    exit 1
fi

# Run matchmaker TUI with the animations preset (standalone config load)
SELECTED_LINE=$(cd "$ANIM_DIR" && "$MM_BIN" --no-read --config "$PRESET_FILE")

# Exit if canceled or empty
[ -z "$SELECTED_LINE" ] && exit 0

# Extract file path using pure bash built-in parameter expansion (zero forks)
PRESET_PATH="${SELECTED_LINE#*$'\t'}"
[ -z "$PRESET_PATH" ] && PRESET_PATH="$SELECTED_LINE"

if [ -f "$PRESET_PATH" ]; then
    cp "$PRESET_PATH" "$CONFIG_DEST"
    hyprctl reload >/dev/null 2>&1

    # Read title using pure shell built-in (zero forks)
    read -r TITLE < "$PRESET_PATH" || true
    TITLE="${TITLE#--}"
    TITLE="${TITLE#\#}"
    TITLE="${TITLE# }"
    [ -z "$TITLE" ] && TITLE="${PRESET_PATH##*/}"

    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "Hyprland" -i "preferences-desktop-theme" "Animation Applied" "$TITLE"
    fi
    echo "✨ Animation '$TITLE' applied successfully!"
else
    echo "Error: Preset file not found: $PRESET_PATH" >&2
    exit 1
fi
