#!/usr/bin/env bash
# ai-quota — Quota telemetry and agent recommendation for Claude Code and Antigravity
#
# Thin entry point for `waymux quota` (run `waymux quota --help` for the modes: report, --visual,
# --json, --badge, --badge-min, --recommend, --refresh, statusline). This wrapper keeps the paths
# and variables ai-launch, awt-fan, the Claude statusLine and the session picker already use:
#   state      $XDG_STATE_HOME/ai-quota (samples, badge caches, Antigravity cache)
#   providers  ai-quota-agy (Antigravity: agy, agyy), next to this script
#   AI_AGENT_PREFERENCE     Ordered candidates (default: "claude agy agyy")
#   AI_QUOTA_SESSION_RATE   Assumed 5h burn per Claude session in %/h when no samples exist (default: 10)
#   AI_QUOTA_NO_API, AI_QUOTA_MAX_STALE  see ai-quota-agy

here=$(dirname "$(readlink -f "$0")")
export WAYMUX_QUOTA_STATE_DIR="${WAYMUX_QUOTA_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/ai-quota}"
export WAYMUX_QUOTA_PROVIDERS="${WAYMUX_QUOTA_PROVIDERS-$(printf '%q' "$here/ai-quota-agy")}"
export WAYMUX_QUOTA_PREFERENCE="${WAYMUX_QUOTA_PREFERENCE:-${AI_AGENT_PREFERENCE:-claude agy agyy}}"
[ -n "${AI_QUOTA_SESSION_RATE:-}" ] && export WAYMUX_QUOTA_SESSION_RATE="$AI_QUOTA_SESSION_RATE"

if ! command -v waymux >/dev/null 2>&1; then
  echo "ai-quota: waymux not found (install it, then run: waymux doctor)" >&2
  exit 127
fi
exec waymux quota "$@"
