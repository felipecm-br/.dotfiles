#!/usr/bin/env bash
# ai-quota — Quota telemetry and agent recommendation for Claude Code and Antigravity
#
#   ai-quota                 Human-readable report (default)
#   ai-quota --json          Machine-readable snapshot (all agents, levels, recommendation)
#   ai-quota --badge         Compact tmux-format badge (session picker popup title)
#   ai-quota --recommend     Print the agent to launch: claude | agy | agyy
#   ai-quota statusline      Claude Code statusLine command: records rate_limits from stdin, prints a line
#
# Data sources (all local, no extra network calls):
#   claude  rate_limits.{five_hour,seven_day} pushed by Claude Code into the statusLine JSON
#           (recorded here as samples -> burn rate in %/h), live sessions in ~/.claude/sessions/
#   agy     percent left per group (Claude & GPT, Gemini Flash, pro tier) from fetchAvailableModels,
#           with the profile's own token on curl's stdin, cached 60 s; without a valid token, 429
#           "Individual quota reached ... Resets in XhYmZs" lines in antigravity-cli logs
#           (exhausted-until + learned prompt capacity per 5h window), prompts in history.jsonl
#   agyy    same as agy, under the secondary profile ($AGYY_HOME)
#
# Tunables (env):
#   AI_AGENT_PREFERENCE     Ordered candidates (default: "claude agy agyy")
#   AI_QUOTA_SESSION_RATE   Assumed 5h burn per Claude session in %/h when no samples exist (default: 10)
#   AI_QUOTA_NO_API         1 = never call the Antigravity API (logs and history only)

set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/ai-quota"
CLAUDE_LATEST="$STATE_DIR/claude.json"
CLAUDE_SAMPLES="$STATE_DIR/claude-samples.tsv"
AGYY_HOME="${AGYY_HOME:-$HOME/.local/share/agy-profiles/secondary}"

mkdir -p "$STATE_DIR"

# ── statusline: record rate_limits and print a compact line ────────────────
if [ "${1:-}" = "statusline" ]; then
  input=$(cat)
  now=$(date +%s)
  rl=$(jq -c '.rate_limits // empty' <<<"$input" 2>/dev/null)
  if [ -n "$rl" ] && [ "$rl" != "null" ]; then
    jq -c --argjson ts "$now" '{ts: $ts} + .' <<<"$rl" >"$CLAUDE_LATEST.tmp" && mv -f "$CLAUDE_LATEST.tmp" "$CLAUDE_LATEST"
    read -r five seven reset <<<"$(jq -r '[(.five_hour.used_percentage // .five_hour.utilization // "-"), (.seven_day.used_percentage // .seven_day.utilization // "-"), (.five_hour.resets_at // "-")] | map(tostring) | join(" ")' <<<"$rl")"
    last=$(tail -n 1 "$CLAUDE_SAMPLES" 2>/dev/null)
    read -r l_ts l_five l_seven _ <<<"${last:-0 - - -}"
    # Append on change, or every 5 min as a heartbeat so idle periods still flatten the slope
    if [ "$five" != "$l_five" ] || [ "$seven" != "$l_seven" ] || [ $((now - ${l_ts:-0})) -ge 300 ]; then
      printf '%s\t%s\t%s\t%s\n' "$now" "$five" "$seven" "$reset" >>"$CLAUDE_SAMPLES"
      if [ "$(wc -l <"$CLAUDE_SAMPLES")" -gt 6000 ]; then
        tail -n 4000 "$CLAUDE_SAMPLES" >"$CLAUDE_SAMPLES.tmp" && mv -f "$CLAUDE_SAMPLES.tmp" "$CLAUDE_SAMPLES"
      fi
    fi
  fi
  input_line=$(jq -r '[(.model.display_name // ""), ((.context_window.used_percentage // empty) | "ctx \(floor)%")] | map(select(. != "")) | join(" · ")' <<<"$input" 2>/dev/null)
  quota_line=$("$0" --line 2>/dev/null)
  printf '%s' "$input_line"
  [ -n "$quota_line" ] && printf '%s%s' "${input_line:+ · }" "$quota_line"
  printf '\n'
  exit 0
fi

MODE="report"
case "${1:-}" in
  --json) MODE="json" ;;
  --badge) MODE="badge" ;;
  --line) MODE="line" ;;
  --recommend) MODE="recommend" ;;
  -h | --help) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  "" | --report) ;;
  *) echo "ai-quota: unknown option '$1' (see --help)" >&2; exit 2 ;;
esac

now=$(date +%s)

# ── Claude inputs ───────────────────────────────────────────────────────────
claude_bin=false; command -v claude >/dev/null 2>&1 && claude_bin=true
claude_latest=$(cat "$CLAUDE_LATEST" 2>/dev/null || echo null)
claude_samples=$(awk -v cut=$((now - 5400)) -F'\t' '$1 >= cut' "$CLAUDE_SAMPLES" 2>/dev/null |
  jq -R -s -c 'split("\n") | map(select(length > 0) | split("\t") | {ts: (.[0] | tonumber), five: (.[1] | tonumber? // null), reset: .[3]})')

claude_sessions=0
for f in "$HOME"/.claude/sessions/*.json; do
  [ -e "$f" ] || continue
  pid=${f##*/}; pid=${pid%%.*}
  [ -d "/proc/$pid" ] && [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = "claude" ] && claude_sessions=$((claude_sessions + 1))
done

prompt_times() { # <history.jsonl>: epoch-seconds of real prompts in the last 8 days
  tail -n 6000 "$1" 2>/dev/null |
    jq -c -s --argjson cut $((now - 691200)) \
      '[.[] | select((.type // "prompt") != "slash_command") | (.timestamp / 1000 | floor) | select(. >= $cut)]' 2>/dev/null || echo '[]'
}
claude_prompts=$(prompt_times "$HOME/.claude/history.jsonl")
# Sessions that actually burn quota: prompted in the last 30 min (idle panes do not)
claude_active=$(tail -n 500 "$HOME/.claude/history.jsonl" 2>/dev/null |
  jq -s --argjson cut $((now - 1800)) '[.[] | select(.timestamp / 1000 >= $cut) | .sessionId] | unique | length' 2>/dev/null || echo 0)
[ "$claude_active" -gt "$claude_sessions" ] && claude_active=$claude_sessions

# ── Antigravity inputs (per profile home) ───────────────────────────────────
agy_events() { # <log dir>: [{ts, reset}] from 429 quota lines in logs touched in the last 8 days
  local dir=$1 f line stamp y ts dur secs
  [ -d "$dir" ] || { echo '[]'; return; }
  {
    find "$dir" -maxdepth 1 -name 'cli-*.log' -mtime -8 -print0 2>/dev/null |
      xargs -0 -r grep -H -m 20 'Individual quota reached' 2>/dev/null | tail -n 40 |
      while IFS= read -r line; do
        f=${line%%:*}; y=${f##*/cli-}; y=${y:0:4}
        stamp=$(sed -E 's/^[^:]*:[EWI]([0-9]{2})([0-9]{2}) ([0-9:]{8}).*/\1-\2 \3/' <<<"$line")
        dur=$(grep -oE 'Resets in [0-9hms]+' <<<"$line" | cut -d' ' -f3)
        ts=$(date -d "$y-$stamp" +%s 2>/dev/null) || continue
        secs=0
        [[ $dur =~ ([0-9]+)h ]] && secs=$((secs + BASH_REMATCH[1] * 3600))
        [[ $dur =~ ([0-9]+)m ]] && secs=$((secs + BASH_REMATCH[1] * 60))
        [[ $dur =~ ([0-9]+)s ]] && secs=$((secs + BASH_REMATCH[1]))
        printf '{"ts":%s,"reset":%s}\n' "$ts" "$((ts + secs))"
      done
  } | jq -s -c 'unique_by(.reset)'
}

agy_sessions() { # <home>: live agy CLI processes (top-level agy-bin) running under that HOME
  local home=$1 n=0 pid ppid env_home
  for pid in $(pgrep -x agy-bin 2>/dev/null); do
    ppid=$(awk '{print $4}' "/proc/$pid/stat" 2>/dev/null)
    [ "$(cat "/proc/$ppid/comm" 2>/dev/null)" = "agy-bin" ] && continue
    env_home=$(tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null | sed -n 's/^HOME=//p')
    [ "${env_home:-$HOME}" = "$home" ] && n=$((n + 1))
  done
  echo "$n"
}

# The three functions that touch the token run in a subshell `( … )` with xtrace off, so
# `bash -x ai-quota` never prints it and the rest of the script keeps its tracing.
agy_token() ( # <home>: a valid Antigravity access token for that profile, or nothing
  { set +x; } 2>/dev/null # never trace the token (bash -x would print it expanded)
  # The primary profile keeps its live token in the keyring (service gemini), the secondary one
  # in its token file; the keyring token is used only when its account matches the profile's.
  local home=$1 file="$1/.gemini/antigravity-cli/antigravity-oauth-token" src tok exp email file_email="" best="" best_exp=0
  local jwt_email='(.id_token_email // ((.id_token // "") | split(".") | .[1] // "" | gsub("-";"+") | gsub("_";"/")
    | (. + ("=" * ((4 - length % 4) % 4))) | (@base64d | fromjson? | .email) // ""))'
  [ -r "$file" ] && file_email=$(jq -r "$jwt_email" "$file" 2>/dev/null)
  for src in file keyring; do
    if [ "$src" = file ]; then
      [ -r "$file" ] || continue
      IFS=$'\t' read -r tok exp email < <(jq -r "[.token.access_token // \"\", .token.expiry // \"\", $jwt_email] | @tsv" "$file" 2>/dev/null)
    else
      IFS=$'\t' read -r tok exp email < <(secret-tool lookup service gemini 2>/dev/null |
        jq -r "[.token.access_token // \"\", .token.expiry // \"\", $jwt_email] | @tsv" 2>/dev/null)
      # No token file means no profile here (e.g. a sandboxed HOME): never borrow the keyring's.
      [ -n "$file_email" ] && [ "$email" = "$file_email" ] || continue
    fi
    [ -n "$tok" ] && [ -n "$exp" ] || continue
    exp=$(date -d "$exp" +%s 2>/dev/null) || continue
    if [ "$exp" -gt $((now + 60)) ] && [ "$exp" -gt "$best_exp" ]; then best=$tok; best_exp=$exp; fi
  done
  printf '%s' "$best"
)

agy_post() ( # <token> <url> <json body>: POST with the token read from stdin, never from argv
  { set +x; } 2>/dev/null # never trace the token (bash -x would print it expanded)
  printf 'header = "Authorization: Bearer %s"\n' "$1" |
    curl -sS --max-time 8 --config - -H 'Content-Type: application/json' -H 'User-Agent: antigravity' \
      -X POST --data "$3" "$2" 2>/dev/null
)

agy_api() ( # <home> <label>: per-model quota from fetchAvailableModels, cached 60 s; `null` when unavailable
  { set +x; } 2>/dev/null # never trace the token (bash -x would print it expanded)
  local home=$1 label=$2 cache="$STATE_DIR/agy-models-$2.json" proj_file="$STATE_DIR/agy-project-$2" tok proj resp
  if [ -n "${AI_QUOTA_FIXTURE_DIR:-}" ]; then
    # Tests: a recorded fetchAvailableModels response instead of the network
    resp=$(cat "$AI_QUOTA_FIXTURE_DIR/$label.json" 2>/dev/null) || { echo null; return; }
  else
    if [ -s "$cache" ] && [ $((now - $(stat -c %Y "$cache"))) -lt 60 ]; then cat "$cache"; return; fi
    tok=$(agy_token "$home")
    if [ -z "$tok" ]; then echo null; return; fi
    proj=$(cat "$proj_file" 2>/dev/null)
    if [ -z "$proj" ]; then
      proj=$(agy_post "$tok" "https://cloudcode-pa.googleapis.com/v1internal:loadCodeAssist" \
        '{"metadata":{"ideType":"ANTIGRAVITY"}}' | jq -r '.cloudaicompanionProject // empty' 2>/dev/null)
      [ -n "$proj" ] && printf '%s\n' "$proj" >"$proj_file"
    fi
    resp=$(agy_post "$tok" "https://daily-cloudcode-pa.googleapis.com/v1internal:fetchAvailableModels" \
      "$(jq -cn --arg p "$proj" 'if $p == "" then {} else {project: $p} end')")
  fi
  # A model with a resetTime but no remainingFraction is exhausted (the API omits zero).
  jq -c --argjson now "$now" '
    def epoch: if . == null then null else (sub("\\.[0-9]+"; "") | fromdateiso8601?) end;
    select(.models) | . as $r
    | def entry($id): ($r.models[$id] // null) as $m | if $m == null then null else {
        model: $id, name: ($m.displayName // $id),
        pct: (($m.quotaInfo.remainingFraction // (if $m.quotaInfo.resetTime then 0 else null end))
              | if . == null then null else (. * 100 | round) end),
        reset: ($m.quotaInfo.resetTime | epoch) } end;
    .
    | ([$r.models | keys[] | select(startswith("claude-") or startswith("gpt-oss"))] | map(entry(.)) | map(select(.pct != null))) as $cg
    | {ts: $now, default_model: .defaultAgentModelId,
       groups: [
         (if ($cg | length) > 0 then {key: "claude", label: "Claude & GPT", pct: ($cg | map(.pct) | min),
            reset: ($cg | map(.reset) | map(select(. != null)) | min)} else empty end),
         (entry($r.tieredModelIds.flash[0]? // "") | select(. != null) | {key: "flash", label: "Gemini Flash"} + .),
         (entry($r.tieredModelIds.pro[0]? // "") | select(. != null) | {key: "pro", label: "Gemini pro tier"} + .)
       ]}' <<<"$resp" 2>/dev/null >"$cache.tmp" && [ -s "$cache.tmp" ] && mv -f "$cache.tmp" "$cache" || rm -f "$cache.tmp"
  if [ -s "$cache" ]; then cat "$cache"; else echo null; fi
)

agy_bin=false; { command -v agy-bin >/dev/null 2>&1 || [ -x "$HOME/.local/bin/agy-bin" ]; } && agy_bin=true
agyy_ok=false; $agy_bin && [ -s "$AGYY_HOME/.gemini/antigravity-cli/antigravity-oauth-token" ] && agyy_ok=true

if [ "$MODE" = "line" ]; then
  # Claude statusline only needs Claude data: skip the Antigravity log scan on every refresh
  agy_ev='[]'; agy_pr='[]'; agy_n=0; agyy_ok=false
else
  agy_ev=$(agy_events "$HOME/.gemini/antigravity-cli/log")
  agy_pr=$(prompt_times "$HOME/.gemini/antigravity-cli/history.jsonl")
  agy_n=$(agy_sessions "$HOME")
fi
if $agyy_ok; then
  agyy_ev=$(agy_events "$AGYY_HOME/.gemini/antigravity-cli/log")
  agyy_pr=$(prompt_times "$AGYY_HOME/.gemini/antigravity-cli/history.jsonl")
  agyy_n=$(agy_sessions "$AGYY_HOME")
else
  agyy_ev='[]'; agyy_pr='[]'; agyy_n=0
fi

# Per-model quota from the API (cached 60 s); never on the statusline path. AI_QUOTA_NO_API=1
# keeps the log heuristic only.
agy_api_json=null; agyy_api_json=null
if [ "$MODE" != "line" ] && [ "${AI_QUOTA_NO_API:-0}" != 1 ] && command -v curl >/dev/null 2>&1; then
  $agy_bin && agy_api_json=$(agy_api "$HOME" agy)
  $agyy_ok && agyy_api_json=$(agy_api "$AGYY_HOME" agyy)
fi

# ── Model + scoring (single jq pass) ────────────────────────────────────────
jq -n -r \
  --arg mode "$MODE" \
  --argjson now "$now" \
  --arg pref "${AI_AGENT_PREFERENCE:-claude agy agyy}" \
  --argjson srate "${AI_QUOTA_SESSION_RATE:-10}" \
  --arg ic_claude "$(waymux icon claude 2>/dev/null || echo C)" \
  --arg ic_agy "$(waymux icon agy 2>/dev/null || echo A)" \
  --argjson c_bin "$claude_bin" --argjson c_latest "$claude_latest" --argjson c_samples "$claude_samples" \
  --argjson c_n "$claude_sessions" --argjson c_act "${claude_active:-0}" --argjson c_pr "$claude_prompts" \
  --argjson a_bin "$agy_bin" --argjson a_ev "$agy_ev" --argjson a_pr "$agy_pr" --argjson a_n "$agy_n" \
  --argjson y_ok "$agyy_ok" --argjson y_ev "$agyy_ev" --argjson y_pr "$agyy_pr" --argjson y_n "$agyy_n" \
  --argjson a_api "${agy_api_json:-null}" --argjson y_api "${agyy_api_json:-null}" '
def epoch: if . == null then null
  elif type == "number" then (if . > 1e12 then . / 1000 else . end)
  elif type == "string" then ((sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601?) // (tonumber? // null))
  else null end;
def r1: if . == null then null else (. * 10 | round) / 10 end;
def count_since($ts; $since): [$ts[] | select(. >= $since)] | length;
def hm: if . == null then "-" else (. / 60 | floor) as $m | if $m >= 1440 then "\($m / 1440 | floor)d\(($m % 1440) / 60 | floor)h" elif $m >= 60 then "\($m / 60 | floor)h\($m % 60)m" else "\($m)m" end end;
def clock: if . == null then "-" else (strflocaltime("%H:%M")) end;

# Claude: real utilisation from rate_limits, burn rate from recorded samples
def claude_model:
  ($c_latest // {}) as $l
  | ($l.five_hour.resets_at | epoch) as $r5
  | ($l.seven_day.resets_at | epoch) as $r7
  | (($l.five_hour.used_percentage // $l.five_hour.utilization) | if . == null then null else tonumber end) as $f0
  | (($l.seven_day.used_percentage // $l.seven_day.utilization) | if . == null then null else tonumber end) as $s0
  | (if $r5 != null and $r5 <= $now then 0 else $f0 end) as $five
  | (if $r7 != null and $r7 <= $now then 0 else $s0 end) as $seven
  | ([$c_samples[] | select(.ts >= $now - 3600 and .five != null and (.reset | epoch) == $r5)]) as $win
  | (if ($win | length) >= 2 and ($win[-1].ts - $win[0].ts) >= 300
     then (($win[-1].five - $win[0].five) / (($win[-1].ts - $win[0].ts) / 3600)) | if . < 0 then 0 else . end
     else null end) as $rate
  | (if $rate != null and $rate > 0 and $c_act > 0 then $rate / $c_act else $srate end) as $per
  | ((($rate // ($c_act * $per)) + $per)) as $rate_new
  | (if $r5 != null and $r5 > $now then (($r5 - $now) / 3600) else 5 end | if . > 5 then 5 else . end) as $h5
  | (if $five == null then null else $five + $rate_new * $h5 end) as $proj
  | (if $five == null or $rate_new <= 0 then null else ((100 - $five) / $rate_new) end) as $eta_h
  | (if $r7 != null and $seven != null
     then ((1 - (($r7 - $now) / 604800)) | if . < 0.02 then 0.02 elif . > 1 then 1 else . end) as $el | $seven / ($el * 100)
     else null end) as $pace
  | {
      agent: "claude", available: $c_bin, icon: $ic_claude, sessions: $c_n, active: $c_act,
      five: ($five | r1), seven: ($seven | r1), five_reset: $r5, seven_reset: $r7,
      rate: ($rate | r1), rate_with_new: ($rate_new | r1), projected_five: ($proj | r1),
      eta_full_h: ($eta_h | r1), week_pace: ($pace | r1),
      prompts_1h: count_since($c_pr; $now - 3600), prompts_5h: count_since($c_pr; $now - 18000),
      stale_s: (if $l.ts then $now - $l.ts else null end),
      level: (
        if $five == null then "unknown"
        elif $five >= 98 or ($seven // 0) >= 98 then "red"
        elif $rate != null and $eta_h != null and $eta_h < 0.5 and $h5 > 0.5 then "red"
        elif ($five >= 80) or ($rate != null and ($proj // 0) >= 90) or ($seven // 0) >= 85 or (($pace // 0) >= 1.25 and ($seven // 0) >= 40) then "yellow"
        else "green" end),
      until: (if ($five // 0) >= 98 then $r5 elif ($seven // 0) >= 98 then $r7 else null end)
    };

# Antigravity: per-group quota from the API when it answered; otherwise exhausted-until from
# 429s and capacity learned from the window that hit the cap
def agy_model($name; $bin; $ev; $pr; $n; $api):
  ([$ev[] | select(.reset > $now)] | max_by(.reset)) as $active
  | ([$ev[] | select(.reset - .ts <= 18000)] | max_by(.ts)) as $last5
  | (if $last5 then count_since([$pr[] | select(. <= $last5.ts)]; $last5.reset - 18000) else null end) as $cap
  | count_since($pr; $now - 18000) as $p5
  | (if $cap != null and $cap > 0 then ($p5 * 100 / $cap) else null end) as $est
  | (($api // {}).groups // null) as $groups
  | (($api // {}).default_model // "") as $dm
  | (if ($dm | startswith("claude-")) or ($dm | startswith("gpt-oss")) then "claude" else "flash" end) as $dkey
  | (if $groups then [$groups[] | select(.key == $dkey)] | first else null end) as $dgroup
  | (if $groups then [$groups[] | select((.pct // 0) > 0)] else null end) as $usable
  | (if $groups == null then null
     elif ($usable | length) == 0 then "red"
     elif ($dgroup != null and ($dgroup.pct // 0) == 0) or ([$usable[] | select(.pct < 20)] | length) > 0 then "yellow"
     else "green" end) as $api_level
  | {
      agent: $name, available: $bin, icon: $ic_agy, sessions: $n,
      prompts_1h: count_since($pr; $now - 3600), prompts_5h: $p5,
      capacity_5h: $cap, est_five: ($est | if . == null then null else round end),
      source: (if $groups then "api" else "logs" end), groups: $groups, default_model: $dm,
      default_exhausted: ($dgroup != null and ($dgroup.pct // 0) == 0),
      until: (if $groups == null then ($active.reset // null)
              elif $api_level == "red" then ([$groups[].reset | select(. != null)] | min) else null end),
      window: (if $groups == null and $active then (if ($active.reset - $active.ts) > 21600 then "7d" else "5h" end) else null end),
      level: ($api_level // (if $active then "red" elif ($est // 0) >= 80 then "yellow" elif $cap == null then "unknown" else "green" end))
    };

[ claude_model,
  agy_model("agy"; $a_bin; $a_ev; $a_pr; $a_n; $a_api),
  (if $y_ok then agy_model("agyy"; true; $y_ev; $y_pr; $y_n; $y_api) else empty end)
] as $agents
| ($pref | split(" ") | map(select(length > 0))) as $order
| [$order[] as $o | $agents[] | select(.agent == $o and .available)] as $cands
| ( ([$cands[] | select(.level == "green" or .level == "unknown")] | first)
    // ([$cands[] | select(.level == "yellow")] | first)
    // ($cands | sort_by(.until // 0) | first)
    // {agent: ($order[0] // "agy")} ) as $pick
| ($pick.agent) as $rec
| (if ($cands | first | .agent) == $rec then "preferred agent has headroom"
   else "\($cands | first | .agent) is \($cands | first | .level); falling back" end) as $why
| def color: if .level == "green" then "green" elif .level == "yellow" then "yellow" elif .level == "red" then "red" else "colour244" end;
  def ansi: if .level == "green" then "\u001b[32m" elif .level == "yellow" then "\u001b[33m" elif .level == "red" then "\u001b[31m" else "\u001b[90m" end;
  def tag: (if .agent == "agyy" then "\(.icon)²" else .icon end);
  def short:
    if .until != null and .level == "red" then "⏳\(.until | clock)"
    elif .agent == "claude" then
      (if .five == null then "?" else "\(.five | floor)·\(.seven // 0 | floor)%" end)
      + (if (.rate // 0) >= 1 then " ↗" else "" end)
    elif .groups != null then
      # Percent left per group: C = Claude & GPT, G = Gemini Flash
      ([.groups[] | select(.key == "claude" or .key == "flash") | "\(if .key == "claude" then "C" else "G" end)\(.pct)"] | join(" ")) + "%"
    else (if .est_five != null then "~\(.est_five)%" else "\(.prompts_5h)p" end) end;
  def sess: if .sessions > 0 then " ×\(.sessions)" else "" end;

if $mode == "json" then {now: $now, recommend: $rec, reason: $why, agents: $agents} | tojson
elif $mode == "recommend" then $rec
elif $mode == "badge" then
  ([$agents[] | select(.available) | "#[fg=\(color)]\(tag)#[default] \(short)\(sess)"] | join(" │ "))
  + " │ → \([$agents[] | select(.agent == $rec) | tag] | first // $rec)"
elif $mode == "line" then
  ($agents[0]) as $c
  | if $c.five == null then empty else
    "\($c | ansi)5h \($c.five | floor)%\u001b[0m"
    + (if ($c.rate // 0) >= 1 then " ↗\($c.rate | floor)%/h" else "" end)
    + " ⟳\($c.five_reset | clock) · 7d \($c.seven // 0 | floor)%"
    + (if $c.week_pace != null then " (\($c.week_pace)× pace)" else "" end) end
else
  ( $agents[] | select(.available) |
    "\(ansi)● \(.agent)\u001b[0m  [\(.level)]  sessions: \(.sessions)\(if .active != null then " (\(.active) active)" else "" end)  prompts 1h/5h: \(.prompts_1h)/\(.prompts_5h)\n"
    + (if .agent == "claude" then
        "    5h: \(.five // "?")%  reset \(.five_reset | clock) (in \(if .five_reset then (.five_reset - $now) | hm else "-" end))  burn: \(.rate // "-")%/h  +1 session: \(.rate_with_new)%/h\n"
        + "    projected at reset: \(.projected_five // "-")%  full in: \(if .eta_full_h then (.eta_full_h * 3600) | hm else "-" end)\n"
        + "    7d: \(.seven // "?")%  reset \(if .seven_reset then (.seven_reset | strflocaltime("%a %H:%M")) else "-" end)  pace: \(.week_pace // "-")×"
        + (if (.stale_s // 0) > 900 then "\n    \u001b[90m(last statusline sample \(.stale_s | hm) ago)\u001b[0m" else "" end)
        + (if .stale_s == null then "\n    \u001b[90m(no samples yet: start a claude session with the ai-quota statusLine)\u001b[0m" else "" end)
      elif .groups != null then
        (.groups | map(select(.key == "flash")) | first) as $flash
        | ([.groups[] | select(.key != "pro" or .model != ($flash.model // ""))
            | "    \(.label)\(if .key != "claude" then " (\(.model))" else "" end): \(.pct)% left  reset \(if .reset then (.reset | strflocaltime("%a %H:%M")) + " (in \((.reset - $now) | hm))" else "-" end)"]
           | join("\n"))
        + ([.groups[] | select(.key == "pro" and .model == ($flash.model // ""))] | if length > 0
            then "\n    Gemini 4 Argon: no per-model quota in the API; its pro tier maps to \(.[0].model) (the Gemini Flash quota above)"
            else "" end)
        + (if .default_exhausted and ([.groups[] | select(.key == "flash" and (.pct // 0) > 0)] | length) > 0
           then "\n    \u001b[33mdefault model \(.default_model) is out of quota: start with --model gemini-3.8-flash-high\u001b[0m"
           else "" end)
      else
        "    est 5h: \(if .est_five != null then "~\(.est_five)% of learned capacity (\(.capacity_5h) prompts)" else "unknown (no cap hit observed yet)" end)"
        + (if .until then "\n    exhausted (\(.window)) until \(.until | strflocaltime("%a %H:%M")) (in \((.until - $now) | hm))" else "" end)
        + "\n    \u001b[90m(no live API data: the profile has no valid token; open agy once to refresh it)\u001b[0m"
      end) + "\n"
  ),
  "→ recommend: \($rec)  (\($why))"
end
'
