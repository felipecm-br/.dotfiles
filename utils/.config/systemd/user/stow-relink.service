[Unit]
Description=stow-relink: copy app-saved configs into the dotfiles repo and restore their symlinks
Documentation=file://%h/.dotfiles/main/docs/utils.md
# One bar change makes the shell save a few times in a row, and each relink
# writes the watched path again: never let that burst trip the start limit.
StartLimitIntervalSec=0

[Service]
Type=oneshot
# Let a burst of saves settle so one run handles all of them.
ExecStartPre=/usr/bin/sleep 1
ExecStart=%h/.local/bin/stow-relink
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stow-relink
