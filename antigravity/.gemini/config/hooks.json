{
  "tmux": {
    "PostInvocation": [
      {
        "command": "waymux hook tmux PostInvocation",
        "timeout": 0,
        "type": "command"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "waymux hook tmux PostToolUse",
            "timeout": 0,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreInvocation": [
      {
        "command": "waymux hook tmux PreInvocation agy",
        "timeout": 0,
        "type": "command"
      },
      {
        "command": "waymux hook lazygit PreInvocation",
        "timeout": 0,
        "type": "command"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "waymux hook tmux PreToolUse",
            "timeout": 0,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "command": "waymux hook tmux SessionStart agy",
        "timeout": 0,
        "type": "command"
      },
      {
        "command": "waymux hook lazygit SessionStart",
        "timeout": 0,
        "type": "command"
      }
    ],
    "SessionEnd": [
      {
        "command": "waymux hook tmux SessionEnd",
        "timeout": 0,
        "type": "command"
      },
      {
        "command": "waymux hook lazygit SessionEnd",
        "timeout": 0,
        "type": "command"
      }
    ],
    "Stop": [
      {
        "command": "waymux hook tmux Stop",
        "timeout": 0,
        "type": "command"
      }
    ]
  },
  "ai-memory": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/ai-memory --data-dir /home/fecavmi/.dotfiles/main/ai-memory/.local/share/ai-memory hook --event pre-tool-use --agent antigravity-cli --server-url http://127.0.0.1:49374"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/ai-memory --data-dir /home/fecavmi/.dotfiles/main/ai-memory/.local/share/ai-memory hook --event post-tool-use --agent antigravity-cli --server-url http://127.0.0.1:49374"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "/usr/bin/ai-memory --data-dir /home/fecavmi/.dotfiles/main/ai-memory/.local/share/ai-memory hook --event session-start --agent antigravity-cli --server-url http://127.0.0.1:49374"
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "/usr/bin/ai-memory --data-dir /home/fecavmi/.dotfiles/main/ai-memory/.local/share/ai-memory hook --event pre-invocation --agent antigravity-cli --server-url http://127.0.0.1:49374"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "/usr/bin/ai-memory --data-dir /home/fecavmi/.dotfiles/main/ai-memory/.local/share/ai-memory hook --event stop --agent antigravity-cli --server-url http://127.0.0.1:49374"
      }
    ]
  }
}
