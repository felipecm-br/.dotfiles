{
  "tmux": {
    "PostInvocation": [
      {
        "command": "waymux hook tmux PostInvocation",
        "timeout": 0,
        "type": "command"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "waymux hook tmux PostToolUse",
            "timeout": 0,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreInvocation": [
      {
        "command": "waymux hook tmux PreInvocation",
        "timeout": 0,
        "type": "command"
      },
      {
        "command": "waymux hook lazygit PreInvocation",
        "timeout": 0,
        "type": "command"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "waymux hook tmux PreToolUse",
            "timeout": 0,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionEnd": [
      {
        "command": "waymux hook tmux SessionEnd",
        "timeout": 0,
        "type": "command"
      },
      {
        "command": "waymux hook lazygit SessionEnd",
        "timeout": 0,
        "type": "command"
      }
    ],
    "Stop": [
      {
        "command": "waymux hook tmux Stop",
        "timeout": 0,
        "type": "command"
      }
    ]
  },
  "workmux-status": {
    "PreInvocation": [
      {
        "command": "workmux register-agent >/dev/null 2>&1 || true; printf '{}\\n'",
        "type": "command"
      },
      {
        "command": "workmux set-window-status working >/dev/null 2>&1 || true; printf '{}\\n'",
        "type": "command"
      }
    ],
    "Stop": [
      {
        "command": "workmux set-window-status done >/dev/null 2>&1 || true; printf '{}\\n'",
        "type": "command"
      }
    ]
  }
}
