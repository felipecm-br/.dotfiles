# Open interactive Waymaker worktree dashboard
awt

# Open floating AWT modal in Tmux (85% × 75%)
awp

# Open floating AWT modal in Tmux (85% × 75%)
awt popup

# Launch 5-step Conventional Commits creation wizard
awc

# Launch 5-step Conventional Commits creation wizard
awt -c

# Auto-derive conventional branch name from task prompt and provision worktree
awt -c -A {{prompt}}

# Create worktree and migrate uncommitted dirty working tree changes
awt -c -W {{branch}}

# Create worktree from explicit base branch
awt -c {{branch}} {{base}}

# Create worktree with base branch and dispatch inline agent command
awt -c {{branch}} {{base}} -- {{command}}

# Create worktree keeping Claude Code's default edit prompts (skip the acceptEdits policy)
AWT_CLAUDE_ACCEPT_EDITS=0 awt -c {{branch}} {{base}}

# Switch to existing worktree (or auto-create) and dispatch inline agent command
awt {{branch}} -- {{command}}

# Switch to existing worktree session (or auto-create from HEAD)
awt switch {{branch}}

# Interactive GitHub Pull Request picker (gh pr list) into isolated worktree
awt pr

# Checkout GitHub Pull Request directly into isolated worktree
awt pr {{pr_number}}

# Merge active worktree into base branch, push to origin, and clean up
awt ship

# Merge specific worktree into base branch, push to origin, and clean up
awt ship {{branch}}

# Merge active worktree into base branch with hooks
awt merge {{branch}}

# Merge active worktree into explicit target branch
awt merge --into {{target_branch}}

# Merge active worktree bypassing pre-merge validation hooks
awt merge --no-hooks

# Perform linear rebase onto origin base before fast-forward merge
awt merge --rebase {{branch}}

# Merge active worktree into base branch and push to remote origin
awt merge --push {{branch}}

# Squash and merge active worktree into base branch
awt merge --squash {{branch}}

# Rebase active worktree onto base branch with auto-stash
awt rebase {{base}}

# Delete worktree, Git branch, and kill Tmux session
awt rm {{branch}}

# Delete worktree bypassing pre-remove validation hooks
awt rm --no-hooks {{branch}}

# Force delete dirty worktree, Git branch, and Tmux session
awt rm -f {{branch}}

# Batch sweep and prune merged Git worktrees and dead sessions
awt sweep

# Batch sweep merged Git worktrees across ~/.dotfiles and all ~/dev/github/* repositories
awt sweep --all

# Sweep merged worktrees and clean Rust target/ directories in secondary sibling worktrees
awt sweep --all --clean-targets

# Preview worktrees eligible for sweep without deleting
awt sweep --dry-run

# Read-only inventory of Rust target/, AUR cache, Trash, and Docker storage hygiene
dev-gc --dry-run

# Run automated storage & worktree housekeeping (stale Rust targets, yay cache, Trash, Docker build cache >30d)
dev-gc --yes

# Run storage housekeeping including secondary sibling worktree Rust target/ folders
dev-gc --yes --secondary-targets

# Garbage-collect stale AI agents and orphan worktree sessions (default: >4h)
awt reap

# Preview stale AI agents eligible for reaping without terminating
awt reap --dry-run

# Clone repository into .bare container layout
awt clone {{repo_url}} {{target_dir}}

# Clone repository into .bare container layout and provision worktree
awtc {{repo_url}}

# Jump to next agent needing attention (permission/question) via Waymux
~/.config/tmux/ai-agent-triage-jump.sh

# Open AI agent bell notification queue ring popup
~/.config/tmux/ai-agent-bell-popup.sh

# Open interactive session picker in Tmux popup
~/.config/tmux/session-picker.sh

# Show AI quota report (Claude 5h/7d burn rate, Antigravity exhaustion, recommended agent)
ai-quota

# Show visual AI quota & burn telemetry dashboard with bullet gauges and 5h sparklines
ai-quota --visual

# Open visual AI quota & burn telemetry popup in Tmux (Prefix+u)
~/.config/tmux/ai-quota-popup.sh

# Print the one-glyph quota badge (recommended agent, level-colored) used in the session picker title
ai-quota --badge-min

# Force a refresh of the AI quota caches (normally run every 2 min by ai-quota-refresh.timer)
ai-quota --refresh

# Show the AI quota refresh timer schedule
systemctl --user list-timers ai-quota-refresh.timer

# Print the quota-recommended AI agent (claude | agy | agyy)
ai-quota --recommend

# Open the AI CLI × model launch menu with live quota per row
ai-launch

# Open the AI CLI × model launch menu as a tmux popup (Prefix+a / Ctrl+Shift+A); the pick starts in a new window
~/.config/tmux/ai-launch-popup.sh

# Print the CLI × model choice from the launch menu without starting it
ai-launch --pick

# Switch the model or effort of the AI agent in the current tmux pane, in place (menu; Prefix+A)
ai-switch

# Switch the current pane's AI agent directly to a model or effort level (e.g. sonnet, high)
ai-switch {{choice}}

# Open the in-place AI model / effort switcher as a tmux popup over the current pane
~/.config/tmux/ai-switch-popup.sh

# Edit the prompt draft of the AI agent in the current tmux pane in a Neovim popup (Prefix+v)
ai-prompt edit

# Stash the AI agent prompt draft to run a /command first, or bring the stash back (Prefix+V)
ai-prompt stash

# Start the quota-recommended AI agent and model directly
ai-launch --auto

# Start a specific AI agent CLI (claude, agy, agyy, devin, codex)
ai-launch {{agent}}

# Start Claude inside the ai-jail sandbox with permission prompts off (the Claude Jailed menu row)
ai-launch jail-claude --model {{model}}

# Gracefully terminate Tmux session with AI agent and multi-window safeguards
~/.config/tmux/close-session.sh

# Force terminate Tmux session bypassing confirmation safeguards
~/.config/tmux/close-session.sh --force

# Close active Tmux window or pane with AI agent safeguards
~/.config/tmux/close-window.sh

# Force close active Tmux window or pane bypassing AI agent safeguards
~/.config/tmux/close-window.sh --force

# Open interactive Tmux window picker with live pane preview and agent status
~/.config/tmux/window-picker.sh

# Open interactive workspace context inspector in Tmux popup (Prefix + e)
~/.config/tmux/workspace-picker.sh

# Open interactive GitHub Pull Request review picker in Tmux popup (Prefix + P)
~/.config/tmux/pr-picker.sh

# Open interactive scrollback token and URL extractor in Tmux popup (Prefix + y)
~/.config/tmux/scrollback-picker.sh

# Open terminal scrollback and AI markdown/diagrams in high-density popup (Prefix + E)
~/.config/tmux/scrollback-view.sh

# Open URL or link token directly in Google Chrome / browser
~/.config/tmux/scrollback-chrome.sh {{url}}

# Open live full-text ripgrep picker in Tmux popup (Prefix + /)
~/.config/tmux/grep-picker.sh

# Open interactive Keybindings & Navigation HUD in Tmux popup (Prefix + ?)
~/.config/tmux/keybindings-picker.sh

# Open VS Code-style Command Palette in Tmux popup (Prefix + p / Ctrl + Shift + P)
~/.config/tmux/command-palette.sh

# Paste files or clipboard into last visited Waymaker target directory
ptl {{files}}

# Paste files or clipboard into target directory and navigate there
ptg {{files}}

# Paste files or clipboard into selected directory without changing directory
pt {{files}}

# Move files into last visited Waymaker target directory
mtl {{files}}

# Move files into target directory and navigate there
mtg {{files}}

# Move files into selected directory without changing directory
mt {{files}}

# Jump to directory matching frecency query with fallback to Waymaker
j {{query}}

# Interactive frecency jump picker with Waymaker
ji

# Interactive Waymaker Jump widget (frecency & tree navigation)
wm -o jump

# Headless fuzzy filter matching query without launching TUI
wm -f {{query}}

# List frecency directories ranked by usage
wm list --dirs

# List bookmarked directories and files
wm list --bookmarks

# Add directory manually to frecency database
wm add {{dir}}

# Live-reload Markdown preview with inline Kitty Unicode diagrams
wm md -w {{file}}

# Interactive workspace & session picker (Waymaker native)
wm session

# Connect to or create a session with Waymaker
wm connect {{session}}

# Switch to previous Tmux session
wm last

# List active sessions and configured paths
wm session list

# Dry-run GNU Stow symlink validation
./stow.sh -n

# Inspect status of all stowed dotfile packages
./stow.sh -s

# Restow a specific package
./stow.sh -r {{package}}

# Stow a new package to home directory
./stow.sh {{package}}

# Delete or unstow a package from home directory
./stow.sh -d {{package}}

# Audit documentation integrity, broken links, and root cleanliness
./scripts/docs-lint.sh

# Read the live ZMK keymap from the keyboard (read-only) and redraw PDF/SVG/table
./scripts/zmk-keymap/run.sh

# Read the live ZMK keymap from an explicit Studio serial port
./scripts/zmk-keymap/run.sh {{port}}

# Redraw the ZMK keymap PDF/SVG/table from the committed snapshot
./scripts/zmk-keymap/run.sh --offline

# Render Mermaid diagram to PNG image
mmdc -i {{mmd_file}} -o {{output_png}} -b transparent -t dark

# Render Mermaid diagram to SVG vector
mmdc -i {{mmd_file}} -o {{output_svg}} -b transparent -t dark

# Save image from Wayland clipboard to PNG file
wl-paste -t image/png > {{output_png}}

# List available MIME types currently in Wayland clipboard
wl-paste --list-types

# Convert any image format to PNG via ImageMagick
magick {{input_image}} {{output_png}}

# Sync custom.commands into IntelliShell local database
intelli-sync

# Launch Hibiki Wayland keystroke visualizer (launcher GUI)
hibiki

# Launch Hibiki keystroke visualizer directly without UI launcher (daemon / overlay mode)
hibiki --no-ui

# Reopen last closed Tmux window/tab with exact position, file, command, AI session, path, and session (Ctrl+Shift+T)
~/.config/tmux/reopen-window.sh

# Open Posting TUI HTTP client
posting

# Open Posting TUI HTTP client with specific collection directory
posting --collection {{collection_dir}}

# Launch OBS Studio (Screen recorder and streaming studio)
obs

# Launch OBS Studio and start recording immediately
obs --startrecording

# Inspect Waymux control plane health, active AI agent states, and Tmux sessions
waymux status

# Check health of Waymux control plane daemon
waymux health

# List active AI agent pane states in TSV format
waymux list

# Dismiss attention/question/permission badge on target pane
waymux dismiss {{pane}}

# Cycle AI agent alerts and jump focus directly to pane requiring attention
waymux triage --jump

# Cycle AI agent alerts and open floating triage popup
waymux triage --popup

# List prompts the waymux daemon holds until each agent is at rest
waymux queue ls

# Queue a prompt for an agent pane (typed after 1s idle, never into a permission prompt)
waymux queue add {{pane}} {{prompt}}

# Drop a queued or stalled prompt for an agent pane
waymux queue rm {{pane}} {{id}}

# Fan one prompt out to N agents in N worktrees (quota-gated by ai-quota)
awt-fan new -n {{attempts:3}} -- {{prompt}}

# Compare the attempts of the latest fan: Enter jump, J judge, S keep, d drop
awt-fan compare

# Keep one fan attempt: commit it, merge into the base, remove every attempt
awt-fan keep {{fan_id}} {{attempt}}

# Print the link that pairs a phone with the waymux page (/m); serve 4040 on the tailnet first
waymux phone-token --url

# Unpair every phone: replace the phone token
waymux phone-token --rotate

# Send a test alert to the phone through the [phone] ntfy topic (held prompts alert after 15 s)
waymux phone-alert

# Mint a hook token limited to one pane, for a sandboxed agent (ai-launch jail-claude does this)
waymux hook-token {{pane}}

# List the work-tree checkpoints each agent turn left in this pane
waymux checkpoint list

# Show what one agent turn changed
waymux checkpoint diff {{n}}

# Put the files back as an agent turn left them (saves a safety checkpoint first)
waymux checkpoint restore {{n}}

# Launch interactive TUI picker or session manager via Waymaker
wm

# List tmux sessions via Waymaker with nerd font icons
wm session list --icons

# Launch Lazygitrs floating git cockpit and dual-diff view
lazygitrs

# Dispatch AI agent or command into Tmux via Waymux control plane
waymux-cli run {{command}}

# Dispatch AI agent or command into dedicated session and window detached
waymux-cli run -d -s {{session}} -w {{window}} {{command}}

# Capture terminal scrollback text from target pane via Waymux
waymux-cli capture {{pane}}

# Send keystrokes or confirmation into target pane via Waymux
waymux-cli send {{pane}} {{keys}}

# Display banner message on Tmux status line via Waymux
waymux-cli msg {{message}}

# Trigger visual or audible alert bell on target pane via Waymux
waymux-cli bell {{pane}}

# Wait synchronously for agent pane to reach target state (e.g. idle)
waymux-cli wait {{pane}} --state {{state}} --timeout {{timeout}}

# Dismiss agent attention, question, or permission badge on target pane
waymux-cli dismiss {{pane}}

# Authenticate and connect to Tailscale network with SSH enabled
sudo tailscale up --ssh

# Expose Waymux JSON-RPC control plane securely on private Tailnet
tailscale serve --bg 4040

# Run automated cockpit health and system drift audit
./scripts/drift-doctor.sh

# Play audio alert at typing breakpoint (preserves cognitive flow)
chime-at-breakpoint {{sound_file}}

# Open AI Fleet & Window Cockpit HUD in Tmux (85% × 75%)
cockpit

# Launch Waymux native AI Fleet & Window Cockpit HUD
waymux cockpit

# Inspect Waymux daemon health and active AI agent states
waymux status

# List active AI agent pane states in TSV format
waymux list

# Dismiss attention, question, or permission badge on target pane
waymux dismiss {{pane}}

# Generate Waymux Cockpit TSV items with /proc CPU/RAM telemetry
waymux cockpit-items

# Cycle AI agent notifications in an isolated Tmux popup overlay
waymux triage --popup

# Jump directly to the next AI agent requiring attention (zero-modal)
waymux triage --jump

# Print the Nerd Font glyph for a program/agent from the icon registry ([icons] in waymux config)
waymux icon {{name}}

# Print the Nerd Font glyph for an agent state (idle, busy, question, permission, stalled, error, review)
waymux icon --state {{state}}

# Export the whole icon registry (tsv, sh for eval, tmux for the window-name plugin)
waymux icons --format {{format}}

# Regenerate the tmux window-name plugin icons from the waymux icon registry
~/.config/tmux/nerd-font-icons-sync.sh

# Manage Git worktrees natively via Waymux (new, go, ls, rm, ship, reap)
waymux wt {{subcommand}}

# Generate Tmux, systemd, or AI hook integration snippets
waymux init --tmux

# Execute guarded agent prompt action (approve, deny, prompt)
agent-action {{action}} {{state}} {{pid}}

# Dispatch pending Lazygitrs AI review comments to target agent
cockpit-review-notes send {{path}} {{session}} {{idx}} {{pane_id}}

# Open Lazygitrs interactive Git TUI
lazygitrs

# Launch Lazygitrs Turbo Patch mode (diff focused, hunk staging)
lazygitrs --patch

# Snapshot active Tmux workspace sessions and worktrees for post-reboot recovery
cockpit snapshot

# Restore saved Tmux workspace sessions, windows and layouts after reboot
cockpit restore

# Display saved Cockpit topology snapshot details and age
cockpit status

# Generate AI-assisted Conventional Commit message (auto-stages all by default)
gc

# Generate AI-assisted Conventional Commit message for staged changes only
gc -s

# Split dirty working tree into atomic Conventional Commits using AI
sgc

# Preview atomic Conventional Commit split plan without committing
sgc -d

# Run test suite and stamp Test-Status trailer on HEAD commit for TUI badges
gtest

# Run custom test command and stamp Test-Status trailer on HEAD commit
gtest {{test_command}}

# Dispatch 360-degree terminal error and git diff context to active AI agent
ai-fix {{note}}

# Audit and clean stale observations and orphan sessions in ai-memory
ai-memory-clean --apply

# Launch an agent in a managed ai-memory workstream inside the ai-jail sandbox
ai-memory run --jail {{agent}} --yolo

# Verify the ai-jail sandbox can reach the host ai-memory daemon (forward_ports)
ai-jail bash -c 'curl -s -m4 http://127.0.0.1:49374/healthz'

# Interactive Waymux auditory telemetry sound pack switcher
ai-sound-switcher

# Interactive Hyprland active window border gradient switcher
hypr-border

# Interactive Hyprland window animation curve switcher
hypr-anim

# Adopt an existing file or directory into dotfiles and stow it
stow-it {{path}} {{package}}

# Display personal flow state & deep work evidence telemetry
flow-telemetry

# Display daily evidence summary of uninterrupted focus and review latency
flow-telemetry --summary

# Render deep work hourly focus heatmap and metrics in terminal
flow-telemetry --hud

# Output GitHub-flavored markdown telemetry table and heatmap
flow-telemetry --markdown

# Show most used shortcuts, never-used bindings and faster-path suggestions (last 14 days)
key-telemetry

# Key telemetry report over a custom window of days
key-telemetry report --days {{days}}

# Dispatch review note directly to active AI agent pane in worktree
agent-note.sh {{target_dir}} {{prompt}}

# Display quota-aware AI agent telemetry and recommendation report
ai-quota

# Render visual TUI quota dashboard with Stephen Few bullet gauges and 5h sparklines
ai-quota --visual

# Output JSON snapshot of AI agent quotas, burn rate, and recommended agent
ai-quota --json

# Open CLI x model launch menu with live quota telemetry per row
ai-launch

# Launch quota-recommended AI agent and model automatically
ai-launch --auto

# Launch Antigravity CLI interactive agent session
agy

# Launch Antigravity CLI secondary account session (isolated profile)
agyy

# Resume most recent conversation in secondary Antigravity CLI account
agyy -c

# Launch Claude Code interactive coding assistant
claude

# Start Claude Code session with initial prompt
claude "{{prompt}}"

# Resume most recent Claude Code session in current directory
claude -c

# Launch Claude Code without ai-memory hooks or MCP servers (alias: cnm)
cnm

# Audit, check, and update all dependencies of the AI workflow stack
update-ai-workflow

# Dry-run audit of AI workflow dependencies (tmux, fonts, codex, agy, daemons)
update-ai-workflow --check

# Non-interactive batch update of all AI workflow dependencies
update-ai-workflow -y

# Force reinstallation or rebuild of all AI workflow dependencies
update-ai-workflow --all

# Update only a specific AI workflow component (tmux, fonts, codex, agy, claude, devin, opencode, ai-memory)
update-ai-workflow --only {{component}}

# Convenient shortcut to update AI workflow dependencies
ai-update

# Browse, hot-reload preview, and apply Starship prompt presets (listed first) and Omarchy themes interactively
omarchy-starship-preset

# Browse and preview only Omarchy themes for Starship prompt
omarchy-starship-preset --themes

# Browse and preview only custom Starship prompt presets
omarchy-starship-preset --presets

# Output rendered Starship preset or Omarchy theme TOML configuration to stdout
omarchy-starship-preset --preview-only {{preset_or_theme}}

# Delete a custom Starship prompt preset file (Omarchy themes are refused)
omarchy-starship-preset --delete ~/.config/omarchy/starship-presets/{{preset}}.toml

# Write a copy of a Starship config with every palette hue rotated in OKLCh (prompt-art repo-hue engine)
prompt-palette-transform --hue {{degrees}} {{src_toml}} {{dst_toml}}

# Write a copy of a Starship config tinted for a time of day: night, dawn, morning, noon, golden, dusk (prompt-art sky-clock engine)
prompt-palette-transform --sky {{band}} {{src_toml}} {{dst_toml}}

# Show the base and active Starship configs chosen by the prompt-art zsh modules
prompt-art status

# Restore the base Starship config for this shell and stop prompt-art recoloring
prompt-art off

# Remove the cached prompt-art palette variants
prompt-art clear-cache

$ (awt) branch: git branch --format='%(refname:short)' 2>/dev/null
$ (awt) base: git branch --format='%(refname:short)' 2>/dev/null
$ (awt) pr_number: gh pr list --limit 30 --json number,title --template '{{range .}}{{tablerow .number .title}}{{end}}' 2>/dev/null
$ (awtc) repo_url: gh repo list --limit 20 --json nameWithOwner -q '.[].nameWithOwner' 2>/dev/null
$ (stow.sh) package: find . -maxdepth 1 -mindepth 1 -type d ! -name '.*' ! -name 'scripts' ! -name 'docs' -printf '%f\n' 2>/dev/null
$ (./stow.sh) package: find . -maxdepth 1 -mindepth 1 -type d ! -name '.*' ! -name 'scripts' ! -name 'docs' -printf '%f\n' 2>/dev/null
$ (stow-it) package: find . -maxdepth 1 -mindepth 1 -type d ! -name '.*' ! -name 'scripts' ! -name 'docs' -printf '%f\n' 2>/dev/null
$ (wm) session: wm session list 2>/dev/null
$ (waymux) name: waymux icons | awk -F'\t' '$1 == "program" {print $2}' 2>/dev/null
$ (waymux) state: waymux icons | awk -F'\t' '$1 == "state" {print $2}' 2>/dev/null
$ (waymux) format: printf '%s\n' tsv sh tmux
$ (wm) file: find . -maxdepth 3 -type f \( -name '*.md' -o -name '*.markdown' -o -name '*.mmd' \) 2>/dev/null
$ (mmdc) mmd_file: find . -maxdepth 4 -type f \( -name '*.mmd' -o -name '*.mermaid' \) 2>/dev/null
$ (update-ai-workflow) component: echo -e "tmux\nfonts\ncodex\nagy\nantigravity-ide\nclaude\ndevin\nopencode\nwaymux\nai-suite\nworktrunk\nmise"

# Toggle gradient frames on tmux popups (Waymaker pickers, lazygitrs)
border-gradient

# Turn popup gradient frames on with a palette (aurora, nebula, rainbow, blackhole, warm, cool, lavender, monochrome)
border-gradient on {{palette}}

# Turn popup gradient frames off (back to themed single-color borders)
border-gradient off

# Start the local OpenBot checkout (app + server)
openbot dev

# Create the OpenBot .env from .env.example
openbot setup

# Run an OpenBot package.json script (test, build, typecheck, ...)
openbot {{script}}

# Agent: run a privileged command through a tmux approval popup (you confirm + type the sudo password)
agent-sudo -r {{reason}} -- {{command}}

# Start/inspect the agent-sudo bridge daemon (loopback 49375, forwarded into ai-jail)
systemctl --user enable --now agent-sudod
