# Open interactive Matchmaker worktree dashboard
awt

# Open floating AWT modal in Tmux (85% × 75%)
awp

# Open floating AWT modal in Tmux (85% × 75%)
awt popup

# Launch 5-step Conventional Commits creation wizard
awc

# Launch 5-step Conventional Commits creation wizard
awt -c

# Auto-derive conventional branch name from task prompt and provision worktree
awt -c -A {{prompt}}

# Create worktree from explicit base branch
awt -c {{branch}} {{base}}

# Create worktree with base branch and dispatch inline agent command
awt -c {{branch}} {{base}} -- {{command}}

# Switch to existing worktree (or auto-create) and dispatch inline agent command
awt {{branch}} -- {{command}}

# Switch to existing worktree session (or auto-create from HEAD)
awt switch {{branch}}

# Interactive GitHub Pull Request picker (gh pr list) into isolated worktree
awt pr

# Checkout GitHub Pull Request directly into isolated worktree
awt pr {{pr_number}}

# Merge active worktree into base branch, push to origin, and clean up
awt ship

# Merge specific worktree into base branch, push to origin, and clean up
awt ship {{branch}}

# Merge active worktree into base branch with hooks
awt merge {{branch}}

# Merge active worktree into explicit target branch
awt merge --into {{target_branch}}

# Merge active worktree bypassing pre-merge validation hooks
awt merge --no-hooks

# Perform linear rebase onto origin base before fast-forward merge
awt merge --rebase {{branch}}

# Merge active worktree into base branch and push to remote origin
awt merge --push {{branch}}

# Squash and merge active worktree into base branch
awt merge --squash {{branch}}

# Rebase active worktree onto base branch with auto-stash
awt rebase {{base}}

# Delete worktree, Git branch, and kill Tmux session
awt rm {{branch}}

# Delete worktree bypassing pre-remove validation hooks
awt rm --no-hooks {{branch}}

# Force delete dirty worktree, Git branch, and Tmux session
awt rm -f {{branch}}

# Clone repository into .bare container layout
awt clone {{repo_url}} {{target_dir}}

# Clone repository into .bare container layout and provision worktree
awtc {{repo_url}}

# Jump to next agent needing attention (permission/question) via ACPD
~/.config/tmux/ai-agent-triage-jump.sh

# Open AI agent bell notification queue ring popup
~/.config/tmux/ai-agent-bell-popup.sh

# Open interactive session picker in Tmux popup
~/.config/tmux/session-picker.sh

# Open interactive Tmux window picker with live pane preview and agent status
~/.config/tmux/window-picker.sh

# Open interactive workspace context inspector in Tmux popup (Prefix + e)
~/.config/tmux/workspace-picker.sh

# Open interactive GitHub Pull Request review picker in Tmux popup (Prefix + P)
~/.config/tmux/pr-picker.sh

# Open interactive workspace file picker in Tmux popup (Prefix + e legacy alias)
~/.config/tmux/files-picker.sh

# Open interactive yank token extractor from terminal scrollback in Tmux popup (Prefix + y)
~/.config/tmux/yank-picker.sh

# Open interactive scrollback token extractor in Tmux popup (Prefix + y legacy alias)
~/.config/tmux/scrollback-extract.sh

# Open URL or link token directly in Google Chrome / browser
~/.config/tmux/scrollback-chrome.sh {{url}}

# Open live full-text ripgrep picker in Tmux popup (Prefix + /)
~/.config/tmux/grep-picker.sh

# Open interactive Keybindings & Navigation HUD in Tmux popup (Prefix + ?)
~/.config/tmux/keybindings-picker.sh

# Paste files or clipboard into last visited Matchmaker target directory
ptl {{files}}

# Paste files or clipboard into target directory and navigate there
ptg {{files}}

# Paste files or clipboard into selected directory without changing directory
pt {{files}}

# Move files into last visited Matchmaker target directory
mtl {{files}}

# Move files into target directory and navigate there
mtg {{files}}

# Move files into selected directory without changing directory
mt {{files}}

# Jump to directory matching frecency query with fallback to Matchmaker
j {{query}}

# Interactive frecency jump picker with Waymaker
ji

# Interactive Waymaker Jump widget (frecency & tree navigation)
wm -o jump

# Headless fuzzy filter matching query without launching TUI
wm -f {{query}}

# List frecency directories ranked by usage
wm list --dirs

# List bookmarked directories and files
wm list --bookmarks

# Add directory manually to frecency database
wm add {{dir}}

# Live-reload Markdown preview with inline Kitty Unicode diagrams
wm md -w {{file}}

# Interactive workspace & session picker (Waymaker native)
wm session

# Connect to or create a session with Waymaker
wm connect {{session}}

# Switch to previous Tmux session
wm last

# List active sessions and configured paths
wm session list

# Dry-run GNU Stow symlink validation
./stow.sh -n

# Inspect status of all stowed dotfile packages
./stow.sh -s

# Restow a specific package
./stow.sh -r {{package}}

# Stow a new package to home directory
./stow.sh {{package}}

# Delete or unstow a package from home directory
./stow.sh -d {{package}}

# Audit documentation integrity, broken links, and root cleanliness
./scripts/docs-lint.sh

# Render Mermaid diagram to PNG image
mmdc -i {{mmd_file}} -o {{output_png}} -b transparent -t dark

# Render Mermaid diagram to SVG vector
mmdc -i {{mmd_file}} -o {{output_svg}} -b transparent -t dark

# Save image from Wayland clipboard to PNG file
wl-paste -t image/png > {{output_png}}

# List available MIME types currently in Wayland clipboard
wl-paste --list-types

# Convert any image format to PNG via ImageMagick
magick {{input_image}} {{output_png}}

# Sync custom.commands into IntelliShell local database
intelli-sync

# Launch Hibiki Wayland keystroke visualizer (launcher GUI)
hibiki

# Launch Hibiki keystroke visualizer directly without UI launcher (daemon / overlay mode)
hibiki --no-ui

# Reopen last closed Tmux window/tab with file, command, path, and session (Ctrl+Shift+T)
~/.config/tmux/reopen-window.sh

# Open Posting TUI HTTP client
posting

# Open Posting TUI HTTP client with specific collection directory
posting --collection {{collection_dir}}



$ (awt) branch: git branch --format='%(refname:short)' 2>/dev/null
$ (awt) base: git branch --format='%(refname:short)' 2>/dev/null
$ (awt) pr_number: gh pr list --limit 30 --json number,title --template '{{range .}}{{tablerow .number .title}}{{end}}' 2>/dev/null
$ (awtc) repo_url: gh repo list --limit 20 --json nameWithOwner -q '.[].nameWithOwner' 2>/dev/null
$ (stow.sh) package: find . -maxdepth 1 -mindepth 1 -type d ! -name '.*' ! -name 'scripts' ! -name 'docs' -printf '%f\n' 2>/dev/null
$ (./stow.sh) package: find . -maxdepth 1 -mindepth 1 -type d ! -name '.*' ! -name 'scripts' ! -name 'docs' -printf '%f\n' 2>/dev/null
$ (wm) session: wm session list 2>/dev/null
$ (wm) file: find . -maxdepth 3 -type f \( -name '*.md' -o -name '*.markdown' -o -name '*.mmd' \) 2>/dev/null
$ (mmdc) mmd_file: find . -maxdepth 4 -type f \( -name '*.mmd' -o -name '*.mermaid' \) 2>/dev/null
