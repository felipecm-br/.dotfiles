{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "waymux hook tmux SessionStart"
          },
          {
            "type": "command",
            "command": "waymux hook lazygit SessionStart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "waymux hook tmux UserPromptSubmit"
          },
          {
            "type": "command",
            "command": "waymux hook lazygit UserPromptSubmit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "waymux hook tmux PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "waymux hook tmux PostToolUse"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "waymux hook tmux PermissionRequest"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "waymux hook tmux Stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "waymux hook tmux SessionEnd"
          },
          {
            "type": "command",
            "command": "waymux hook lazygit SessionEnd"
          }
        ]
      }
    ]
  }
}
