#!/usr/bin/env bash
# Matchmaker backend adapter for fzf-tab (mm-ftb) using ftb preset
# High-performance in-memory RAM disk buffer with fzf-flag filtering
set -e

# Buffer candidates in RAM disk (/dev/shm) for instant, zero-disk I/O access
tmp_candidates=$(mktemp -p /dev/shm "/dev/shm/mm-ftb-XXXXXX" 2>/dev/null || mktemp "/tmp/mm-ftb-XXXXXX")
cat > "$tmp_candidates"

# Exit silently if no candidates were emitted by Zsh completion
if [ ! -s "$tmp_candidates" ]; then
    rm -f "$tmp_candidates"
    exit 0
fi

# Protocol for fzf-tab: Line 1 (query), Line 2 (expect_key)
# Streamed directly to stdout so null bytes \0 are preserved
printf "\n\n"

# Run Waymaker with ftb preset, feeding candidates from RAM and TUI via /dev/tty
wm -o ftb cmd "cat '$tmp_candidates'" < /dev/tty 2> /dev/tty || true

rm -f "$tmp_candidates"

