{
  "model": "sonnet",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status waiting"
          },
          {
            "type": "command",
            "command": "waymux hook tmux Notification claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status working"
          },
          {
            "type": "command",
            "command": "waymux hook tmux PostToolUse"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "waymux hook tmux PreToolUse"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "workmux register-agent"
          },
          {
            "type": "command",
            "command": "waymux hook tmux SessionStart claude"
          },
          {
            "type": "command",
            "command": "waymux hook lazygit SessionStart"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status done"
          },
          {
            "type": "command",
            "command": "waymux hook tmux Stop"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status working"
          },
          {
            "type": "command",
            "command": "waymux hook tmux UserPromptSubmit claude"
          },
          {
            "type": "command",
            "command": "waymux hook lazygit UserPromptSubmit"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "waymux hook tmux SessionEnd"
          },
          {
            "type": "command",
            "command": "waymux hook lazygit SessionEnd"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ux-ui-agent-skills@ux-ui-agent-skills": true
  },
  "extraKnownMarketplaces": {
    "ux-ui-agent-skills": {
      "source": {
        "source": "github",
        "repo": "plugin87/ux-ui-agent-skills"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  }
}
