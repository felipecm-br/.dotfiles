#!/usr/bin/env bash
# awtc - Agent Worktree Clone (Clone repository into .bare container layout)
# Usage: awtc <user/repo | url> [dest-dir]

set -e

target="$1"
dest_dir="$2"

if [[ -z "$target" ]]; then
    echo "Usage: awtc <user/repo | url> [dest-dir]"
    exit 1
fi

url=""
repo_name=""

# 1. Normalize target URL and repository name
if [[ "$target" =~ ^https?:// ]] || [[ "$target" =~ ^git@ ]]; then
    url="$target"
    repo_name="${target##*/}"
    repo_name="${repo_name%.git}"
elif [[ "$target" =~ / ]]; then
    url="https://github.com/${target}.git"
    repo_name="${target##*/}"
else
    url="https://github.com/fcmiranda/${target}.git"
    repo_name="$target"
fi

# 2. Resolve destination directory (default: ~/dev/github/<repo_name>)
base_dir="${dest_dir:-$HOME/dev/github/$repo_name}"
base_dir="${base_dir/#\~/$HOME}"

if [[ -d "$base_dir" ]]; then
    echo "awtc: Directory $base_dir already exists."
    if command -v wm >/dev/null 2>&1 && [[ -d "$base_dir/main" ]]; then
        exec wm connect "$base_dir/main"
    elif command -v sesh >/dev/null 2>&1 && [[ -d "$base_dir/main" ]]; then
        exec sesh connect "$base_dir/main"
    fi
    exit 1
fi

echo "==> Cloning bare repository into: $base_dir/.bare"
mkdir -p "$base_dir" || exit 1

# 3. Clone with --bare
if ! git clone --bare "$url" "$base_dir/.bare"; then
    echo "awtc: Failed to clone $url"
    rm -rf "$base_dir"
    exit 1
fi

# 4. Configure fetch refspec for standard remote branch tracking
git -C "$base_dir/.bare" config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
git -C "$base_dir/.bare" fetch origin --quiet

# 5. Resolve default branch (main, master, etc.)
default_branch=$(git -C "$base_dir/.bare" symbolic-ref --short HEAD 2>/dev/null | sed 's@origin/@@' || echo "main")
echo "==> Default branch detected: $default_branch"

# 6. Create default branch worktree in base_dir/<default_branch>
echo "==> Creating initial worktree in: $base_dir/$default_branch"
if ! git -C "$base_dir/.bare" worktree add "$base_dir/$default_branch" "$default_branch"; then
    echo "awtc: Failed to create initial worktree for $default_branch"
    exit 1
fi

# 7. Configure .git pointer file inside container folder
echo "gitdir: ./.bare" > "$base_dir/.git"

echo "✓ Successfully provisioned container layout in: $base_dir"

# 8. Connect to the primary worktree using Waymaker or Sesh if available
if command -v wm >/dev/null 2>&1; then
    exec wm connect "$base_dir/$default_branch"
elif command -v sesh >/dev/null 2>&1; then
    exec sesh connect "$base_dir/$default_branch"
else
    cd "$base_dir/$default_branch"
fi
