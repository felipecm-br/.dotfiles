#!/usr/bin/env bash
# awt - Agent Worktree Manager & Multi-Agent Git Orchestrator
# Global executable installed to ~/.local/bin/awt

set -e

slugify_prompt() {
    local prompt="$1"
    prompt="$(echo "$prompt" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    [[ -z "$prompt" ]] && return 0
    local prefix=""
    local body=""

    local conventional_re="^(feat|fix|refactor|docs|chore|test|perf|style|ci|build)(\([^)]+\))?[:/][[:space:]]*(.*)"
    if [[ "$prompt" =~ $conventional_re ]]; then
        prefix="${BASH_REMATCH[1]}"
        body="${BASH_REMATCH[3]}"
    fi

    if [[ -z "$prefix" ]]; then
        local first_word
        first_word="$(echo "$prompt" | awk '{print tolower($1)}')"
        case "$first_word" in
            fix|bug|repair|resolve|patch|hotfix)
                prefix="fix"
                body="$(echo "$prompt" | sed -E 's/^[^[:space:]]+[[:space:]]*//')"
                ;;
            refactor|clean|cleanup|restructure|reorganize)
                prefix="refactor"
                body="$(echo "$prompt" | sed -E 's/^[^[:space:]]+[[:space:]]*//')"
                ;;
            doc|docs|document|documentation)
                prefix="docs"
                body="$(echo "$prompt" | sed -E 's/^[^[:space:]]+[[:space:]]*//')"
                ;;
            test|tests|testing)
                prefix="test"
                body="$(echo "$prompt" | sed -E 's/^[^[:space:]]+[[:space:]]*//')"
                ;;
            chore|bump|upgrade|deps|release)
                prefix="chore"
                body="$(echo "$prompt" | sed -E 's/^[^[:space:]]+[[:space:]]*//')"
                ;;
            perf|optimize|performance|speedup)
                prefix="perf"
                body="$(echo "$prompt" | sed -E 's/^[^[:space:]]+[[:space:]]*//')"
                ;;
            add|create|impl|implement|feat|feature|build|new)
                prefix="feat"
                body="$(echo "$prompt" | sed -E 's/^[^[:space:]]+[[:space:]]*//')"
                ;;
            *)
                prefix="feat"
                body="$prompt"
                ;;
        esac
    fi

    [[ -z "$body" ]] && body="$prompt"

    local slug
    slug="$(echo "$body" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g' | sed -E 's/^-+|-+$//g')"

    if [[ ${#slug} -gt 45 ]]; then
        slug="$(echo "$slug" | cut -c1-45 | sed -E 's/-[^-]*$//')"
    fi

    [[ -z "$slug" ]] && slug="worktree"
    echo "${prefix}/${slug}"
}

show_help() {
    cat << 'HELP'
awt - Agent Worktree Manager & Multi-Agent Git Orchestrator

USAGE:
    awt                                     Open interactive Matchmaker TUI dashboard
    awt -c | new | add [flags]              Launch interactive 5-step Conventional Commits wizard (awc)
    awt -c -A <prompt> [base] [flags]       Auto-derive conventional branch name from prompt & provision
    awt -c <branch> [base] [flags] [-- cmd] Create/provision worktree, run inline command & connect
    awt <branch> | switch <branch>          Switch to existing worktree session (or auto-create from HEAD)
    awt popup                               Open floating AWT modal in Tmux (85% × 75%) (awp)
    awt pr [number]                         Interactive PR checkout or direct PR worktree provision
    awt clone <repo> [dir]                  Clone repository into .bare container layout (awtc)
    awt rm | remove <branch> [flags]        Delete worktree, Git branch, and kill Tmux session
    awt rebase [base]                       Rebase active worktree onto base branch with auto-stash
    awt ship [branch] [flags]               Merge into base, push to origin, and clean up worktree
    awt sweep [flags] [base]                Prune merged worktrees and dead Tmux sessions in batch
    awt reap [flags]                        Garbage-collect stale AI agents and orphan worktree sessions
    awt help | -h | --help                  Show this help message

FLAGS & OPTIONS:
    -A, --auto-name <prompt>                Auto-generate conventional branch slug from task prompt
    --no-tmux, --no-connect                 Create or merge worktree without switching Tmux session
    --continue, --ai-continue               Resume active AI conversation in the new worktree session
    --no-continue, --fresh                  Start with a fresh AI session (skip resume prompt)
    --ai=<cmd>                              Specify explicit AI launch command (e.g. --ai="opencode -s id")
    -- <command> [args...]                  Inline agent dispatch: launch command in new worktree session
    --into <branch>, --into=<branch>        Specify explicit target branch for awt merge or awt ship
    --rebase / --no-rebase                  Rebase active branch onto target before merging
    --push / --ship                         Push target branch to remote origin after successful merge
    --squash / --no-squash                  Squash all commits on merge (default: no-squash / ff)
    --no-commit                             Perform merge without auto-committing (staged)
    --no-remove                             Keep worktree directory after merge
    --no-hooks, -H                          Bypass pre-merge and pre-remove validation lifecycle hooks
    -f, --force                             Force remove dirty worktree on deletion
    --no-delete-branch                      Keep Git branch ref when removing worktree folder

SHORTCUTS & ALIASES:
    Ctrl + Shift + G                        Global Tmux floating popup
    awc                                     Shortcut for 'awt -c'
    awp                                     Shortcut for 'awt popup'
    awtc                                    Standalone .bare clone utility
HELP
    exit 0
}

# 1. Subcommands routing
case "$1" in
    -h|--help|help)
        show_help
        ;;
    popup)
        if [[ -x "$HOME/.config/tmux/awt-popup.sh" ]]; then
            exec "$HOME/.config/tmux/awt-popup.sh" "$PWD"
        elif [[ -x "$(dirname "$0")/../../.config/tmux/awt-popup.sh" ]]; then
            exec "$(dirname "$0")/../../.config/tmux/awt-popup.sh" "$PWD"
        fi
        exit 0
        ;;
    clone)
        shift
        if command -v awtc >/dev/null 2>&1; then
            exec awtc "$@"
        else
            echo "awt: awtc clone utility not found in PATH."
            exit 1
        fi
        ;;
    rm|remove|del|delete)
        shift
        flags=()
        branch=""
        for arg in "$@"; do
            case "$arg" in
                -f|--force|--no-delete-branch|--no-tmux|--no-hooks|--skip-pre-remove|-H)
                    flags+=("$arg")
                    ;;
                *)
                    [[ -z "$branch" ]] && branch="$arg" || flags+=("$arg")
                    ;;
            esac
        done
        [[ -z "$branch" ]] && { echo "Usage: awt rm <branch> [-f|--force] [--no-delete-branch] [--no-tmux] [--no-hooks]"; exit 1; }
        repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
        branch_folder="${branch//\//-}"
        target_dir="$repo_root/../$branch_folder"
        repo_parent="$(basename "$(dirname "$repo_root")")"
        session_name="${repo_parent}/${branch_folder}"
        [[ "$repo_parent" == ".dotfiles" ]] && session_name="_dotfiles/$branch_folder"
        delete_script="$HOME/.config/waymaker/scripts/awt-delete.sh"
        [ -x "$delete_script" ] || delete_script="$HOME/.config/matchmaker/scripts/awt-delete.sh"
        [ -x "$delete_script" ] || delete_script="$(dirname "$0")/../../.config/waymaker/scripts/awt-delete.sh"
        [ -x "$delete_script" ] || delete_script="$(dirname "$0")/../../.config/matchmaker/scripts/awt-delete.sh"
        if [[ -x "$delete_script" ]]; then
            exec "$delete_script" "$session_name" "$target_dir" "$branch" "${flags[@]}"
        fi
        exit 0
        ;;
    rebase)
        shift
        base="${1:-}"
        repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
        cur_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
        rebase_script="$HOME/.config/waymaker/scripts/awt-rebase.sh"
        [ -x "$rebase_script" ] || rebase_script="$HOME/.config/matchmaker/scripts/awt-rebase.sh"
        [ -x "$rebase_script" ] || rebase_script="$(dirname "$0")/../../.config/waymaker/scripts/awt-rebase.sh"
        [ -x "$rebase_script" ] || rebase_script="$(dirname "$0")/../../.config/matchmaker/scripts/awt-rebase.sh"
        if [[ -x "$rebase_script" ]]; then
            exec "$rebase_script" "$cur_branch" "$repo_root" "$base" "$@"
        fi
        exit 0
        ;;
    merge)
        shift
        flags=()
        target=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --squash|--no-squash|--no-commit|--no-remove|--no-tmux|--no-connect|--no-rebase|--rebase|--push|--ship|--no-hooks|--skip-pre-merge|-H)
                    flags+=("$1")
                    ;;
                --into=*)
                    flags+=("$1")
                    ;;
                --into)
                    shift
                    flags+=("--into" "$1")
                    ;;
                *)
                    [[ -z "$target" ]] && target="$1" || flags+=("$1")
                    ;;
            esac
            shift
        done
        repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
        cur_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
        repo_parent="$(basename "$(dirname "$repo_root")")"
        cur_folder="$(basename "$repo_root")"
        session_name="${repo_parent}/${cur_folder}"
        [[ "$repo_parent" == ".dotfiles" ]] && session_name="_dotfiles/$cur_folder"
        merge_script="$HOME/.config/waymaker/scripts/awt-merge.sh"
        [ -x "$merge_script" ] || merge_script="$HOME/.config/matchmaker/scripts/awt-merge.sh"
        [ -x "$merge_script" ] || merge_script="$(dirname "$0")/../../.config/waymaker/scripts/awt-merge.sh"
        [ -x "$merge_script" ] || merge_script="$(dirname "$0")/../../.config/matchmaker/scripts/awt-merge.sh"
        if [[ -x "$merge_script" ]]; then
            exec "$merge_script" "$target" "$repo_root" "$session_name" "" "${flags[@]}"
        fi
        exit 0
        ;;
    ship)
        shift
        flags=()
        target=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --squash|--no-squash|--no-commit|--no-remove|--no-tmux|--no-connect|--no-rebase|--rebase|--push|--ship|--no-hooks|--skip-pre-merge|-H)
                    flags+=("$1")
                    ;;
                --into=*)
                    flags+=("$1")
                    ;;
                --into)
                    shift
                    flags+=("--into" "$1")
                    ;;
                *)
                    [[ -z "$target" ]] && target="$1" || flags+=("$1")
                    ;;
            esac
            shift
        done
        flags+=("--push")
        repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
        cur_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
        repo_parent="$(basename "$(dirname "$repo_root")")"
        cur_folder="$(basename "$repo_root")"
        session_name="${repo_parent}/${cur_folder}"
        [[ "$repo_parent" == ".dotfiles" ]] && session_name="_dotfiles/$cur_folder"
        merge_script="$HOME/.config/waymaker/scripts/awt-merge.sh"
        [ -x "$merge_script" ] || merge_script="$HOME/.config/matchmaker/scripts/awt-merge.sh"
        [ -x "$merge_script" ] || merge_script="$(dirname "$0")/../../.config/waymaker/scripts/awt-merge.sh"
        [ -x "$merge_script" ] || merge_script="$(dirname "$0")/../../.config/matchmaker/scripts/awt-merge.sh"
        if [[ -x "$merge_script" ]]; then
            exec "$merge_script" "$target" "$repo_root" "$session_name" "" "${flags[@]}"
        fi
        exit 0
        ;;
    pr)
        shift
        pr_script="$HOME/.config/waymaker/scripts/awt-pr.sh"
        [ -x "$pr_script" ] || pr_script="$HOME/.config/matchmaker/scripts/awt-pr.sh"
        [ -x "$pr_script" ] || pr_script="$(dirname "$0")/../../.config/waymaker/scripts/awt-pr.sh"
        [ -x "$pr_script" ] || pr_script="$(dirname "$0")/../../.config/matchmaker/scripts/awt-pr.sh"
        if [[ -x "$pr_script" ]]; then
            exec "$pr_script" "$@"
        else
            echo "awt: awt-pr.sh not found."
            exit 1
        fi
        exit 0
        ;;
    sweep)
        shift
        sweep_script="$HOME/.config/waymaker/scripts/awt-sweep.sh"
        [ -x "$sweep_script" ] || sweep_script="$HOME/.config/matchmaker/scripts/awt-sweep.sh"
        [ -x "$sweep_script" ] || sweep_script="$(dirname "$0")/../../.config/waymaker/scripts/awt-sweep.sh"
        [ -x "$sweep_script" ] || sweep_script="$(dirname "$0")/../../.config/matchmaker/scripts/awt-sweep.sh"
        if [[ -x "$sweep_script" ]]; then
            exec "$sweep_script" "$@"
        else
            echo "awt: awt-sweep.sh not found."
            exit 1
        fi
        exit 0
        ;;
    reap)
        shift
        reap_script="$HOME/.config/waymaker/scripts/awt-reap.sh"
        [ -x "$reap_script" ] || reap_script="$HOME/.config/matchmaker/scripts/awt-reap.sh"
        [ -x "$reap_script" ] || reap_script="$(dirname "$0")/../../.config/waymaker/scripts/awt-reap.sh"
        [ -x "$reap_script" ] || reap_script="$(dirname "$0")/../../.config/matchmaker/scripts/awt-reap.sh"
        if [[ -x "$reap_script" ]]; then
            exec "$reap_script" "$@"
        else
            echo "awt: awt-reap.sh not found."
            exit 1
        fi
        exit 0
        ;;
esac

# 2. Interactive TUI Mode (called with 0 arguments)
if [[ $# -eq 0 ]]; then
    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1 && ! git rev-parse --is-bare-repository >/dev/null 2>&1; then
        echo "awt: Not inside a Git repository."
        exit 1
    fi

    if command -v wm >/dev/null 2>&1; then
        output=$(wm -o awt)
        [[ -z "$output" ]] && exit 0

        IFS=$'\t' read -r session target <<< "$output"
        cur_session=$(tmux display-message -p '#{session_name}' 2>/dev/null || echo "")

        # If already attached to this exact session, do nothing!
        [[ -n "$cur_session" && "$cur_session" == "$session" ]] && exit 0

        # If session exists in Tmux, switch by name; otherwise connect to path
        if tmux has-session -t "$session" 2>/dev/null; then
            exec wm connect "$session"
        else
            exec wm connect "$target"
        fi
        exit 0
    else
        echo "Usage: awt [-c <branch> [base]] | [branch] | [clone <repo>]"
        exit 1
    fi
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1 && ! git rev-parse --is-bare-repository >/dev/null 2>&1; then
    echo "awt: Not inside a Git repository."
    exit 1
fi

# 3. Parse arguments and flags
create=0
no_connect=0
ai_continue_mode="auto"
custom_ai_cmd=""
branch=""
base="HEAD"
extra_flags=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        new|create|add)
            create=1
            shift
            ;;
        switch)
            shift
            ;;
        -c|--create)
            create=1
            shift
            ;;
        -A|--auto-name)
            shift
            if [[ -n "${1:-}" ]]; then
                branch="$(slugify_prompt "$1")"
                create=1
            fi
            shift
            ;;
        --auto-name=*)
            prompt="${1#*=}"
            branch="$(slugify_prompt "$prompt")"
            create=1
            shift
            ;;
        -A=*)
            prompt="${1#*=}"
            branch="$(slugify_prompt "$prompt")"
            create=1
            shift
            ;;
        --no-tmux|--no-connect)
            no_connect=1
            extra_flags+=("$1")
            shift
            ;;
        --continue|--ai-continue)
            ai_continue_mode="yes"
            extra_flags+=("$1")
            shift
            ;;
        --no-continue|--fresh)
            ai_continue_mode="no"
            extra_flags+=("$1")
            shift
            ;;
        --ai=*)
            ai_continue_mode="custom"
            custom_ai_cmd="${1#*=}"
            extra_flags+=("$1")
            shift
            ;;
        --)
            shift
            ai_continue_mode="custom"
            custom_ai_cmd="$*"
            extra_flags+=("--ai=$custom_ai_cmd")
            break
            ;;
        *)
            if [[ -z "$branch" ]]; then
                branch="$1"
            elif [[ "$base" == "HEAD" ]]; then
                base="$1"
            fi
            shift
            ;;
    esac
done

# 4. Interactive Matchmaker wizard when called as `awt -c` or `awt new` without branch name
if [[ "$create" -eq 1 && -z "$branch" ]]; then
    new_script="$HOME/.config/waymaker/scripts/awt-new.sh"
    [ -x "$new_script" ] || new_script="$HOME/.config/matchmaker/scripts/awt-new.sh"
    [ -x "$new_script" ] || new_script="$(dirname "$0")/../../.config/waymaker/scripts/awt-new.sh"
    [ -x "$new_script" ] || new_script="$(dirname "$0")/../../.config/matchmaker/scripts/awt-new.sh"
    cur_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
    if [[ -x "$new_script" ]]; then
        exec "$new_script" "$cur_branch" "${extra_flags[@]}"
    fi
    exit 0
fi

[[ -z "$branch" ]] && { echo "awt: branch name required. Usage: awt [-c <branch> [base] [--no-tmux] [--continue]]"; exit 1; }

# 5. Direct Connection or Creation via 100% Native Git
branch_clean="${branch//\//-}"
repo_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
target_dir="$repo_root/../$branch_clean"
target_dir=$(realpath "$target_dir" 2>/dev/null || echo "$target_dir")

repo_parent="$(basename "$(dirname "$repo_root")")"
if [[ "$repo_parent" == ".dotfiles" ]]; then
    sess="_dotfiles/$branch_clean"
else
    sess="${repo_parent}/${branch_clean}"
fi

# If the worktree directory already exists, dispatch command (if provided) and connect
if [[ -d "$target_dir" ]]; then
    if [ -n "$custom_ai_cmd" ] && [ "$custom_ai_cmd" != "__FRESH__" ]; then
        if tmux has-session -t "$sess" 2>/dev/null; then
            tmux send-keys -t "$sess:0.0" "$custom_ai_cmd" C-m
        else
            tmux new-session -d -s "$sess" -c "$target_dir"
            tmux send-keys -t "$sess:0.0" "$custom_ai_cmd" C-m
        fi
        if [[ $no_connect -eq 1 ]]; then
            echo "✓ Dispatched '$custom_ai_cmd' in session '$sess'"
            exit 0
        fi
    fi

    if [[ $no_connect -eq 0 ]]; then
        if command -v wm >/dev/null 2>&1; then
            if tmux has-session -t "$sess" 2>/dev/null; then
                exec wm connect "$sess"
            else
                exec wm connect "$target_dir"
            fi
        elif command -v sesh >/dev/null 2>&1; then
            if tmux has-session -t "$sess" 2>/dev/null; then
                exec sesh connect "$sess"
            else
                exec sesh connect "$target_dir"
            fi
        elif [ -n "$TMUX" ]; then
            tmux switch-client -t "$sess" 2>/dev/null || cd "$target_dir"
        else
            cd "$target_dir"
        fi
    else
        cd "$target_dir"
    fi
    exit 0
fi

# Create worktree purely via native Git
if [[ ! -d "$target_dir" ]]; then
    git worktree add "$target_dir" -b "$branch" "$base" 2>/dev/null || \
    git worktree add "$target_dir" "$branch" 2>/dev/null || {
        echo "awt: Failed to create worktree at $target_dir"
        exit 1
    }
    git -C "$target_dir" config "branch.${branch}.base" "$base" 2>/dev/null || true
fi

# Run lifecycle post-create hook
if [[ -x "$HOME/.config/waymaker/hooks/post-create.sh" ]]; then
    "$HOME/.config/waymaker/hooks/post-create.sh" "$target_dir" "$branch" "$base" 2>/dev/null || true
elif [[ -x "$HOME/.config/matchmaker/hooks/post-create.sh" ]]; then
    "$HOME/.config/matchmaker/hooks/post-create.sh" "$target_dir" "$branch" "$base" 2>/dev/null || true
elif [[ -x "$(dirname "$0")/../../.config/waymaker/hooks/post-create.sh" ]]; then
    "$(dirname "$0")/../../.config/waymaker/hooks/post-create.sh" "$target_dir" "$branch" "$base" 2>/dev/null || true
elif [[ -x "$(dirname "$0")/../../.config/matchmaker/hooks/post-create.sh" ]]; then
    "$(dirname "$0")/../../.config/matchmaker/hooks/post-create.sh" "$target_dir" "$branch" "$base" 2>/dev/null || true
fi

echo "✓ Worktree ready at $target_dir"

if [[ $no_connect -eq 0 ]]; then
    # AI continuation resolution for direct CLI creation
    ai_cmd=""
    if [[ "$ai_continue_mode" == "custom" ]]; then
        ai_cmd="$custom_ai_cmd"
    elif [[ "$ai_continue_mode" == "yes" || "$ai_continue_mode" == "auto" ]]; then
        detect_script="$HOME/.config/waymaker/scripts/awt-ai-detect.sh"
        [ -f "$detect_script" ] || detect_script="$HOME/.config/matchmaker/scripts/awt-ai-detect.sh"
        [ -f "$detect_script" ] || detect_script="$(dirname "$0")/../../.config/waymaker/scripts/awt-ai-detect.sh"
        [ -f "$detect_script" ] || detect_script="$(dirname "$0")/../../.config/matchmaker/scripts/awt-ai-detect.sh"
        if [ -f "$detect_script" ]; then
            # shellcheck source=/dev/null
            . "$detect_script" 2>/dev/null || true
            detected_ai=$(awt_ai_detect_all | head -n 1)
            if [ -n "$detected_ai" ]; then
                ai_cmd=$(echo "$detected_ai" | awk -F'\t' '{print $6}')
            fi
        fi
    fi

    if [ -n "$ai_cmd" ] && [ "$ai_cmd" != "__FRESH__" ]; then
        if tmux has-session -t "$sess" 2>/dev/null; then
            tmux send-keys -t "$sess:0.0" "$ai_cmd" C-m
        else
            tmux new-session -d -s "$sess" -c "$target_dir"
            tmux send-keys -t "$sess:0.0" "$ai_cmd" C-m
        fi
        if command -v wm >/dev/null 2>&1; then
            exec wm connect "$sess"
        elif command -v sesh >/dev/null 2>&1; then
            exec sesh connect "$sess"
        elif [ -n "$TMUX" ]; then
            tmux switch-client -t "$sess" 2>/dev/null || cd "$target_dir"
        else
            cd "$target_dir"
        fi
    else
        if command -v wm >/dev/null 2>&1; then
            exec wm connect "$target_dir"
        elif command -v sesh >/dev/null 2>&1; then
            exec sesh connect "$target_dir"
        elif [ -n "$TMUX" ]; then
            tmux switch-client -t "$sess" 2>/dev/null || cd "$target_dir"
        else
            cd "$target_dir"
        fi
    fi
else
    # Headless / --no-connect mode: spawn in background tmux session if command was given
    if [ -n "$custom_ai_cmd" ] && [ "$custom_ai_cmd" != "__FRESH__" ]; then
        if tmux has-session -t "$sess" 2>/dev/null; then
            tmux send-keys -t "$sess:0.0" "$custom_ai_cmd" C-m
        else
            tmux new-session -d -s "$sess" -c "$target_dir"
            tmux send-keys -t "$sess:0.0" "$custom_ai_cmd" C-m
        fi
        echo "✓ Dispatched '$custom_ai_cmd' in background session '$sess'"
    fi
    cd "$target_dir"
fi
