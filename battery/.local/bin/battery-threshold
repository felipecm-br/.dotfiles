#!/usr/bin/env zsh
# battery-threshold — get or set the charge limit for Apple Silicon (Asahi Linux)
#
# Usage:
#   battery-threshold                      # show the current limit
#   battery-threshold set <N>              # stop charging at N% (80 = Omarchy's limit)
#   battery-threshold reset                # remove the limit (100%)
#   battery-threshold calibrate            # temporarily lift limit for a calibration full charge
#
# Recommended: battery-threshold set 80 (Omarchy's charge limit; the SMC resumes
# charging at 75%). The driver derives the start threshold from the end one and
# ignores writes to it.
#
# Persistence needs no service of its own: asahi-scripts saves every change of
# charge_control_end_threshold to /etc/udev/macsmc-battery.conf, and its udev rule
# plus omarchy-mac's battery-charge-limit-restore write it back at boot.
#
# Calibration state is tracked in ~/.local/share/battery/last-calibration.
# The battery-calibrate systemd user timer runs this workflow automatically each month.

set -euo pipefail

BATTERY_PATH="/sys/class/power_supply/macsmc-battery"
END_FILE="$BATTERY_PATH/charge_control_end_threshold"

if [[ ! -d "$BATTERY_PATH" ]]; then
  print -P "%F{red}✗%f Battery not found at %B${BATTERY_PATH}%b"
  exit 1
fi

cmd="${1:-show}"

case "$cmd" in
  show|"")
    start=$(cat "$BATTERY_PATH/charge_control_start_threshold" 2>/dev/null || echo "N/A")
    end=$(cat "$END_FILE" 2>/dev/null || echo "N/A")
    print -P "  Charge limit: %F{yellow}%B${end}%%%b%f (charging resumes at ${start}%%)"
    if [[ "$end" != "N/A" && "$end" -le 85 ]]; then
      print -P "  %F{green}✓ Battery protection active (limit ≤ 85%)%f"
    else
      print -P "  %F{red}⚠ No charge limit set — battery health at risk%f"
    fi
    ;;

  set|set-custom)
    # set-custom <start> <end> is kept for old muscle memory; the start is ignored.
    if [[ "$cmd" == "set" ]]; then t_end="${2:-80}"; else t_end="${3:-80}"; fi
    if ! [[ "$t_end" =~ ^[0-9]+$ ]] || (( t_end < 20 || t_end > 100 )); then
      print -P "%F{red}✗%f Invalid limit. Must be a number between 20 and 100."
      exit 1
    fi

    # Detect if we are restoring from a calibration (previous end was 100%)
    prev_end=$(cat "$END_FILE" 2>/dev/null || echo 0)
    coming_from_calibration=0
    (( prev_end >= 99 )) && coming_from_calibration=1

    print -P "  %F{blue}→%f Setting charge limit to %B${t_end}%%%b"
    if (( t_end == 80 || t_end == 100 )) && command -v omarchy-battery-charge-limit >/dev/null; then
      omarchy-battery-charge-limit "$t_end"
    else
      echo "$t_end" | sudo tee "$END_FILE" > /dev/null
    fi
    print -P "  %F{green}✓%f Limit applied; asahi-scripts keeps it across reboots."

    # If restoring from calibration, record the date
    if (( coming_from_calibration && t_end < 100 )); then
      state_dir="$HOME/.local/share/battery"
      mkdir -p "$state_dir"
      date +%Y-%m-%d > "$state_dir/last-calibration"
      print -P "  %F{green}✓%f Calibration date recorded: %B$(date +%Y-%m-%d)%b"
    fi
    ;;

  reset)
    print -P "  %F{yellow}→%f Removing charge limit (setting to 100%)..."
    if command -v omarchy-battery-charge-limit >/dev/null; then
      omarchy-battery-charge-limit 100
    else
      echo 100 | sudo tee "$END_FILE" > /dev/null
    fi
    print -P "  %F{cyan}✓%f Charge limit removed."
    ;;

  calibrate)
    # Lift the limit temporarily so the battery can charge to 100%.
    # A full charge lets the kernel re-measure energy_full (the "design capacity"
    # denominator used by battery-health), keeping the health% reading accurate.
    # macOS does this automatically via Optimized Battery Charging; on Linux you
    # need to trigger it manually — roughly once every 1–3 months is sufficient.
    #
    # After the battery reaches 100% and the laptop has been idle for a few hours,
    # run: battery-threshold set 80   (asahi-scripts saved 100%, so a reboot keeps 100%)

    # Remember the current limit so we can remind the user
    prev_end=$(cat "$END_FILE" 2>/dev/null || echo 80)
    (( prev_end >= 99 )) && prev_end=80

    print -P ""
    print -P "  %F{blue}%B Calibration cycle — Apple Silicon battery%b%f"
    print -P "  %F{white}────────────────────────────────────────────%f"
    print -P "  Temporarily lifting the charge limit to 100% so the"
    print -P "  kernel can re-measure %Benergy_full%b (real capacity)."
    print -P ""
    print -P "  %F{yellow}⚠  Do this roughly once every 1–3 months.%f"
    print -P ""

    echo 100 | sudo tee "$END_FILE" > /dev/null

    print -P "  %F{green}✓%f Limit lifted. Plug in the charger and let the battery reach 100%."
    print -P ""
    print -P "  When full + idle for ~1 hour, restore your limit with:"
    print -P "  %F{cyan}  battery-threshold set ${prev_end}%f"
    print -P ""
    ;;


  *)
    print -P "%F{red}✗%f Unknown command: %B${cmd}%b"
    print "Usage: battery-threshold [show|set <N>|reset|calibrate]"
    exit 1
    ;;
esac
