[Unit]
Description=Waymux: Terminal AI Cockpit & Agent Control Plane Daemon
Documentation=https://github.com/felipecm-br/waymux
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=%h/.local/bin/waymux daemon
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=yes
# Resource limits
LimitNOFILE=65536
MemoryMax=512M

# Runtime directory for PID file, presets, and tokens
# The auth token lives in $XDG_RUNTIME_DIR/waymux/token. waymux also mirrors it to the legacy
# $XDG_RUNTIME_DIR/acpd/token on a best-effort basis for old clients (that directory is not managed by systemd).
RuntimeDirectory=waymux

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=waymux

[Install]
WantedBy=default.target
Alias=acpd.service
