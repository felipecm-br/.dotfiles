#!/usr/bin/env bash
# Live preview & Interactive HUD renderer for Waymaker hypr-border
set -e

TPL_FILE="$1"
ACTION="$2"
[ -f "$TPL_FILE" ] || exit 0

STATE_FILE="/dev/shm/hypr-border-state"
COLORS_FILE="$HOME/.local/state/omarchy/current/theme/colors.toml"

SPEED=100
ANGLE=45
if [ -f "$STATE_FILE" ]; then
    source "$STATE_FILE" 2>/dev/null || true
fi

case "$ACTION" in
    speed_up)
        case "$SPEED" in
            0) SPEED=200 ;;
            200) SPEED=100 ;;
            100) SPEED=50 ;;
            50) SPEED=25 ;;
            25) SPEED=10 ;;
            10) SPEED=10 ;;
            *) SPEED=50 ;;
        esac
        ;;
    speed_down)
        case "$SPEED" in
            10) SPEED=25 ;;
            25) SPEED=50 ;;
            50) SPEED=100 ;;
            100) SPEED=200 ;;
            200) SPEED=0 ;;
            0) SPEED=0 ;;
            *) SPEED=100 ;;
        esac
        ;;
    rotate_angle)
        ANGLE=$(( (ANGLE + 45) % 360 ))
        ;;
    *)
        ;;
esac

cat << STATE_EOF > "$STATE_FILE"
SPEED=$SPEED
ANGLE=$ANGLE
STATE_EOF

# Live-apply to Hyprland
if [ -f "$COLORS_FILE" ]; then
    sed_script=$(mktemp)
    while IFS='=' read -r key val || [ -n "$key" ]; do
        key="${key//[\"\' ]/}"
        [[ $key && $key != \#* ]] || continue
        val="${val#*[\"\']}"
        val="${val%%[\"\']*}"
        val_strip="${val#\#}"
        printf 's|{{ %s_strip }}|%s|g\n' "$key" "$val_strip" >> "$sed_script"
        printf 's|{{ %s }}|%s|g\n' "$key" "$val" >> "$sed_script"
    done < "$COLORS_FILE"

    sed -f "$sed_script" "$TPL_FILE" | sed "s/angle = [0-9]*/angle = $ANGLE/g" > "$HOME/.local/state/omarchy/current/theme/hyprland.lua" 2>/dev/null || true
    rm -f "$sed_script"

    if [ "$SPEED" -eq 0 ]; then
        hyprctl eval 'hl.animation({ leaf = "borderangle", enabled = false })' >/dev/null 2>&1 || true
    else
        hyprctl eval 'hl.animation({ leaf = "borderangle", enabled = true, speed = '"$SPEED"', bezier = "liner", style = "loop" })' >/dev/null 2>&1 || true
    fi
    hyprctl eval 'dofile(os.getenv("HOME") .. "/.local/state/omarchy/current/theme/hyprland.lua")' >/dev/null 2>&1 || true
fi

# Title
read -r TITLE < "$TPL_FILE" || true
TITLE="${TITLE#--}"
TITLE="${TITLE#\#}"
TITLE="${TITLE# }"
[ -z "$TITLE" ] && TITLE="${TPL_FILE##*/}"

# Speed description
case "$SPEED" in
    10) SPEED_LABEL="10 (⚡ Turbo / 1s)" ;;
    25) SPEED_LABEL="25 (🔥 Fast / 2.5s)" ;;
    50) SPEED_LABEL="50 (🚀 Dynamic / 5s)" ;;
    100) SPEED_LABEL="100 (✨ Smooth / 10s Default)" ;;
    200) SPEED_LABEL="200 (🍃 Zen / 20s Lento)" ;;
    0) SPEED_LABEL="0 (⏸️ Static / No Rotation)" ;;
    *) SPEED_LABEL="$SPEED" ;;
esac

printf "  \033[1;36m🎨 Estilo:\033[0m      \033[1;37m%s\033[0m\n" "$TITLE"
printf "  \033[1;33m⚡ Velocidade:\033[0m  \033[1;32m%s\033[0m\n" "$SPEED_LABEL"
printf "  \033[1;34m📐 Ângulo Base:\033[0m \033[1;33m%s°\033[0m\n" "$ANGLE"
