#!/usr/bin/env bash
# omarchy-launch-session-connect - Connect or switch to a Waymaker/Tmux session

target="$1"
[[ -z "$target" ]] && exit 0

# Strip potential icons or leading whitespace if present
target=$(echo "$target" | sed -E 's/^[[:space:]]*[^[:alnum:]/~._-]+[[:space:]]+//')

if [ -n "${TMUX:-}" ]; then
  exec wm connect --switch -- "$target"
else
  exec uwsm-app -- xdg-terminal-exec -- wm connect -- "$target"
fi
